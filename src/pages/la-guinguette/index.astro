---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import menu from '../../data/menu-guinguette.json';
const lang = 'en';
---

<Layout
  title="La Guinguette | Toile Blanche | Saint-Paul de Vence"
  description="The garden heart. Come barefoot or in espadrilles. Provence invites itself to your table."
  ogImage="https://www.toileblanche.com/assets/images/page-img-7f72d09199a7a2.jpg"
>
  <Nav theme="both" ctaText="Book my Table" ctaHref="https://bookings.zenchef.com/results?rid=357953" />

  <main id="main-content">
    <!-- HERO -->
    <section class="lgn-hero">
      <div class="lgn-hero-image">
        <img src="/assets/images/page-img-7f72d09199a7a2.jpg" alt="La Guinguette de Toile Blanche" loading="eager" />
        <div class="lgn-hero-overlay"></div>
      </div>
      <div class="lgn-hero-content">
        <p class="lgn-hero-eyebrow">Lunch — May to October</p>
        <h1>La Guinguette</h1>
      </div>
    </section>

    <!-- TAGLINE -->
    <section class="lgn-tagline">
      <div class="lgn-tagline-inner">
        <p>The garden heart. Come barefoot or in espadrilles. Provence invites itself to your table.</p>
      </div>
    </section>

    <!-- NARRATIVE + DETAILS -->
    <section class="lgn-narrative">
      <div class="lgn-narrative-inner">
        <div class="lgn-narrative-text">
          <h2>The Garden Table</h2>
          <p>La Guinguette is the soul of the summer at Toile Blanche. Set under the plane trees beside the pool, it is where lunch lasts as long as it should — somewhere between a proper meal and a long Provençal afternoon.</p>
          <p>The menu is designed for sharing. Dishes are ordered progressively and arrive when they are ready. There is no rush, no structure, no formality. Just the Mediterranean on a plate.</p>
          <h2>How It Works</h2>
          <p>The table is sharing-style. Order a few dishes for the centre, add as you go. Grilled fish, market vegetables, charcuterie, dips, flatbreads — the menu changes weekly depending on what the producers and the garden have to offer.</p>
          <p>Rosé is poured by the glass or the bottle. The wine selection favours the immediate surroundings: Bellet, Côtes de Provence, and the occasional natural oddity from a neighbour's vineyard.</p>
        </div>
        <div class="lgn-details">
          <p class="lgn-details-label">Practical</p>

          <div class="lgn-details-block">
            <h3>Season</h3>
            <p>Open May through October</p>
            <p>Weather permitting</p>
          </div>

          <div class="lgn-details-block">
            <h3>Hours</h3>
            <p>Lunch: 12:00 – 15:00</p>
            <p>Drinks & snacks: 15:00 – 18:00</p>
          </div>

          <div class="lgn-details-block">
            <h3>Reservation</h3>
            <p>Recommended, especially weekends.</p>
            <p>Open to hotel guests and external visitors.</p>
          </div>

          <div class="lgn-details-block lgn-details-cta">
            <a href="https://bookings.zenchef.com/results?rid=357953" target="_blank" rel="noopener noreferrer" class="lgn-btn">Reserve a Table</a>
          </div>

          <div class="lgn-details-block">
            <h3>Good to Know</h3>
            <p>Dishes are ordered progressively — no need to order everything at once.</p>
            <p>Sharing style. No individual plates unless requested.</p>
            <p>Barefoot welcome. Swimwear with a cover-up is fine.</p>
          </div>

          <div class="lgn-details-block">
            <h3>Location</h3>
            <p>Toile Blanche — Poolside Garden</p>
            <p>826, chemin de la Pounchounière</p>
            <p>06570 Saint-Paul de Vence</p>
            <p>France</p>
          </div>

          <div class="lgn-details-block">
            <h3>Contact</h3>
            <a href="tel:+33493327421" class="lgn-details-link">+33 4 93 32 74 21</a>
            <a href="mailto:guinguette@toileblanche.com" class="lgn-details-link">guinguette@toileblanche.com</a>
          </div>
        </div>
      </div>
    </section>

    <!-- GALLERY PAIR -->
    <section class="lgn-gallery">
      <div class="lgn-gallery-inner">
        <div class="lgn-gallery-tall">
          <img src="/assets/images/page-img-90d67bc14d6e33.webp" alt="Sharing plates at La Guinguette" loading="lazy" />
        </div>
        <div class="lgn-gallery-offset">
          <img src="/assets/images/page-img-0cb6a2524fa474.jpg" alt="Poolside dining at Toile Blanche" loading="lazy" />
        </div>
      </div>
    </section>

    <!-- THE MENU -->
    <section class="lgn-menu">
      <div class="lgn-menu-inner">
        <p class="lgn-menu-label">{menu.meta.season[lang]}</p>
        <h2>The Menu</h2>
        <p class="lgn-menu-intro">{menu.meta.philosophy[lang]}</p>

        {menu.sections.map(section => (
          <div class="lgn-menu-section">
            <h3>{section.title[lang]}</h3>
            {section.items.map(item => (
              <div class="lgn-menu-item">
                <p class="lgn-menu-dish">{item[lang]}</p>
                <span class="lgn-menu-price">{item.price}€</span>
              </div>
            ))}
          </div>
        ))}

        <p class="lgn-menu-note">{menu.footer_note[lang]}</p>
      </div>
    </section>

    <!-- PHILOSOPHY -->
    <section class="lgn-quote">
      <div class="lgn-quote-inner">
        <h2>Lunch lasted three hours. Nobody noticed. The rosé was cold, the fish was whole, and the afternoon had no plans.</h2>
      </div>
    </section>

    <!-- CTA -->
    <section class="lgn-cta">
      <p>A table under the trees is waiting.</p>
      <a href="https://bookings.zenchef.com/results?rid=357953" target="_blank" rel="noopener noreferrer" class="lgn-cta-btn">Reserve a Table</a>
    </section>
  </main>

  <Footer />
</Layout>

<script type="application/ld+json" is:inline>
{
  "@context": "https://schema.org",
  "@type": "Restaurant",
  "name": "La Guinguette — Toile Blanche",
  "description": "Mediterranean sharing plates under the plane trees. Lunch by the pool in Saint-Paul de Vence. Open May to October.",
  "image": "https://www.toileblanche.com/assets/images/page-img-7f72d09199a7a2.jpg",
  "url": "https://www.toileblanche.com/la-guinguette",
  "telephone": "+33493327421",
  "servesCuisine": ["Mediterranean", "Provençal", "Sharing plates"],
  "priceRange": "€€",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "826, chemin de la Pounchounière",
    "addressLocality": "Saint-Paul de Vence",
    "postalCode": "06570",
    "addressCountry": "FR"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 43.6874494,
    "longitude": 7.1285941
  },
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],
    "opens": "12:00",
    "closes": "18:00"
  },
  "acceptsReservations": "True",
  "hasMenu": {
    "@type": "Menu",
    "name": "Winter Menu 2025/26",
    "hasMenuSection": [
      {
        "@type": "MenuSection",
        "name": "Savoury",
        "hasMenuItem": [
          {"@type": "MenuItem", "name": "Sardines in olive oil by Maison Ferrigno", "offers": {"@type": "Offer", "price": "13", "priceCurrency": "EUR"}},
          {"@type": "MenuItem", "name": "Summer truffle ham from Maison Bobosse", "offers": {"@type": "Offer", "price": "17", "priceCurrency": "EUR"}},
          {"@type": "MenuItem", "name": "Plancha-grilled octopus tentacle, butternut, Taggiasca olives, tahini", "offers": {"@type": "Offer", "price": "22", "priceCurrency": "EUR"}},
          {"@type": "MenuItem", "name": "Grilled picanha beef, chimichurri", "offers": {"@type": "Offer", "price": "24", "priceCurrency": "EUR"}},
          {"@type": "MenuItem", "name": "Rosemary-braised veal chop (600/700g)", "offers": {"@type": "Offer", "price": "56", "priceCurrency": "EUR"}},
          {"@type": "MenuItem", "name": "Catch of the day, juniper-smoked", "offers": {"@type": "Offer", "price": "21", "priceCurrency": "EUR"}},
          {"@type": "MenuItem", "name": "Petits Farcis Niçois-style stuffed cabbage", "offers": {"@type": "Offer", "price": "19", "priceCurrency": "EUR"}},
          {"@type": "MenuItem", "name": "Burgundy-style snails from the Var", "offers": {"@type": "Offer", "price": "19", "priceCurrency": "EUR"}}
        ]
      },
      {
        "@type": "MenuSection",
        "name": "Sweet",
        "hasMenuItem": [
          {"@type": "MenuItem", "name": "Ocoa 70% chocolate, cocoa crumble, fleur de sel", "offers": {"@type": "Offer", "price": "9", "priceCurrency": "EUR"}},
          {"@type": "MenuItem", "name": "Homemade cheesecake, pineapple, coconut, lime", "offers": {"@type": "Offer", "price": "9", "priceCurrency": "EUR"}},
          {"@type": "MenuItem", "name": "Cheese selection by Maison Mons (MOF)", "offers": {"@type": "Offer", "price": "16", "priceCurrency": "EUR"}},
          {"@type": "MenuItem", "name": "Affogato, hazelnut", "offers": {"@type": "Offer", "price": "9", "priceCurrency": "EUR"}}
        ]
      }
    ]
  }
}
</script>

<style>
  /* ─── HERO ─── */
  .lgn-hero {
    position: relative;
    height: 85vh;
    min-height: 500px;
    overflow: hidden;
  }
  .lgn-hero-image {
    position: absolute;
    inset: 0;
  }
  .lgn-hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .lgn-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.5) 0%, transparent 55%);
  }
  .lgn-hero-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 0 80px 72px;
    color: #fff;
  }
  .lgn-hero-eyebrow {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    opacity: 0.8;
    margin-bottom: 16px;
    color: #fff;
  }
  .lgn-hero-content h1 {
    font-family: 'Gilda Display', serif;
    font-size: clamp(40px, 6vw, 80px);
    font-weight: 400;
    line-height: 1.05;
    color: #fff;
  }

  /* ─── TAGLINE ─── */
  .lgn-tagline {
    border-bottom: 1px solid #E2D9CC;
  }
  .lgn-tagline-inner {
    max-width: 800px;
    margin: 0 auto;
    padding: 64px 80px;
    text-align: center;
  }
  .lgn-tagline-inner p {
    font-family: 'Gilda Display', serif;
    font-style: italic;
    font-size: clamp(20px, 2.5vw, 28px);
    line-height: 1.55;
    color: #3D3530;
  }

  /* ─── NARRATIVE + DETAILS ─── */
  .lgn-narrative {
    border-bottom: 1px solid #E2D9CC;
  }
  .lgn-narrative-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 80px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: start;
  }
  .lgn-narrative-text h2 {
    font-family: 'Gilda Display', serif;
    font-size: clamp(24px, 3vw, 36px);
    font-weight: 400;
    margin-bottom: 24px;
    color: #1C1917;
  }
  .lgn-narrative-text h2:not(:first-child) {
    margin-top: 48px;
  }
  .lgn-narrative-text p {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 16px;
    line-height: 1.8;
    color: #3D3530;
    margin-bottom: 16px;
  }

  .lgn-details {
    padding: 48px;
    background: rgba(226, 217, 204, 0.15);
  }
  .lgn-details-label {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #9C9080;
    margin-bottom: 40px;
  }
  .lgn-details-block {
    margin-bottom: 32px;
    padding-bottom: 32px;
    border-bottom: 1px solid rgba(226, 217, 204, 0.5);
  }
  .lgn-details-block:last-child {
    margin-bottom: 0;
    padding-bottom: 0;
    border-bottom: none;
  }
  .lgn-details-block h3 {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 10px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #9C9080;
    margin-bottom: 12px;
  }
  .lgn-details-block p {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 14px;
    line-height: 1.7;
    color: #3D3530;
  }
  .lgn-details-link {
    display: block;
    font-family: 'Didact Gothic', sans-serif;
    font-size: 14px;
    color: #3D3530;
    text-decoration: none;
    line-height: 1.7;
    transition: color 0.2s;
  }
  .lgn-details-link:hover {
    color: #9e5c4a;
  }
  .lgn-details-cta {
    text-align: center;
    padding-top: 8px;
    padding-bottom: 40px;
  }
  .lgn-btn {
    display: inline-block;
    font-family: 'Didact Gothic', sans-serif;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    color: #FAF8F3;
    background: #9e5c4a;
    padding: 16px 36px;
    transition: opacity 0.2s;
  }
  .lgn-btn:hover {
    opacity: 0.85;
  }

  /* ─── GALLERY ─── */
  .lgn-gallery {
    border-bottom: 1px solid #E2D9CC;
  }
  .lgn-gallery-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 80px;
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 40px;
    align-items: start;
  }
  .lgn-gallery-tall img {
    width: 100%;
    aspect-ratio: 3/4;
    object-fit: cover;
    display: block;
  }
  .lgn-gallery-offset {
    padding-top: 120px;
  }
  .lgn-gallery-offset img {
    width: 100%;
    aspect-ratio: 4/5;
    object-fit: cover;
    display: block;
  }

  /* ─── THE MENU ─── */
  .lgn-menu {
    border-bottom: 1px solid #E2D9CC;
  }
  .lgn-menu-inner {
    max-width: 800px;
    margin: 0 auto;
    padding: 80px;
  }
  .lgn-menu-label {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #9C9080;
    margin-bottom: 16px;
  }
  .lgn-menu-inner > h2 {
    font-family: 'Gilda Display', serif;
    font-size: clamp(28px, 3vw, 40px);
    font-weight: 400;
    color: #1C1917;
    margin-bottom: 16px;
  }
  .lgn-menu-intro {
    font-family: 'Gilda Display', serif;
    font-style: italic;
    font-size: clamp(16px, 2vw, 20px);
    line-height: 1.55;
    color: #3D3530;
    margin-bottom: 56px;
    max-width: 700px;
  }
  .lgn-menu-section {
    margin-bottom: 48px;
  }
  .lgn-menu-section:last-of-type {
    margin-bottom: 40px;
  }
  .lgn-menu-section h3 {
    font-family: 'Gilda Display', serif;
    font-style: italic;
    font-size: 22px;
    font-weight: 400;
    color: #1C1917;
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom: 1px solid #E2D9CC;
  }
  .lgn-menu-item {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 24px;
    padding-bottom: 14px;
    margin-bottom: 14px;
    border-bottom: 1px solid rgba(226, 217, 204, 0.3);
  }
  .lgn-menu-item:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }
  .lgn-menu-dish {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 15px;
    line-height: 1.6;
    color: #3D3530;
    flex: 1;
  }
  .lgn-menu-price {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 15px;
    color: #9C9080;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .lgn-menu-note {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 11px;
    color: #9C9080;
    line-height: 1.6;
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid #E2D9CC;
  }

  /* ─── QUOTE ─── */
  .lgn-quote {
    border-bottom: 1px solid #E2D9CC;
  }
  .lgn-quote-inner {
    max-width: 900px;
    margin: 0 auto;
    padding: 96px 80px;
    text-align: center;
  }
  .lgn-quote-inner h2 {
    font-family: 'Gilda Display', serif;
    font-style: italic;
    font-size: clamp(24px, 3.5vw, 44px);
    font-weight: 400;
    line-height: 1.3;
    color: #1C1917;
  }

  /* ─── CTA ─── */
  .lgn-cta {
    padding: 80px;
    text-align: center;
    border-bottom: 1px solid #E2D9CC;
  }
  .lgn-cta p {
    font-family: 'Gilda Display', serif;
    font-style: italic;
    font-size: clamp(20px, 2.5vw, 28px);
    color: #3D3530;
    margin-bottom: 32px;
  }
  .lgn-cta-btn {
    display: inline-block;
    font-family: 'Didact Gothic', sans-serif;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    color: #FAF8F3;
    background: #9e5c4a;
    padding: 16px 36px;
    transition: opacity 0.2s;
  }
  .lgn-cta-btn:hover {
    opacity: 0.85;
  }

  /* ─── RESPONSIVE ─── */
  @media (max-width: 900px) {
    .lgn-hero-content {
      padding: 0 24px 48px;
    }
    .lgn-tagline-inner {
      padding: 48px 24px;
    }
    .lgn-narrative-inner {
      grid-template-columns: 1fr;
      padding: 48px 24px;
      gap: 40px;
    }
    .lgn-gallery-inner {
      grid-template-columns: 1fr;
      padding: 48px 24px;
      gap: 24px;
    }
    .lgn-gallery-offset {
      padding-top: 0;
    }
    .lgn-menu-inner {
      padding: 48px 24px;
    }
    .lgn-quote-inner {
      padding: 64px 24px;
    }
    .lgn-cta {
      padding: 48px 24px;
    }
  }
</style>
