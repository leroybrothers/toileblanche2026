---
import Layout from '../layouts/Layout.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';

export interface Props {
  title: string;
  heading: string;
  description?: string;
  image?: string;
}

const { title, heading, description, image } = Astro.props;
---

<Layout title={`${title} | Toile Blanche`} description={description}>
  <!-- Light nav for non-hero pages -->
  <nav class="navigation-light" style="position:relative; opacity:1;">
    <div class="navigation-bar">
      <div class="nav-container">
        <a href="/" class="nav-logo w-nav-brand">
          <img src="/assets/images/63a19dac0c5c8e779178fddf_Toile%20Blanche%20Logo%202022%20light.webp" loading="lazy" alt="Toile Blanche Logo" class="logo-light" />
        </a>
        <div class="nav-buttons">
          <div class="book-button">
            <a href="#" class="nav-link-light distributor-open">Book my Stay</a>
          </div>
          <button class="menu-button w-inline-block js-menu-toggle" aria-label="Toggle menu" aria-expanded="false">
            <div class="nav-link-light mobile-none">Menu</div>
            <div class="menu-icon-wrap">
              <span class="menu-bar top"></span>
              <span class="menu-bar middle"></span>
              <span class="menu-bar bottom"></span>
            </div>
          </button>
        </div>
      </div>
    </div>
    <div class="nav-links-container light js-nav-links" hidden>
      <div class="nav-primary-wrapper">
        <div class="nav-primary-links-wrapper">
          <a href="/suites" class="nav-link _2">Suites</a>
          <a href="/restaurants" class="nav-link _4">Restaurants</a>
          <a href="/art" class="nav-link _3">Art</a>
          <a href="/experiences" class="nav-link _5">Experiences</a>
          <a href="/shop" class="nav-link _6">Shop</a>
        </div>
      </div>
      <div class="nav-secondary-wrapper">
        <div class="nav-secondary-links-wrapper">
          <a href="/blog" class="nav-secondary-link">Blog</a>
          <a href="/faq" class="nav-secondary-link">FAQ</a>
          <a href="/gift-vouchers" class="nav-secondary-link">Gift Vouchers</a>
          <a href="/contact" class="nav-secondary-link last">Contact</a>
        </div>
      </div>
    </div>
  </nav>

  {image && (
    <div class="full-frame-image-wrapper" style={`background-image: url(${image}); height: 60vh; background-size: cover; background-position: center;`}></div>
  )}

  <div class="section top-padding-192">
    <div class="container">
      <div class="heading-wrapper">
        <h1 class="h3-style">{heading}</h1>
      </div>
      {description && <p class="paragraph-3">{description}</p>}

      <!-- Content slot for future page content -->
      <slot />

      <div style="padding: 4rem 0; text-align: center;">
        <p style="color: #999; font-style: italic;">This page is ready for content — paste your copy and images here.</p>
        <a href="/" class="button secondary w-button" style="margin-top: 2rem;">← Back to Home</a>
      </div>
    </div>
  </div>

  <Footer />
</Layout>
