---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const entries = [
  {
    slug: "declared-artwork",
    date: "February 2026",
    title: "Toile Blanche: The Declared Artwork",
    excerpt: "A formal note on the transition from hospitality domain to a recognized work by the Leroy Brothers.",
    image: "/assets/images/page-img-2e6a5d90d6c3d3.avif",
  },
  {
    slug: "arik-levy-arrival",
    date: "November 2025",
    title: "The Arrival: Arik Levy",
    excerpt: "Documenting the installation of the new structural sculpture in the lower gardens.",
    image: "/assets/images/page-img-dd3867b14283dc.webp",
  },
];
---

<Layout
  title="The Archive | Toile Blanche | Saint-Paul de Vence"
  description="Occasional notes from Saint-Paul de Vence — new arrivals in the collection, seasonal tables, and the technical residues of the living artwork."
>
  <Nav theme="both" />

  <main>
    <!-- HEADER -->
    <section class="arc-header">
      <div class="arc-header-inner">
        <p class="arc-header-eyebrow">DNA — The Records</p>
        <h1>The Archive</h1>
        <p class="arc-header-tagline">Occasional notes from Saint-Paul de Vence — new arrivals in the collection, seasonal tables, and the technical residues of the living artwork.</p>
      </div>
    </section>

    <!-- ENTRIES -->
    <section class="arc-feed">
      {entries.map((entry, i) => (
        <a href={`/blog/${entry.slug}`} class="arc-entry">
          <div class="arc-entry-image">
            <img src={entry.image} alt={entry.title} loading="lazy" />
          </div>
          <div class="arc-entry-content">
            <span class="arc-entry-date">{entry.date}</span>
            <h2>{entry.title}</h2>
            <p>{entry.excerpt}</p>
            <span class="arc-entry-link">Access the log &rarr;</span>
          </div>
        </a>
      ))}
    </section>

    <!-- NEWSLETTER -->
    <section class="arc-newsletter">
      <div class="arc-newsletter-inner">
        <h2>The Journal</h2>
        <p>Not too often. Just enough. The occasional note from Saint-Paul de Vence — new arrivals in the collection and the things worth knowing before you visit.</p>
        <div class="arc-newsletter-placeholder">[ Newsletter embed ]</div>
        <p class="arc-newsletter-note">Join 2,000 travellers who already know.</p>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* ─── HEADER ─── */
  .arc-header {
    padding: 180px 80px 80px;
    border-bottom: 1px solid #E2D9CC;
  }
  .arc-header-inner {
    max-width: 800px;
  }
  .arc-header-eyebrow {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #9C9080;
    margin-bottom: 24px;
  }
  .arc-header h1 {
    font-family: 'Gilda Display', serif;
    font-size: clamp(48px, 7vw, 96px);
    font-weight: 400;
    line-height: 1.0;
    color: #1C1917;
    margin-bottom: 32px;
  }
  .arc-header-tagline {
    font-family: 'Gilda Display', serif;
    font-style: italic;
    font-size: clamp(18px, 2vw, 24px);
    line-height: 1.55;
    color: #6B6256;
    max-width: 600px;
  }

  /* ─── FEED ─── */
  .arc-feed {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 80px;
  }
  .arc-entry {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
    padding: 64px 0;
    border-bottom: 1px solid #E2D9CC;
    text-decoration: none;
    color: inherit;
  }
  .arc-entry-image {
    overflow: hidden;
  }
  .arc-entry-image img {
    width: 100%;
    aspect-ratio: 16/10;
    object-fit: cover;
    display: block;
    transition: transform 0.8s ease;
  }
  .arc-entry:hover .arc-entry-image img {
    transform: scale(1.03);
  }
  .arc-entry-date {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #9C9080;
    display: block;
    margin-bottom: 20px;
  }
  .arc-entry-content h2 {
    font-family: 'Gilda Display', serif;
    font-size: clamp(24px, 3vw, 40px);
    font-weight: 400;
    line-height: 1.15;
    color: #1C1917;
    margin-bottom: 20px;
  }
  .arc-entry-content p {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 16px;
    line-height: 1.7;
    color: #6B6256;
    margin-bottom: 28px;
    max-width: 420px;
  }
  .arc-entry-link {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #9e5c4a;
    border-bottom: 1px solid #9e5c4a;
    padding-bottom: 2px;
    transition: opacity 0.2s;
  }
  .arc-entry:hover .arc-entry-link {
    opacity: 0.7;
  }

  /* ─── NEWSLETTER ─── */
  .arc-newsletter {
    border-bottom: 1px solid #E2D9CC;
  }
  .arc-newsletter-inner {
    max-width: 600px;
    margin: 0 auto;
    padding: 96px 80px;
    text-align: center;
  }
  .arc-newsletter-inner h2 {
    font-family: 'Gilda Display', serif;
    font-style: italic;
    font-size: clamp(28px, 3vw, 40px);
    font-weight: 400;
    color: #1C1917;
    margin-bottom: 20px;
  }
  .arc-newsletter-inner > p {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 16px;
    line-height: 1.7;
    color: #6B6256;
    margin-bottom: 40px;
  }
  .arc-newsletter-placeholder {
    border: 1px solid #E2D9CC;
    padding: 24px;
    font-family: 'Didact Gothic', sans-serif;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #C4B9AA;
  }
  .arc-newsletter-note {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 10px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #C4B9AA;
    margin-top: 20px;
  }

  /* ─── RESPONSIVE ─── */
  @media (max-width: 900px) {
    .arc-header {
      padding: 140px 24px 48px;
    }
    .arc-feed {
      padding: 0 24px;
    }
    .arc-entry {
      grid-template-columns: 1fr;
      gap: 28px;
      padding: 40px 0;
    }
    .arc-newsletter-inner {
      padding: 64px 24px;
    }
  }
</style>
