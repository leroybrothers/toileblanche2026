---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
---

<Layout
  title="Estate Map | Toile Blanche | Saint-Paul de Vence"
  description="Interactive map of the Toile Blanche estate — suites, restaurants, sculptures, and gardens in Saint-Paul de Vence."
  ogImage="https://www.toileblanche.com/assets/images/estate-map.png"
>
  <Nav theme="light" />

  <main id="main-content">
    <section class="map-page">
      <div class="map-page-inner">
        <h1 class="map-page-title">Estate Map</h1>
        <p class="map-page-intro">Explore the domain: 22 suites across seven buildings, two restaurants, gardens, and the sculpture trail.</p>
        <div class="map-page-image-wrap">
          <img
            src="/assets/images/estate-map.png"
            alt="Toile Blanche interactive estate map — Le Restaurant, L'Hôtel, La Guinguette, suites, sculptures, and gardens"
            class="map-page-image"
            width="1200"
            height="800"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <p class="map-page-caption">Toile Blanche, 826 chemin de la Pounchounière — Saint-Paul de Vence</p>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .map-page {
    padding: 120px 24px 80px;
    background: var(--color-bg-warm, #FAF8F3);
    min-height: 100vh;
  }
  .map-page-inner {
    max-width: 1200px;
    margin: 0 auto;
  }
  .map-page-title {
    font-family: var(--font-display), 'Gilda Display', serif;
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 400;
    color: var(--color-ink, #1C1917);
    margin-bottom: 16px;
  }
  .map-page-intro {
    font-family: var(--font-body), 'Didact Gothic', sans-serif;
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-ink-muted, #6B6256);
    margin-bottom: 40px;
    max-width: 560px;
  }
  .map-page-image-wrap {
    background: #fff;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.06);
  }
  .map-page-image {
    width: 100%;
    height: auto;
    display: block;
    vertical-align: middle;
  }
  .map-page-caption {
    font-family: var(--font-body), 'Didact Gothic', sans-serif;
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--color-ink-muted, #9C9080);
    margin-top: 24px;
  }
</style>
