<style>
  /* ─── HERO ─── */
  .lgn-hero {
    position: relative;
    height: 85vh;
    min-height: 500px;
    overflow: hidden;
  }
  .lgn-hero-image {
    position: absolute;
    inset: 0;
  }
  .lgn-hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .lgn-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.5) 0%, transparent 55%);
  }
  .lgn-hero-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 0 80px 72px;
    color: #fff;
  }
  .lgn-hero-eyebrow {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    opacity: 0.8;
    margin-bottom: 16px;
    color: #fff;
  }
  .lgn-hero-content h1 {
    font-family: 'Gilda Display', serif;
    font-size: clamp(40px, 6vw, 80px);
    font-weight: 400;
    line-height: 1.05;
    color: #fff;
    margin-bottom: 16px;
  }
  .lgn-insta-ref {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: #fff;
    opacity: 0.55;
    transition: opacity 0.4s ease;
  }
  .lgn-insta-ref:hover {
    opacity: 1;
  }
  .lgn-insta-ref span {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 12px;
    letter-spacing: 0.12em;
    color: #fff !important;
  }

  /* ─── TAGLINE ─── */
  .lgn-tagline {
    border-bottom: 1px solid #E2D9CC;
  }
  .lgn-tagline-inner {
    max-width: 800px;
    margin: 0 auto;
    padding: 64px 80px;
    text-align: center;
  }
  .lgn-tagline-inner p {
    font-family: 'Gilda Display', serif;
    font-style: italic;
    font-size: clamp(20px, 2.5vw, 28px);
    line-height: 1.55;
    color: #3D3530;
  }

  /* ─── NARRATIVE + DETAILS ─── */
  .lgn-narrative {
    border-bottom: 1px solid #E2D9CC;
  }
  .lgn-narrative-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 80px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: start;
  }
  .lgn-narrative-text h2 {
    font-family: 'Gilda Display', serif;
    font-size: clamp(24px, 3vw, 36px);
    font-weight: 400;
    margin-bottom: 24px;
    color: #1C1917;
  }
  .lgn-narrative-text h2:not(:first-child) {
    margin-top: 48px;
  }
  .lgn-narrative-text p {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 16px;
    line-height: 1.8;
    color: #3D3530;
    margin-bottom: 16px;
  }

  .lgn-details {
    padding: 48px;
    background: rgba(226, 217, 204, 0.15);
  }
  .lgn-details-label {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #9C9080;
    margin-bottom: 40px;
  }
  .lgn-details-block {
    margin-bottom: 32px;
    padding-bottom: 32px;
    border-bottom: 1px solid rgba(226, 217, 204, 0.5);
  }
  .lgn-details-block:last-child {
    margin-bottom: 0;
    padding-bottom: 0;
    border-bottom: none;
  }
  .lgn-details-block h3 {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 10px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #9C9080;
    margin-bottom: 12px;
  }
  .lgn-details-block p {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 14px;
    line-height: 1.7;
    color: #3D3530;
  }
  .lgn-details-link {
    display: block;
    font-family: 'Didact Gothic', sans-serif;
    font-size: 14px;
    color: #3D3530;
    text-decoration: none;
    line-height: 1.7;
    transition: color 0.2s;
  }
  .lgn-details-link:hover {
    color: #9e5c4a;
  }
  .lgn-details-cta {
    text-align: center;
    padding-top: 8px;
    padding-bottom: 40px;
  }
  .lgn-btn {
    display: inline-block;
    font-family: 'Didact Gothic', sans-serif;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    color: #FAF8F3;
    background: #9e5c4a;
    padding: 16px 36px;
    transition: opacity 0.2s;
  }
  .lgn-btn:hover {
    opacity: 0.85;
  }

  /* ─── GALLERY (masonry, bon-vivant style) ─── */
  .lgn-gallery {
    border-bottom: 1px solid #E2D9CC;
    columns: 2;
    column-gap: 4px;
    line-height: 0;
  }
  .lgn-gallery-item {
    break-inside: avoid;
    margin-bottom: 4px;
    overflow: hidden;
    line-height: 0;
  }
  .lgn-gallery-item img {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.8s ease;
  }
  .lgn-gallery-item:hover img {
    transform: scale(1.03);
  }

  /* ─── THE MENU (accordion) ─── */
  .lgn-menu {
    border-bottom: 1px solid #E2D9CC;
  }
  .lgn-menu-inner {
    max-width: 800px;
    margin: 0 auto;
    padding: 80px;
  }
  .lgn-menu-accordion-trigger {
    width: 100%;
    text-align: left;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    font: inherit;
    color: inherit;
  }
  .lgn-menu-accordion-trigger:hover .lgn-menu-expand {
    color: #1C1917;
  }
  .lgn-menu-accordion-trigger[aria-expanded="true"] .lgn-menu-expand-icon {
    transform: rotate(180deg);
  }
  .lgn-menu-accordion-content {
    overflow: hidden;
    max-height: 0;
    opacity: 0;
    transition: max-height 0.4s ease, opacity 0.3s ease;
  }
  .lgn-menu-accordion-content[data-expanded="true"] {
    max-height: 5000px;
    opacity: 1;
    padding-top: 24px;
  }
  .lgn-menu-expand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 24px;
    font-family: 'Didact Gothic', sans-serif;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #9C9080;
    transition: color 0.2s;
  }
  .lgn-menu-expand-icon {
    flex-shrink: 0;
    transition: transform 0.3s ease;
  }
  .lgn-menu-label {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #9C9080;
    margin-bottom: 16px;
  }
  .lgn-menu-inner > h2 {
    font-family: 'Gilda Display', serif;
    font-size: clamp(28px, 3vw, 40px);
    font-weight: 400;
    color: #1C1917;
    margin-bottom: 16px;
  }
  .lgn-menu-intro {
    font-family: 'Gilda Display', serif;
    font-style: italic;
    font-size: clamp(16px, 2vw, 20px);
    line-height: 1.55;
    color: #3D3530;
    margin-bottom: 0;
    max-width: 700px;
  }
  .lgn-menu-section {
    margin-bottom: 48px;
  }
  .lgn-menu-section:last-of-type {
    margin-bottom: 40px;
  }
  .lgn-menu-section h3 {
    font-family: 'Gilda Display', serif;
    font-style: italic;
    font-size: 22px;
