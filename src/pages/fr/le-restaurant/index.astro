---
import Layout from '../../../layouts/Layout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import menu from '../../../data/menu-restaurant.json';
import { gallerySrcset, encodePath } from '../../../utils/images';
import { useTranslations } from '../../../i18n/index';
const lang = 'fr';
const t = useTranslations(lang);
---

<Layout
  locale="fr"
  title="Le Restaurant | Toile Blanche | Saint-Paul de Vence"
  description="Plus réfléchi, plus intime, une cuisine à son meilleur. Une ode à la Côte d'Azur."
  ogImage="https://www.toileblanche.com/assets/images/le-restaurant-hero.jpg"
  hideBookingBar={true}
  loadZenchef={true}
>
  <Nav locale="fr" theme="both" ctaText="Réserver une table" ctaAction="zenchef" />

  <main id="main-content">
    <!-- HERO -->
    <section class="lrs-hero">
      <div class="lrs-hero-image">
        <img src="/assets/images/le-restaurant-hero.jpg" alt="Le Restaurant de Toile Blanche" width="1024" height="768" loading="eager" fetchpriority="high" />
        <div class="lrs-hero-overlay"></div>
      </div>
      <div class="lrs-hero-content">
        <p class="lrs-hero-eyebrow">Dîner — Toute l'année</p>
        <h1>Le Restaurant</h1>
        <a href="https://www.instagram.com/lerestaurant.toileblanche/" target="_blank" rel="noopener noreferrer" class="lrs-insta-ref">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
          <span>@lerestaurant.toileblanche</span>
        </a>
      </div>
    </section>

    <!-- TAGLINE -->
    <section class="lrs-tagline">
      <div class="lrs-tagline-inner">
        <p>Plus réfléchi, plus intime, une cuisine à son meilleur. Une ode à la Côte d'Azur.</p>
      </div>
    </section>

    <!-- SPECIALS -->
    <section class="lrs-specials">
      <div class="lrs-specials-inner">
        <h3 class="lrs-specials-title">Menus de saison</h3>
        <div class="lrs-specials-list">
          <a href="https://online.fliphtml5.com/mxrbl/xkdg/" target="_blank" rel="noopener noreferrer" class="lrs-specials-link">Menu de Pâques →</a>
        </div>
      </div>
    </section>

    <!-- NARRATIVE + DETAILS -->
    <section class="lrs-narrative">
      <div class="lrs-narrative-inner">
        <div class="lrs-narrative-text">
          <h2>La table</h2>
          <p>Le menu des chefs Nicolas Leclair et Melissa Giordano suit le rythme des saisons. Ce qui est arrivé le matin, ce qui pousse dans le jardin d'herbes à vingt mètres de la cuisine, ce que les pêcheurs ont ramené à l'aube.</p>
          <p>La carte des vins est une déclaration d'amour à la région. L'accent est mis sur les producteurs à portée de voiture, domaines de Bellet, Bandol, Cassis et des collines au-dessus de Vence. Certaines bouteilles sont introuvables ailleurs.</p>
          <h2>L'&#x202F;espace</h2>
          <p>Le dîner est servi sur la terrasse donnant sur la vallée, ou dans la salle à manger quand la soirée en décide autrement. Informel, sans hâte, sans code vestimentaire. Juste une bonne cuisine dans une belle lumière.</p>
        </div>
        <div class="lrs-details">
          <p class="lrs-details-label">Informations Pratiques</p>

          <div class="lrs-details-block">
            <h3>Horaires</h3>
            <p>Dîner : 19h00 – 22h00 (été) / 19h00 – 21h00 (hiver)</p>
            <p>Ouvert toute l'année</p>
          </div>

          <div class="lrs-details-block">
            <h3>Réservation</h3>
            <p>Recommandée pour tous les convives.</p>
            <p>Les hôtes de l'hôtel peuvent réserver via la réception ou lors de leur réservation.</p>
          </div>

          <div class="lrs-details-block lrs-details-cta">
            <a href="https://bookings.zenchef.com/results?rid=357953&lang=fr" target="_blank" rel="noopener noreferrer" data-zc-action="open" class="lrs-btn">Réserver une Table</a>
          </div>

          <div class="lrs-details-block">
            <h3>Adresse</h3>
            <p>Toile Blanche</p>
            <p>826, chemin de la Pounchounière</p>
            <p>06570 Saint-Paul de Vence</p>
            <p>France</p>
          </div>

          <div class="lrs-details-block">
            <h3>Contact</h3>
            <a href="tel:+33493327421" class="lrs-details-link">+33 4 93 32 74 21</a>
            <a href="mailto:restaurant@toileblanche.com" class="lrs-details-link">restaurant@toileblanche.com</a>
          </div>
        </div>
      </div>
    </section>

    <!-- SEASONAL MENU (accordion) -->
    <section class="lrs-menu">
      <div class="lrs-menu-inner">
        <div class="lrs-menu-accordion">
          <button type="button" class="lrs-menu-accordion-trigger" aria-expanded="false" aria-controls="lrs-menu-content" id="lrs-menu-trigger" data-view={t.common.viewMenu} data-hide={t.common.hideMenu}>
            <span class="lrs-menu-accordion-header">
              <p class="lrs-menu-label">{menu.meta.season[lang]}</p>
              <h2>La Carte</h2>
              <p class="lrs-menu-intro">{menu.meta.philosophy[lang]}</p>
              <p class="lrs-menu-chefs">Chefs {menu.meta.chefs.join(' et ')}</p>
              <span class="lrs-menu-expand">
                <span class="lrs-menu-expand-text">{t.common.viewMenu}</span>
                <svg class="lrs-menu-expand-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path d="M6 9l6 6 6-6"/>
                </svg>
              </span>
            </span>
          </button>
          <div id="lrs-menu-content" class="lrs-menu-accordion-content" role="region" aria-labelledby="lrs-menu-trigger" hidden>
        <!-- SET MENU -->
        <div class="lrs-menu-set">
          <div class="lrs-menu-set-header">
            <h3>Menu {menu.set_menu.title}</h3>
            <span class="lrs-menu-set-price">{menu.set_menu.price}€</span>
          </div>
          {menu.set_menu.courses.map(course => (
            <div class="lrs-menu-course">
              <p class="lrs-menu-course-label">{course.type[lang]}</p>
              {course.options.map(opt => (
                <p class="lrs-menu-dish">{opt[lang]}</p>
              ))}
            </div>
          ))}
        </div>

        <!-- À LA CARTE: ENTRÉES -->
        <div class="lrs-menu-section">
          <h3>{menu.a_la_carte.starters.title[lang]}</h3>
          {menu.a_la_carte.starters.items.map(item => (
            <div class="lrs-menu-item">
              <p class="lrs-menu-dish">{item[lang]}</p>
              <span class="lrs-menu-price">{item.price}€</span>
            </div>
          ))}
        </div>

        <!-- À LA CARTE: PLATS -->
        {Object.values(menu.a_la_carte.mains).map(sub => (
          <div class="lrs-menu-section">
            <h3>{sub.title[lang]}</h3>
            {sub.items.map(item => (
              <div class="lrs-menu-item">
                <p class="lrs-menu-dish">{item[lang]}</p>
                <span class="lrs-menu-price">{item.price}€</span>
              </div>
            ))}
          </div>
        ))}

        <!-- EXTRAS -->
        <div class="lrs-menu-section lrs-menu-extras">
          <h3>{menu.a_la_carte.extras.title[lang]}</h3>
          <p class="lrs-extras-intro">Une touche de gourmandise pour accompagner votre plat — à savourer seul ou à partager.</p>
          <div class="lrs-menu-extras-grid">
            {menu.a_la_carte.extras.items.map(item => (
              <div class="lrs-menu-item">
                <p class="lrs-menu-dish">{item[lang]}</p>
                <span class="lrs-menu-price">{item.price}€</span>
              </div>
            ))}
          </div>
        </div>

        <!-- DESSERTS -->
        <div class="lrs-menu-section">
          <h3>{menu.a_la_carte.desserts.title[lang]}</h3>
          {menu.a_la_carte.desserts.items.map(item => (
            <div class="lrs-menu-item">
              <p class="lrs-menu-dish">{item[lang]}</p>
              <span class="lrs-menu-price">{item.price}€</span>
            </div>
          ))}
        </div>

        <!-- LEGAL -->
        <div class="lrs-menu-legal">
          <p>{menu.legal.meat_origins[lang]}</p>
          <p>{menu.legal.allergy_note[lang]}</p>
        </div>
          </div>
        </div>
      </div>
    </section>

    <!-- GALLERY (masonry: summer/outdoor first, winter/evening last) -->
    <section class="lrs-gallery">
      <div class="lrs-gallery-item">
        <img src="/assets/images/restaurant/IMG_7598.jpg" srcset={gallerySrcset('/assets/images/restaurant/IMG_7598.jpg')} sizes="(max-width: 900px) 100vw, 50vw" width="4032" height="3024" alt="La terrasse du Restaurant à Toile Blanche" loading="lazy" />
      </div>
      <div class="lrs-gallery-item">
        <img src="/assets/images/restaurant/IMG_4608.jpg" srcset={gallerySrcset('/assets/images/restaurant/IMG_4608.jpg')} sizes="(max-width: 900px) 100vw, 50vw" alt="Terrasse du Restaurant" loading="lazy" />
      </div>
      <div class="lrs-gallery-item">
        <img src="/assets/images/restaurant/IMG_5342.jpg" srcset={gallerySrcset('/assets/images/restaurant/IMG_5342.jpg')} sizes="(max-width: 900px) 100vw, 50vw" alt="Terrasse du Restaurant en plein air" loading="lazy" />
      </div>
      <div class="lrs-gallery-item">
        <img src="/assets/images/restaurant/IMG_9454.jpg" srcset={gallerySrcset('/assets/images/restaurant/IMG_9454.jpg')} sizes="(max-width: 900px) 100vw, 50vw" alt="Vue de la terrasse du Restaurant" loading="lazy" />
      </div>
      <div class="lrs-gallery-item">
        <img src={encodePath('/assets/images/restaurant/restaurantgallery/IMG_0275 (2).jpg')} srcset={gallerySrcset('/assets/images/restaurant/restaurantgallery/IMG_0275 (2).jpg')} sizes="(max-width: 900px) 100vw, 50vw" alt="Terrasse du Restaurant" loading="lazy" />
      </div>
      <div class="lrs-gallery-item">
        <img src="/assets/images/restaurant/restaurantgallery/IMG_0597.jpg" srcset={gallerySrcset('/assets/images/restaurant/restaurantgallery/IMG_0597.jpg')} sizes="(max-width: 900px) 100vw, 50vw" alt="Dîner en terrasse au Restaurant" loading="lazy" />
      </div>
      <div class="lrs-gallery-item">
        <img src={encodePath('/assets/images/restaurant/DSCF4081 2.JPG')} srcset={gallerySrcset('/assets/images/restaurant/DSCF4081 2.JPG')} sizes="(max-width: 900px) 100vw, 50vw" alt="Plat de saison au Restaurant" loading="lazy" />
      </div>
      <div class="lrs-gallery-item">
        <img src="/assets/images/restaurant/restaurantgallery/DSCF5723.JPG" srcset={gallerySrcset('/assets/images/restaurant/restaurantgallery/DSCF5723.JPG')} sizes="(max-width: 900px) 100vw, 50vw" alt="Le Restaurant" loading="lazy" />
      </div>
      <div class="lrs-gallery-item">
        <img src="/assets/images/restaurant/restaurantgallery/IMG_0377.jpg" srcset={gallerySrcset('/assets/images/restaurant/restaurantgallery/IMG_0377.jpg')} sizes="(max-width: 900px) 100vw, 50vw" alt="Dîner à Toile Blanche" loading="lazy" />
      </div>
      <div class="lrs-gallery-item">
        <img src="/assets/images/restaurant/IMG_4849.jpg" srcset={gallerySrcset('/assets/images/restaurant/IMG_4849.jpg')} sizes="(max-width: 900px) 100vw, 50vw" alt="Dîner au Restaurant" loading="lazy" />
      </div>
      <div class="lrs-gallery-item">
        <img src={encodePath('/assets/images/restaurant/DSCF4129 2.JPG')} srcset={gallerySrcset('/assets/images/restaurant/DSCF4129 2.JPG')} sizes="(max-width: 900px) 100vw, 50vw" alt="Dîner au Restaurant" loading="lazy" />
      </div>
      <div class="lrs-gallery-item">
        <img src={encodePath('/assets/images/restaurant/DSCF6210 2.JPG')} srcset={gallerySrcset('/assets/images/restaurant/DSCF6210 2.JPG')} sizes="(max-width: 900px) 100vw, 50vw" alt="Expérience culinaire à Toile Blanche" loading="lazy" />
      </div>
      <div class="lrs-gallery-item">
        <img src="/assets/images/restaurant/restaurantgallery/IMG_0611.jpg" srcset={gallerySrcset('/assets/images/restaurant/restaurantgallery/IMG_0611.jpg')} sizes="(max-width: 900px) 100vw, 50vw" alt="Ambiance du Restaurant" loading="lazy" />
      </div>
      <div class="lrs-gallery-item">
        <img src="/assets/images/restaurant/restaurantgallery/IMG_0676.jpg" srcset={gallerySrcset('/assets/images/restaurant/restaurantgallery/IMG_0676.jpg')} sizes="(max-width: 900px) 100vw, 50vw" alt="Dîner au Restaurant" loading="lazy" />
      </div>
      <div class="lrs-gallery-item">
        <img src="/assets/images/restaurant/restaurantgallery/IMG_3983.jpg" srcset={gallerySrcset('/assets/images/restaurant/restaurantgallery/IMG_3983.jpg')} sizes="(max-width: 900px) 100vw, 50vw" alt="Table au Restaurant" loading="lazy" />
      </div>
      <div class="lrs-gallery-item">
        <img src={encodePath('/assets/images/restaurant/DSCF5782 2.JPG')} srcset={gallerySrcset('/assets/images/restaurant/DSCF5782 2.JPG')} sizes="(max-width: 900px) 100vw, 50vw" alt="Cuisine au Restaurant" loading="lazy" />
      </div>
      <div class="lrs-gallery-item">
        <img src={encodePath('/assets/images/restaurant/restaurantgallery/DSCF6204 2.JPG')} srcset={gallerySrcset('/assets/images/restaurant/restaurantgallery/DSCF6204 2.JPG')} sizes="(max-width: 900px) 100vw, 50vw" alt="Soirée au Restaurant" loading="lazy" />
      </div>
      <div class="lrs-gallery-item">
        <img src="/assets/images/restaurant/restaurantgallery/IMG_4015.jpg" srcset={gallerySrcset('/assets/images/restaurant/restaurantgallery/IMG_4015.jpg')} sizes="(max-width: 900px) 100vw, 50vw" alt="Soirée au Restaurant" loading="lazy" />
      </div>
    </section>

    <!-- PHILOSOPHY -->
    <section class="lrs-quote">
      <div class="lrs-quote-inner">
        <h2>Les tomates sont arrivées ce matin. Les herbes ont été coupées il y a dix minutes. Le vin vient de la vallée voisine.</h2>
      </div>
    </section>

    <!-- CTA -->
    <section class="lrs-cta">
      <p>La table est dressée.</p>
      <a href="https://bookings.zenchef.com/results?rid=357953&lang=fr" target="_blank" rel="noopener noreferrer" data-zc-action="open" class="lrs-cta-btn">Réserver une Table</a>
    </section>
  </main>

  <Footer locale="fr" />
</Layout>

<script>
  (function () {
    const trigger = document.getElementById('lrs-menu-trigger');
    const content = document.getElementById('lrs-menu-content');
    if (!trigger || !content) return;
    const expandText = trigger.querySelector('.lrs-menu-expand-text');
    const viewMenu = trigger.dataset.view || 'Voir la carte';
    const hideMenu = trigger.dataset.hide || 'Masquer la carte';

    trigger.addEventListener('click', function () {
      const expanded = trigger.getAttribute('aria-expanded') === 'true';
      trigger.setAttribute('aria-expanded', String(!expanded));
      content.setAttribute('data-expanded', String(!expanded));
      content.toggleAttribute('hidden', expanded);
      if (expandText) expandText.textContent = expanded ? viewMenu : hideMenu;
    });
  })();
</script>

