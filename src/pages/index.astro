---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import suitesData from '../data/suites.json';

function cardBase(path) {
  return path.replace(/\.[^.]+$/, '');
}

function srcset(path, widths) {
  const ext = path.substring(path.lastIndexOf('.'));
  const base = path.substring(0, path.lastIndexOf('.'));
  return widths.map(w => `${base}-${w}w${ext} ${w}w`).join(', ') + `, ${path} ${widths[widths.length - 1] * 2}w`;
}

const suites = suitesData.suites.map(s => ({
  href: `/suites/${s.slug}`,
  image: s.images.card,
  base: cardBase(s.images.card),
  hasOptimized: s.images.card.includes('/Homepage/'),
  alt: s.images.cardAlt,
  title: s.name,
  description: s.tagline,
}));
---

<Layout
  title="Toile Blanche | Saint-Paul de Vence"
  description="22 suites, two restaurants, and a contemporary art collection in Saint-Paul de Vence. A declared artwork by the Leroy Brothers on the Côte d'Azur."
  ogImage="https://www.toileblanche.com/assets/images/parallax1.jpg"
  homeHeroPreload
>
  <!-- Page Loader -->
  <div class="loader" id="page-loader">
    <div class="loader-logo-wrapper">
      <img src="/assets/images/63a19dacd6b229843a52a138_Toile%20Blanche%20Logo%202022%20black.avif" loading="lazy" alt="Toile Blanche" width="200" height="60" />
      <div class="loader-line"></div>
    </div>
  </div>

  <!-- Hero Section -->
  <main id="main-content">
  <header class="hero1" id="hero" style="opacity:0">
    <div class="hero-bg-wrapper hero-bg-parallax">
      <div class="hero-bg-slide hero-bg-slide-1 is-active" role="img" aria-label="Pool and sun loungers at Toile Blanche, Saint-Paul de Vence"></div>
    </div>
    <div class="hero-bg-overlay"></div>

    <Nav theme="both" />
  </header>

  <!-- Hero tagline: editorial statement below the image -->
  <section class="tb-hero-tagline" aria-label="Tagline">
    <div class="container">
      <p class="tb-hero-tagline-line">The Côte d'Azur, without the spectacle.</p>
      <p class="tb-hero-tagline-line">The art is not on the walls, it is the walls.</p>
    </div>
  </section>

  <!-- Introduction -->
  <div class="section tb-intro-section">
    <div class="container">
      <div class="tb-intro-blocks">
        <div class="tb-intro-block fade-up">
          <h2 class="tb-intro-block-title">The Story</h2>
          <p>When the three Leroy brothers and their families arrived in Saint-Paul de Vence in 2004, they created a first version of Toile Blanche. No master plan yet, but an instinct, and a deep love for the ridge.</p>
          <p>Over the next twenty years, the dream took shape. House by house, Toile Blanche grew, sharpened, became what it had always wanted to be.</p>
          <p>The result is something genuinely difficult to categorise.</p>
          <p>22 suites. Two restaurants. Three pools. 20,000m² of gardens. Countless sculptures. Saint-Paul de Vence.</p>
        </div>
        <div class="tb-intro-block fade-up">
          <h2 class="tb-intro-block-title">The Place</h2>
          <p>Picasso, Chagall, Giacometti and so many others left their mark on this village. The Fondation Maeght carries their legacy. Toile Blanche continues it, supporting emerging artists whose works are shown and celebrated in our gallery and gardens.</p>
          <p>The pool is warm. The rosé is cold. The art makes you pause, and then you go back to the pool.</p>
          <p>This is the point. And the particular pleasure of going nowhere for a few days.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Suites Slider -->
  <div class="section tb-suites-section overlap-section-top">
    <div class="home-room-slider-wrapper fade-up">
      <div class="home-room-slider js-slider" id="suites-slider" role="region" aria-label="Suite gallery">
        <button type="button" class="room-slider-arrow room-slider-left-arrow js-slider-prev" aria-label="Previous suite">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <button type="button" class="room-slider-arrow room-slider-right-arrow js-slider-next" aria-label="Next suite">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
        </button>
        <div class="home-room-mask js-slider-track">
          {suites.map((suite, i) => (
            <div class={`home-room-single-slide js-slide${suite.href === '/suites/mas-artiste' ? ' room-slide-masartiste' : ''}`} data-slide-index={i} role="group" aria-label={`${i + 1} of ${suites.length}`}>
              <a href={suite.href} class="room-slide-wrapper w-inline-block">
                <div class="room-slide-image-wrapper">
                  <div class="room-slide-image-container">
                    {suite.hasOptimized ? (
                    <picture>
                      <source type="image/avif" srcset={`${suite.base}-400w.avif 400w, ${suite.base}-800w.avif 800w, ${suite.base}-1200w.avif 1200w, ${suite.base}-1800w.avif 1800w`} sizes="100vw" />
                      <source type="image/webp" srcset={`${suite.base}-400w.webp 400w, ${suite.base}-800w.webp 800w, ${suite.base}-1200w.webp 1200w, ${suite.base}-1800w.webp 1800w`} sizes="100vw" />
                      <img loading="lazy" alt={suite.alt} src={`${suite.base}-800w.jpg`} srcset={`${suite.base}-400w.jpg 400w, ${suite.base}-800w.jpg 800w, ${suite.base}-1200w.jpg 1200w, ${suite.base}-1800w.jpg 1800w`} sizes="100vw" class="room-slide-image" width="533" height="400" />
                    </picture>
                  ) : (
                    <img loading="lazy" alt={suite.alt} src={suite.image} srcset={srcset(suite.image, [400, 800, 1200])} sizes="100vw" class="room-slide-image" width="533" height="400" />
                  )}
                  </div>
                </div>
                <div class="room-slide-content-wrapper">
                  <div class="room-slide-title">
                    <h2 class="light">{suite.title}</h2>
                  </div>
                  <div class="room-slide-description">
                    <p class="light">{suite.description}</p>
                  </div>
                </div>
              </a>
            </div>
          ))}
        </div>
      </div>
      <div class="room-slider-dots" aria-label="Slide navigation">
        {suites.map((_, i) => (
          <button type="button" class="room-slider-dot js-slider-dot" data-index={i} aria-label={`Go to slide ${i + 1}`} aria-current={i === 0 ? 'true' : undefined} />
        ))}
      </div>
    </div>
    <div class="suites-view-all-link">
      <a href="/suites" class="suites-view-all-btn">View all suites</a>
    </div>
  </div>

  <!-- Full-width parallax: pool (slideshow1) -->
  <div class="section no-bottom-padding no-top-padding">
    <div class="homepage-parallax-pool" role="img" aria-label="Pool and sun loungers at Toile Blanche, Saint-Paul de Vence"></div>
  </div>

  <!-- Art, Restaurants, Experiences -->
  <div class="section top-padding-192">
    <div class="container">
      <div class="tb-three-blocks">
        <!-- Art -->
        <div class="tb-feature-block fade-up">
          <div class="tb-feature-block-image">
            <a href="/art" class="tb-feature-block-image-link">
              <picture>
                <source type="image/avif" srcset="/assets/images/677ce5a0ffdffd79d9f89e13_Aerts 6 (1)-p-1600-524w.avif 524w, /assets/images/677ce5a0ffdffd79d9f89e13_Aerts 6 (1)-p-1600-800w.avif 800w" sizes="(max-width: 767px) 100vw, 524px" />
                <source type="image/webp" srcset="/assets/images/677ce5a0ffdffd79d9f89e13_Aerts 6 (1)-p-1600-524w.webp 524w, /assets/images/677ce5a0ffdffd79d9f89e13_Aerts 6 (1)-p-1600-800w.webp 800w" sizes="(max-width: 767px) 100vw, 524px" />
                <img src="/assets/images/677ce5a0ffdffd79d9f89e13_Aerts 6 (1)-p-1600-524w.jpg" srcset="/assets/images/677ce5a0ffdffd79d9f89e13_Aerts 6 (1)-p-1600-524w.jpg 524w, /assets/images/677ce5a0ffdffd79d9f89e13_Aerts 6 (1)-p-1600-800w.jpg 800w" sizes="(max-width: 767px) 100vw, 524px" alt="Contemporary art at Toile Blanche" width="524" height="654" loading="lazy" />
              </picture>
            </a>
          </div>
          <div class="tb-feature-block-content">
            <h2>Art</h2>
            <p>The works presented here are chosen with care. Each piece is selected in conversation with the artist. Some were created specifically for the property.</p>
            <p>The collection is alive: paintings, sculptures, photographs and installations.</p>
            <p>In 2026, Toile Blanche was declared an artwork by the Leroy Brothers.</p>
            <a href="/art" class="button secondary w-button">Discover the art</a>
          </div>
        </div>

        <!-- Restaurants -->
        <div class="tb-feature-block tb-feature-block--reverse fade-up">
          <div class="tb-feature-block-image">
            <a href="/restaurants" class="tb-feature-block-image-link">
              <picture>
                <source type="image/avif" srcset="/assets/images/restaurants-terrace-524w.avif 524w, /assets/images/restaurants-terrace-800w.avif 800w" sizes="(max-width: 767px) 100vw, 524px" />
                <source type="image/webp" srcset="/assets/images/restaurants-terrace-524w.webp 524w, /assets/images/restaurants-terrace-800w.webp 800w" sizes="(max-width: 767px) 100vw, 524px" />
                <img src="/assets/images/restaurants-terrace-524w.jpg" srcset="/assets/images/restaurants-terrace-524w.jpg 524w, /assets/images/restaurants-terrace-800w.jpg 800w" sizes="(max-width: 767px) 100vw, 524px" alt="Dining terrace at Toile Blanche, Le Restaurant and La Guinguette" width="524" height="656" loading="lazy" />
              </picture>
            </a>
          </div>
          <div class="tb-feature-block-content">
            <h2>Two Tables Worth Travelling For</h2>
            <p>La Guinguette, lunch in the shade of the trees. Rosé, grilled fish, Provençal dishes to share.</p>
            <p>Le Restaurant for the evening. Refined, intimate. In summer, on the terrace.</p>
            <p>Come barefoot if you like. The South will do the rest.</p>
            <a href="/restaurants" class="button secondary w-button">Reserve a table</a>
          </div>
        </div>

        <!-- La Vie Ici -->
        <div class="tb-feature-block fade-up">
          <div class="tb-feature-block-image">
            <a href="/la-vie-ici" class="tb-feature-block-image-link">
              <picture>
                <source type="image/avif" srcset="/assets/images/Experiences-524w.avif 524w, /assets/images/Experiences-800w.avif 800w" sizes="(max-width: 767px) 100vw, 524px" />
                <source type="image/webp" srcset="/assets/images/Experiences-524w.webp 524w, /assets/images/Experiences-800w.webp 800w" sizes="(max-width: 767px) 100vw, 524px" />
                <img src="/assets/images/Experiences-524w.jpg" srcset="/assets/images/Experiences-524w.jpg 524w, /assets/images/Experiences-800w.jpg 800w" sizes="(max-width: 767px) 100vw, 524px" alt="Experiences at Toile Blanche" width="524" height="656" loading="lazy" />
              </picture>
            </a>
          </div>
          <div class="tb-feature-block-content">
            <h2>Life at Toile Blanche</h2>
            <p>Saint-Paul de Vence is twenty minutes on foot. Fondation Maeght is five by car. Studio visits, the Art Route, the valley on a bicycle.</p>
            <p>And above all, the pleasantly outdated pleasure of doing nothing at all.</p>
            <a href="/la-vie-ici" class="button secondary w-button">La Vie Ici</a>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- Full frame image 1 -->
  <div class="section no-bottom-padding no-top-padding">
    <div class="full-frame-image-wrapper homepage-one"></div>
  </div>

  <!-- Direct Privilege -->
  <section class="tb-direct-privilege">
    <h2 class="tb-dp-headline">Book at the Source.</h2>
    <p class="tb-dp-intro">Reserve your stay directly with Toile Blanche for a more personal experience and the best available value.</p>
    <div class="tb-dp-grid">
      <div class="tb-dp-item">
        <p class="tb-dp-label">Best Rate Guaranteed</p>
        <p class="tb-dp-desc">The most favourable price is only found here.</p>
      </div>
      <div class="tb-dp-item">
        <p class="tb-dp-label">Priority Upgrades</p>
        <p class="tb-dp-desc">Direct guests are first in line for suite upgrades.</p>
      </div>
      <div class="tb-dp-item">
        <p class="tb-dp-label">Book Direct</p>
        <p class="tb-dp-desc">The same conditions as anywhere else. Except you're talking to us directly. No hidden fees. And someone who actually knows the property on the other end of the phone.</p>
      </div>
    </div>
    <p class="tb-dp-winter">
      Between November and March, longer stays come with additional advantages.
      <a href="/l-hiver" class="tb-dp-winter-link">Discover L'Hiver →</a>
    </p>
    <div class="tb-dp-cta-wrap">
      <a href="#" class="tb-dp-cta distributor-open">Reserve My Suite</a>
    </div>
  </section>

  <!-- Newsletter -->
  <div class="section padding-96 bg-color-2">
    <div class="container">
      <div class="tb-newsletter">
        <div class="tb-newsletter-content">
          <h2 class="tb-newsletter-title">A home away from home, for people who have exceptional homes. Stay in touch.</h2>
          <p class="tb-newsletter-desc">Not too often. Just enough. The occasional note from Saint-Paul de Vence, new arrivals in the collection, what is on the table this season, and what is worth knowing before you arrive.</p>
          <p class="tb-newsletter-cta">Join 4500 people who already know.</p>
        </div>
        <div class="tb-newsletter-form-wrap">
          <form id="newsletter-form" class="tb-newsletter-form">
            <div class="tb-newsletter-row">
              <div class="tb-newsletter-field">
                <label for="nl-first">First name</label>
                <input id="nl-first" name="firstName" type="text" placeholder="First name" maxlength="256" required />
              </div>
              <div class="tb-newsletter-field">
                <label for="nl-last">Last name</label>
                <input id="nl-last" name="lastName" type="text" placeholder="Last name" maxlength="256" required />
              </div>
              <div class="tb-newsletter-field">
                <label for="nl-email">Email address</label>
                <input id="nl-email" name="email" type="email" placeholder="Email address" maxlength="256" required />
              </div>
              <button type="submit" class="tb-newsletter-submit">Stay in Touch</button>
            </div>
          </form>
          <p class="tb-newsletter-msg tb-newsletter-success" aria-live="polite">Thank you. You are on the list.</p>
          <p class="tb-newsletter-msg tb-newsletter-error" aria-live="polite">Something went wrong. Please try again.</p>
          <p class="tb-newsletter-legal">By subscribing to The Toile Blanche Journal you agree to our <a href="/privacy-policy">privacy policy</a></p>
        </div>
      </div>
    </div>
  </div>

  <div class="divider _96px"></div>

  <Footer />
  </main>
</Layout>

<script type="application/ld+json" is:inline>
{
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Toile Blanche, Saint-Paul de Vence",
  "description": "22 suites, two restaurants, and a contemporary art collection in Saint-Paul de Vence. A declared artwork by the Leroy Brothers on the Côte d'Azur.",
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": [".tb-hero-tagline", ".tb-intro-block"]
  },
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://www.toileblanche.com/"
      }
    ]
  }
}
</script>

<script is:inline>
(function () {
  var form = document.getElementById('newsletter-form');
  if (!form) return;

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    var wrap = form.closest('.tb-newsletter-form-wrap');
    var btn = form.querySelector('.tb-newsletter-submit');
    var data = new FormData(form);

    wrap.classList.remove('is-error');
    btn.classList.add('is-sending');
    btn.textContent = '…';

    fetch('/api/newsletter', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        email: data.get('email'),
        firstName: data.get('firstName'),
        lastName: data.get('lastName')
      })
    })
      .then(function (res) {
        if (!res.ok) throw new Error(res.status);
        wrap.classList.add('is-success');
      })
      .catch(function () {
        wrap.classList.add('is-error');
        btn.classList.remove('is-sending');
        btn.textContent = form.dataset.submitLabel || 'Stay in Touch';
      });
  });
})();
</script>
