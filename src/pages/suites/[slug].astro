---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import suitesData from '../../data/suites.json';

export function getStaticPaths() {
  const { masterAmenities, suites } = suitesData;

  return suites.map((suite) => ({
    params: { slug: suite.slug },
    props: {
      suite,
      allSuites: suites,
      amenities: [...masterAmenities, ...suite.extras],
    },
  }));
}

const { suite, allSuites, amenities } = Astro.props;
const otherSuites = allSuites.filter(s => s.slug !== suite.slug);

function srcset(path: string, widths: number[]) {
  const ext = path.substring(path.lastIndexOf('.'));
  const base = path.substring(0, path.lastIndexOf('.'));
  return widths.map(w => `${base}-${w}w${ext} ${w}w`).join(', ') + `, ${path} ${widths[widths.length - 1] * 2}w`;
}
const heroSrcset = (p: string) => srcset(p, [800, 1200]);
const gallerySrcset = (p: string) => srcset(p, [600, 1200]);
const cardSrcset = (p: string) => srcset(p, [400]);
---

<Layout
  title={`${suite.name} | Toile Blanche | Saint-Paul de Vence`}
  description={suite.tagline}
  ogImage={`https://www.toileblanche.com${suite.images.hero}`}
>
  <Nav theme="both" />

  <main id="main-content">
    <!-- HERO -->
    <section class="sd-hero">
      <div class="sd-hero-image">
        <img src={suite.images.hero} srcset={heroSrcset(suite.images.hero)} sizes="100vw" alt={suite.name} loading="eager" fetchpriority="high" />
        <div class="sd-hero-overlay"></div>
      </div>
      <div class="sd-hero-content">
        <p class="sd-hero-eyebrow">{suite.index} — {suite.specs.count}</p>
        <h1>{suite.name}</h1>
      </div>
    </section>

    <!-- TAGLINE + SPECS -->
    <section class="sd-intro">
      <div class="sd-intro-inner">
        <div class="sd-intro-tagline">
          <p>{suite.tagline}</p>
        </div>
        <div class="sd-intro-specs">
          <div class="sd-spec">{suite.specs.size}</div>
          <div class="sd-spec">{suite.specs.occupancy}</div>
          <div class="sd-spec">{suite.specs.view}</div>
          <div class="sd-spec">{suite.specs.features}</div>
          {suite.hasPool && <div class="sd-spec sd-spec-pool">Private pool</div>}
        </div>
      </div>
    </section>

    <!-- NARRATIVE -->
    <section class="sd-narrative">
      <div class="sd-narrative-inner">
        <div class="sd-narrative-text">
          <h2>The Feeling</h2>
          <p class="sd-narrative-desc">{suite.description}</p>
          <p class="sd-narrative-maxibar">The cabinet is stocked with full bottles rather than miniatures — Côtes de Provence rosé, white and red from local producers, champagne, regional provisions, and the Toile Blanche bonbons that guests tend to mention unprompted.</p>
        </div>
        <div class="sd-amenities">
          <p class="sd-amenities-title">Amenities</p>
          <ul>
            {amenities.map(item => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- GALLERY -->
    <section class="sd-gallery">
      {suite.images.gallery.map((img, i) => (
        <div class={`sd-gallery-item sd-gallery-item-${i + 1}`}>
          <img src={img} srcset={gallerySrcset(img)} sizes="(max-width: 900px) 100vw, 50vw" alt={`${suite.name} — view ${i + 1}`} loading="lazy" />
        </div>
      ))}
    </section>

    <!-- LIGHTBOX -->
    <div class="sd-lightbox" id="sd-lightbox" role="dialog" aria-label="Image gallery" aria-hidden="true">
      <div class="sd-lightbox-backdrop"></div>
      <button class="sd-lightbox-close" aria-label="Close">&times;</button>
      <button class="sd-lightbox-prev" aria-label="Previous image">&#8249;</button>
      <button class="sd-lightbox-next" aria-label="Next image">&#8250;</button>
      <div class="sd-lightbox-img-wrap">
        <img class="sd-lightbox-img" src="" alt="" />
      </div>
      <div class="sd-lightbox-counter"></div>
    </div>

    <!-- DIRECT BOOKING ADVANTAGE -->
    <section class="sd-direct">
      <h2 class="sd-direct-title">The Direct Advantage</h2>
      <div class="sd-direct-grid">
        <div class="sd-direct-item">
          <p class="sd-direct-heading">Best Rate Guaranteed</p>
          <p class="sd-direct-desc">You will not find a more favourable price elsewhere.</p>
        </div>
        <div class="sd-direct-item">
          <p class="sd-direct-heading">Priority for Upgrades</p>
          <p class="sd-direct-desc">Direct guests are always first in line for suite upgrades, subject to availability.</p>
        </div>
        <div class="sd-direct-item">
          <p class="sd-direct-heading">Breakfast Included</p>
          <p class="sd-direct-desc">Our full Provençal breakfast, every morning. <span class="sd-direct-value">(A €35 value per person.)</span></p>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="sd-cta">
      <p>22 suites. No two the same.</p>
      <a href="#" class="sd-cta-btn distributor-open">Reserve {suite.name}</a>
    </section>

    <!-- EXPLORE OTHER SUITES -->
    <section class="sd-explore">
      <h2>Explore other Suites</h2>
      <div class="sd-explore-grid">
        {otherSuites.map(s => (
          <a href={`/suites/${s.slug}`} class="sd-explore-card">
            <div class="sd-explore-img">
              <img src={s.images.card} srcset={cardSrcset(s.images.card)} sizes="(max-width: 900px) 50vw, 25vw" alt={s.name} loading="lazy" />
            </div>
            <p class="sd-explore-name">{s.name}</p>
          </a>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "HotelRoom",
  "name": suite.name,
  "description": suite.tagline,
  "image": `https://www.toileblanche.com${suite.images.hero}`,
  "url": `https://www.toileblanche.com/suites/${suite.slug}`,
  "occupancy": {
    "@type": "QuantitativeValue",
    "value": parseInt(suite.specs.occupancy) || 2,
    "unitText": "guests"
  },
  "floorSize": {
    "@type": "QuantitativeValue",
    "value": suite.specs.size,
    "unitCode": "MTK"
  },
  "numberOfRooms": suite.specs.count,
  "amenityFeature": [
    ...suite.extras.map(e => ({ "@type": "LocationFeatureSpecification", "name": e, "value": true })),
    { "@type": "LocationFeatureSpecification", "name": suite.specs.view, "value": true }
  ],
  "containedInPlace": {
    "@type": "Hotel",
    "name": "Toile Blanche",
    "url": "https://www.toileblanche.com"
  }
})} />

<style>
  /* ─── HERO ─── */
  .sd-hero {
    position: relative;
    height: 85vh;
    min-height: 500px;
    overflow: hidden;
  }
  .sd-hero-image {
    position: absolute;
    inset: 0;
  }
  .sd-hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .sd-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.45) 0%, transparent 50%);
  }
  .sd-hero-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 0 80px 72px;
    color: #fff;
  }
  .sd-hero-eyebrow {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    opacity: 0.8;
    margin-bottom: 16px;
    color: #fff;
  }
  .sd-hero-content h1 {
    font-family: 'Gilda Display', serif;
    font-size: clamp(40px, 6vw, 80px);
    font-weight: 400;
    line-height: 1.05;
    color: #fff;
  }

  /* ─── INTRO (tagline + specs) ─── */
  .sd-intro {
    border-bottom: 1px solid #E2D9CC;
  }
  .sd-intro-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 64px 80px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: start;
  }
  .sd-intro-tagline p {
    font-family: 'Gilda Display', serif;
    font-style: italic;
    font-size: clamp(20px, 2.5vw, 28px);
    line-height: 1.55;
    color: #3D3530;
  }
  .sd-intro-specs {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
  }
  .sd-spec {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #6B6256;
    padding: 8px 16px;
    border: 1px solid #E2D9CC;
  }
  .sd-spec-pool {
    background: #1C1917;
    color: #FAF8F3;
    border-color: #1C1917;
  }

  /* ─── NARRATIVE ─── */
  .sd-narrative {
    border-bottom: 1px solid #E2D9CC;
  }
  .sd-narrative-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 80px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: start;
  }
  .sd-narrative-text h2 {
    font-family: 'Gilda Display', serif;
    font-size: clamp(24px, 3vw, 36px);
    font-weight: 400;
    margin-bottom: 28px;
    color: #1C1917;
  }
  .sd-narrative-desc {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 16px;
    line-height: 1.8;
    color: #3D3530;
    margin-bottom: 32px;
  }
  .sd-narrative-maxibar {
    font-family: 'Gilda Display', serif;
    font-style: italic;
    font-size: 16px;
    line-height: 1.7;
    color: #6B6256;
    padding-top: 28px;
    border-top: 1px solid #E2D9CC;
  }
  .sd-amenities {
    padding: 40px;
    background: rgba(226, 217, 204, 0.15);
  }
  .sd-amenities-title {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #9C9080;
    margin-bottom: 28px;
  }
  .sd-amenities ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px 32px;
  }
  .sd-amenities li {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 13px;
    color: #3D3530;
    padding-bottom: 12px;
    border-bottom: 1px solid rgba(226, 217, 204, 0.5);
  }

  /* ─── GALLERY ─── */
  .sd-gallery {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr auto;
    gap: 4px;
  }
  .sd-gallery-item {
    overflow: hidden;
    cursor: pointer;
  }
  .sd-gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.8s ease;
  }
  .sd-gallery-item:hover img {
    transform: scale(1.03);
  }
  .sd-gallery-item-1 {
    grid-column: 1 / 2;
    grid-row: 1 / 3;
    aspect-ratio: 3/4;
  }
  .sd-gallery-item-2 {
    grid-column: 2 / 3;
    grid-row: 1 / 2;
  }
  .sd-gallery-item-3 {
    grid-column: 2 / 3;
    grid-row: 2 / 3;
  }
  .sd-gallery-item-4 {
    grid-column: 1 / 2;
    grid-row: 3 / 4;
    aspect-ratio: 4/3;
  }
  .sd-gallery-item-5 {
    grid-column: 2 / 3;
    grid-row: 3 / 4;
    aspect-ratio: 4/3;
  }

  /* ─── LIGHTBOX ─── */
  .sd-lightbox {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease, visibility 0.25s ease;
  }
  .sd-lightbox.is-active {
    opacity: 1;
    visibility: visible;
  }
  .sd-lightbox-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.92);
    backdrop-filter: blur(8px);
  }
  .sd-lightbox-img-wrap {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .sd-lightbox-img {
    max-width: 88vw;
    max-height: 82vh;
    object-fit: contain;
    display: block;
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .sd-lightbox-img.is-loaded {
    opacity: 1;
  }
  .sd-lightbox-close {
    position: absolute;
    top: 20px;
    right: 24px;
    z-index: 1;
    background: none;
    border: none;
    color: #fff;
    font-size: 32px;
    cursor: pointer;
    opacity: 0.7;
    transition: opacity 0.2s;
    line-height: 1;
    padding: 8px;
  }
  .sd-lightbox-close:hover { opacity: 1; }
  .sd-lightbox-prev,
  .sd-lightbox-next {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 1;
    background: none;
    border: none;
    color: #fff;
    font-size: 48px;
    cursor: pointer;
    opacity: 0.5;
    transition: opacity 0.2s;
    padding: 16px;
    line-height: 1;
  }
  .sd-lightbox-prev { left: 16px; }
  .sd-lightbox-next { right: 16px; }
  .sd-lightbox-prev:hover,
  .sd-lightbox-next:hover { opacity: 1; }
  .sd-lightbox-counter {
    position: absolute;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    font-family: 'Didact Gothic', sans-serif;
    font-size: 12px;
    letter-spacing: 0.15em;
    color: rgba(255, 255, 255, 0.6);
  }

  /* ─── DIRECT BOOKING ADVANTAGE ─── */
  .sd-direct {
    max-width: 1200px;
    margin: 0 auto;
    padding: 80px 80px 0;
    text-align: center;
  }
  .sd-direct-title {
    font-family: 'Gilda Display', serif;
    font-style: italic;
    font-size: clamp(22px, 2.5vw, 30px);
    font-weight: 400;
    color: #1C1917;
    margin-bottom: 48px;
  }
  .sd-direct-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 48px;
    text-align: left;
  }
  .sd-direct-item {
    padding-top: 24px;
    border-top: 1px solid #E2D9CC;
  }
  .sd-direct-heading {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #1C1917;
    margin-bottom: 12px;
  }
  .sd-direct-desc {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 14px;
    line-height: 1.7;
    color: #6B6256;
    margin: 0;
  }
  .sd-direct-value {
    font-style: italic;
    opacity: 0.75;
  }

  /* ─── CTA ─── */
  .sd-cta {
    padding: 80px;
    text-align: center;
    border-bottom: 1px solid #E2D9CC;
  }
  .sd-cta p {
    font-family: 'Gilda Display', serif;
    font-style: italic;
    font-size: clamp(20px, 2.5vw, 28px);
    color: #3D3530;
    margin-bottom: 32px;
  }
  .sd-cta-btn {
    display: inline-block;
    font-family: 'Didact Gothic', sans-serif;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    color: #FAF8F3;
    background: #9e5c4a;
    padding: 16px 36px;
    transition: opacity 0.2s;
  }
  .sd-cta-btn:hover {
    opacity: 0.85;
  }

  /* ─── EXPLORE OTHER SUITES ─── */
  .sd-explore {
    max-width: 1200px;
    margin: 0 auto;
    padding: 80px;
  }
  .sd-explore h2 {
    font-family: 'Gilda Display', serif;
    font-size: clamp(24px, 3vw, 36px);
    font-weight: 400;
    color: #1C1917;
    margin-bottom: 48px;
  }
  .sd-explore-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 32px;
  }
  .sd-explore-card {
    text-decoration: none;
    color: inherit;
  }
  .sd-explore-img {
    aspect-ratio: 4/3;
    overflow: hidden;
    margin-bottom: 16px;
  }
  .sd-explore-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }
  .sd-explore-card:hover .sd-explore-img img {
    transform: scale(1.04);
  }
  .sd-explore-name {
    font-family: 'Gilda Display', serif;
    font-style: italic;
    font-size: 18px;
    color: #1C1917;
  }

  /* ─── RESPONSIVE ─── */
  @media (max-width: 900px) {
    .sd-hero-content {
      padding: 0 24px 48px;
    }
    .sd-intro-inner {
      grid-template-columns: 1fr;
      padding: 48px 24px;
      gap: 32px;
    }
    .sd-narrative-inner {
      grid-template-columns: 1fr;
      padding: 48px 24px;
      gap: 40px;
    }
    .sd-gallery {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
    }
    .sd-gallery-item-1,
    .sd-gallery-item-2,
    .sd-gallery-item-3,
    .sd-gallery-item-4,
    .sd-gallery-item-5 {
      grid-column: 1;
      grid-row: auto;
      aspect-ratio: 4/3;
    }
    .sd-lightbox-prev,
    .sd-lightbox-next {
      font-size: 32px;
      padding: 12px;
    }
    .sd-lightbox-prev { left: 8px; }
    .sd-lightbox-next { right: 8px; }
    .sd-direct {
      padding: 48px 24px 0;
    }
    .sd-direct-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .sd-cta {
      padding: 48px 24px;
    }
    .sd-explore {
      padding: 48px 24px;
    }
    .sd-amenities ul {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  (function () {
    const gallery = document.querySelector('.sd-gallery');
    if (!gallery) return;

    const lightbox = document.getElementById('sd-lightbox');
    if (!lightbox) return;

    const lbImg = lightbox.querySelector('.sd-lightbox-img') as HTMLImageElement;
    const lbCounter = lightbox.querySelector('.sd-lightbox-counter')!;
    const items = Array.from(gallery.querySelectorAll('.sd-gallery-item img')) as HTMLImageElement[];
    let current = 0;

    function fullSrc(img: HTMLImageElement) {
      return img.getAttribute('src')!;
    }

    function show(index: number) {
      current = (index + items.length) % items.length;
      lbImg.classList.remove('is-loaded');
      lbImg.src = fullSrc(items[current]);
      lbImg.alt = items[current].alt;
      lbCounter.textContent = `${current + 1}\u2009/\u2009${items.length}`;
      preload((current + 1) % items.length);
      preload((current - 1 + items.length) % items.length);
    }

    function preload(index: number) {
      const img = new Image();
      img.src = fullSrc(items[index]);
    }

    function open(index: number) {
      show(index);
      lightbox.classList.add('is-active');
      lightbox.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function close() {
      lightbox.classList.remove('is-active');
      lightbox.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    items.forEach((img, i) => {
      img.closest('.sd-gallery-item')!.addEventListener('click', () => open(i));
    });

    lightbox.querySelector('.sd-lightbox-close')!.addEventListener('click', close);
    lightbox.querySelector('.sd-lightbox-backdrop')!.addEventListener('click', close);
    lightbox.querySelector('.sd-lightbox-prev')!.addEventListener('click', () => show(current - 1));
    lightbox.querySelector('.sd-lightbox-next')!.addEventListener('click', () => show(current + 1));

    lbImg.addEventListener('load', () => lbImg.classList.add('is-loaded'));

    document.addEventListener('keydown', (e) => {
      if (!lightbox.classList.contains('is-active')) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
    });

    let touchStartX = 0;
    lightbox.addEventListener('touchstart', (e) => {
      touchStartX = (e as TouchEvent).changedTouches[0].screenX;
    }, { passive: true });
    lightbox.addEventListener('touchend', (e) => {
      const diff = (e as TouchEvent).changedTouches[0].screenX - touchStartX;
      if (Math.abs(diff) > 50) {
        diff > 0 ? show(current - 1) : show(current + 1);
      }
    }, { passive: true });
  })();
</script>
