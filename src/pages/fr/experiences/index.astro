---
import Layout from '../../../layouts/Layout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import { heroSrcset } from '../../../utils/images';

const refList = [
  'La pétanque',
  'La baignade à 7h',
  'Le vélo dans la vallée du Loup',
  "L'apéritif du vendredi — avec les artistes",
  'La conversation sur les œuvres',
  'Fondation Maeght en Fondation CAB',
  'Le marché, avec un panier',
  "Le massage d'Amadine",
  'Le tour des galeries',
  'Les routes que personne ne prend',
];
---

<Layout
  locale="fr"
  title="Expériences | Toile Blanche | Saint-Paul de Vence"
  description="Œuvres disponibles pendant votre séjour — des piscines à la Fondation Maeght, et le plaisir de n'en faire aucun."
  ogImage="https://www.toileblanche.com/assets/images/og-experiences.jpg"
>
  <Nav locale="fr" theme="both" />

  <section class="exp-ref-hero">
    <div class="exp-ref-hero-image">
      <img src="/assets/images/slideshow5.jpg" srcset={heroSrcset('/assets/images/slideshow5.jpg')} sizes="100vw" width="4897" height="3267" alt="Le domaine de Toile Blanche" loading="eager" fetchpriority="high" />
    </div>
  </section>

  <main id="main-content">
    <section class="exp-ref-list">
      <h2 class="exp-ref-title">Œuvres disponibles pendant votre séjour</h2>
      <div class="exp-ref-items">
        {refList.map((line) => (
          <p class="exp-ref-line">{line}</p>
        ))}
        <p class="exp-ref-line exp-ref-line--final">Et le plaisir particulier de n'en faire aucun.</p>
      </div>
      <p class="exp-ref-note">La réception peut tout organiser. Ou écrivez-nous avant votre arrivée.</p>
    </section>
  </main>

  <Footer locale="fr" />
</Layout>

<style>
  .exp-ref-hero {
    position: relative;
    width: 100%;
    aspect-ratio: 4897 / 3267;
    min-height: 60vh;
    overflow: hidden;
  }
  .exp-ref-hero-image {
    position: absolute;
    inset: 0;
  }
  .exp-ref-hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .exp-ref-list {
    margin: 0 auto;
    padding: clamp(80px, 12vw, 140px) 30%;
    text-align: center;
  }
  .exp-ref-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(22px, 2.2vw, 30px);
    font-weight: 400;
    color: var(--color-ink-mid);
    margin-bottom: clamp(48px, 6vw, 72px);
    letter-spacing: 0.02em;
  }
  .exp-ref-items {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(20px, 2vw, 24px);
    font-weight: 400;
    line-height: 1.4;
    color: var(--color-ink-deep);
  }
  .exp-ref-line {
    margin: 0 0 2.5em 0;
  }
  .exp-ref-line--final {
    margin-top: 0.5em;
    margin-bottom: 0;
    font-style: italic;
  }
  .exp-ref-note {
    margin-top: clamp(72px, 10vw, 120px);
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(16px, 1.5vw, 18px);
    font-style: italic;
    line-height: 1.6;
    color: var(--color-ink-mid);
  }

  @media (max-width: 900px) {
    .exp-ref-hero {
      min-height: 50vh;
    }
    .exp-ref-list {
      padding: 60px 24px; /* wide margins only on desktop */
    }
  }
</style>
