---
import NavMenu from './NavMenu.astro';
export interface Props {
  theme?: 'dark' | 'light' | 'both';
}
const { theme = 'both' } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!-- Dark Navigation (used on hero pages with video/dark bg) -->
{(theme === 'dark' || theme === 'both') && (
  <nav class="navigation-dark" id="nav-dark">
    <div class="navigation-bar dark">
      <div class="nav-container">
        <a href="/" class={`nav-logo w-nav-brand${currentPath === '/' ? ' w--current' : ''}`} aria-current={currentPath === '/' ? 'page' : undefined}>
          <img src="/assets/images/63a19dacd6b229843a52a138_Toile%20Blanche%20Logo%202022%20black.avif" loading="lazy" alt="Toile Blanche Logo" class="nav-logo mobile-none" />
          <img src="/assets/images/63a19dacd6b229843a52a138_Toile%20Blanche%20Logo%202022%20black.avif" loading="eager" alt="Toile Blanche Logo" class="nav-logo mobile-only" />
        </a>
        <div class="nav-buttons">
          <div class="book-button">
            <a href="#" class="nav-link-dark distributor-open">Book my Stay</a>
          </div>
          <button class="menu-button w-inline-block js-menu-toggle" aria-label="Toggle menu" aria-expanded="false">
            <div class="menu-icon-wrap">
              <span class="menu-bar top"></span>
              <span class="menu-bar middle"></span>
              <span class="menu-bar bottom"></span>
            </div>
          </button>
        </div>
      </div>
    </div>

    <div class="nav-links-container tb-fullpage-menu dark js-nav-links" hidden>
      <NavMenu currentPath={currentPath} />
    </div>
  </nav>
)}

<!-- Light Navigation (used on non-hero / scroll-triggered) -->
{(theme === 'light' || theme === 'both') && (
  <nav class="navigation-light" id="nav-light">
    <div class="navigation-bar">
      <div class="nav-container">
        <a href="/" class={`nav-logo w-nav-brand${currentPath === '/' ? ' w--current' : ''}`} aria-current={currentPath === '/' ? 'page' : undefined}>
          <img src="/assets/images/63a19dac0c5c8e779178fddf_Toile%20Blanche%20Logo%202022%20light.webp" loading="lazy" alt="Toile Blanche Logo" class="logo-light mobile-none" />
          <img src="/assets/images/63a19dac0c5c8e779178fddf_Toile%20Blanche%20Logo%202022%20light.webp" loading="eager" alt="Toile Blanche Logo" class="logo-light mobile-only" />
        </a>
        <div class="nav-buttons">
          <div class="book-button">
            <a href="#" class="nav-link-light distributor-open">Book my Stay</a>
          </div>
          <button class="menu-button w-inline-block js-menu-toggle" aria-label="Toggle menu" aria-expanded="false">
            <div class="menu-icon-wrap">
              <span class="menu-bar top"></span>
              <span class="menu-bar middle"></span>
              <span class="menu-bar bottom"></span>
            </div>
          </button>
        </div>
      </div>
    </div>

    <div class="nav-links-container tb-fullpage-menu light js-nav-links" hidden>
      <NavMenu currentPath={currentPath} />
    </div>
  </nav>
)}
