---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
---

<Layout
  title="La Guinguette | Toile Blanche | Saint-Paul de Vence"
  description="The garden heart. Come barefoot or in espadrilles. Provence invites itself to your table."
>
  <Nav theme="both" ctaText="Book my Table" ctaHref="https://bookings.zenchef.com/results?rid=357953" />

  <main id="main-content">
    <!-- HERO -->
    <section class="lgn-hero">
      <div class="lgn-hero-image">
        <img src="/assets/images/page-img-7f72d09199a7a2.jpg" alt="La Guinguette de Toile Blanche" loading="eager" />
        <div class="lgn-hero-overlay"></div>
      </div>
      <div class="lgn-hero-content">
        <p class="lgn-hero-eyebrow">Lunch — May to October</p>
        <h1>La Guinguette</h1>
      </div>
    </section>

    <!-- TAGLINE -->
    <section class="lgn-tagline">
      <div class="lgn-tagline-inner">
        <p>The garden heart. Come barefoot or in espadrilles. Provence invites itself to your table.</p>
      </div>
    </section>

    <!-- NARRATIVE + DETAILS -->
    <section class="lgn-narrative">
      <div class="lgn-narrative-inner">
        <div class="lgn-narrative-text">
          <h2>The Garden Table</h2>
          <p>La Guinguette is the soul of the summer at Toile Blanche. Set under the plane trees beside the pool, it is where lunch lasts as long as it should — somewhere between a proper meal and a long Provençal afternoon.</p>
          <p>The menu is designed for sharing. Dishes are ordered progressively and arrive when they are ready. There is no rush, no structure, no formality. Just the Mediterranean on a plate.</p>
          <h2>How It Works</h2>
          <p>The table is sharing-style. Order a few dishes for the centre, add as you go. Grilled fish, market vegetables, charcuterie, dips, flatbreads — the menu changes weekly depending on what the producers and the garden have to offer.</p>
          <p>Rosé is poured by the glass or the bottle. The wine selection favours the immediate surroundings: Bellet, Côtes de Provence, and the occasional natural oddity from a neighbour's vineyard.</p>
        </div>
        <div class="lgn-details">
          <p class="lgn-details-label">Practical</p>

          <div class="lgn-details-block">
            <h3>Season</h3>
            <p>Open May through October</p>
            <p>Weather permitting</p>
          </div>

          <div class="lgn-details-block">
            <h3>Hours</h3>
            <p>Lunch: 12:00 – 15:00</p>
            <p>Drinks & snacks: 15:00 – 18:00</p>
          </div>

          <div class="lgn-details-block">
            <h3>Reservation</h3>
            <p>Recommended, especially weekends.</p>
            <p>Open to hotel guests and external visitors.</p>
          </div>

          <div class="lgn-details-block lgn-details-cta">
            <a href="https://bookings.zenchef.com/results?rid=357953" target="_blank" rel="noopener noreferrer" class="lgn-btn">Reserve a Table</a>
          </div>

          <div class="lgn-details-block">
            <h3>Good to Know</h3>
            <p>Dishes are ordered progressively — no need to order everything at once.</p>
            <p>Sharing style. No individual plates unless requested.</p>
            <p>Barefoot welcome. Swimwear with a cover-up is fine.</p>
          </div>

          <div class="lgn-details-block">
            <h3>Location</h3>
            <p>Toile Blanche — Poolside Garden</p>
            <p>826, chemin de la Pounchounière</p>
            <p>06570 Saint-Paul de Vence</p>
            <p>France</p>
          </div>

          <div class="lgn-details-block">
            <h3>Contact</h3>
            <a href="tel:+33493327421" class="lgn-details-link">+33 4 93 32 74 21</a>
            <a href="mailto:guinguette@toileblanche.com" class="lgn-details-link">guinguette@toileblanche.com</a>
          </div>
        </div>
      </div>
    </section>

    <!-- GALLERY PAIR -->
    <section class="lgn-gallery">
      <div class="lgn-gallery-inner">
        <div class="lgn-gallery-tall">
          <img src="/assets/images/page-img-90d67bc14d6e33.webp" alt="Sharing plates at La Guinguette" loading="lazy" />
        </div>
        <div class="lgn-gallery-offset">
          <img src="/assets/images/page-img-0cb6a2524fa474.jpg" alt="Poolside dining at Toile Blanche" loading="lazy" />
        </div>
      </div>
    </section>

    <!-- SEASONAL MENU -->
    <section class="lgn-menu">
      <div class="lgn-menu-inner">
        <p class="lgn-menu-label">Current Season</p>
        <h2>The Summer Table</h2>
        <p class="lgn-menu-intro">The menu evolves weekly. These are the kinds of things you will find. Order a few to start, then keep going.</p>
        <div class="lgn-menu-grid">
          <div class="lgn-menu-col">
            <h3>To Share</h3>
            <p>Hummus, flatbread, za'atar, olive oil</p>
            <p>Burrata, peach, basil, aged balsamic</p>
            <p>Charcuterie board — local cured meats, cornichons, mustard</p>
            <p>Grilled octopus, chimichurri, lemon</p>
          </div>
          <div class="lgn-menu-col">
            <h3>From the Grill</h3>
            <p>Whole sea bream, herbs, garlic butter</p>
            <p>Lamb chops, rosemary, roasted peppers</p>
            <p>Grilled vegetable platter, romesco</p>
          </div>
          <div class="lgn-menu-col">
            <h3>To Finish</h3>
            <p>Fruit salad, fresh mint, sorbet</p>
            <p>Tarte tropézienne</p>
            <p>Espresso, digestif</p>
          </div>
        </div>
        <p class="lgn-menu-note">Menu changes weekly based on market availability. Dietary accommodations happily arranged — please let us know at reservation.</p>
      </div>
    </section>

    <!-- PHILOSOPHY -->
    <section class="lgn-quote">
      <div class="lgn-quote-inner">
        <h2>Lunch lasted three hours. Nobody noticed. The rosé was cold, the fish was whole, and the afternoon had no plans.</h2>
      </div>
    </section>

    <!-- CTA -->
    <section class="lgn-cta">
      <p>A table under the trees is waiting.</p>
      <a href="https://bookings.zenchef.com/results?rid=357953" target="_blank" rel="noopener noreferrer" class="lgn-cta-btn">Reserve a Table</a>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* ─── HERO ─── */
  .lgn-hero {
    position: relative;
    height: 85vh;
    min-height: 500px;
    overflow: hidden;
  }
  .lgn-hero-image {
    position: absolute;
    inset: 0;
  }
  .lgn-hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .lgn-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.5) 0%, transparent 55%);
  }
  .lgn-hero-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 0 80px 72px;
    color: #fff;
  }
  .lgn-hero-eyebrow {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    opacity: 0.8;
    margin-bottom: 16px;
  }
  .lgn-hero-content h1 {
    font-family: 'Gilda Display', serif;
    font-size: clamp(40px, 6vw, 80px);
    font-weight: 400;
    line-height: 1.05;
  }

  /* ─── TAGLINE ─── */
  .lgn-tagline {
    border-bottom: 1px solid #E2D9CC;
  }
  .lgn-tagline-inner {
    max-width: 800px;
    margin: 0 auto;
    padding: 64px 80px;
    text-align: center;
  }
  .lgn-tagline-inner p {
    font-family: 'Gilda Display', serif;
    font-style: italic;
    font-size: clamp(20px, 2.5vw, 28px);
    line-height: 1.55;
    color: #3D3530;
  }

  /* ─── NARRATIVE + DETAILS ─── */
  .lgn-narrative {
    border-bottom: 1px solid #E2D9CC;
  }
  .lgn-narrative-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 80px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: start;
  }
  .lgn-narrative-text h2 {
    font-family: 'Gilda Display', serif;
    font-size: clamp(24px, 3vw, 36px);
    font-weight: 400;
    margin-bottom: 24px;
    color: #1C1917;
  }
  .lgn-narrative-text h2:not(:first-child) {
    margin-top: 48px;
  }
  .lgn-narrative-text p {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 16px;
    line-height: 1.8;
    color: #3D3530;
    margin-bottom: 16px;
  }

  .lgn-details {
    padding: 48px;
    background: rgba(226, 217, 204, 0.15);
  }
  .lgn-details-label {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #9C9080;
    margin-bottom: 40px;
  }
  .lgn-details-block {
    margin-bottom: 32px;
    padding-bottom: 32px;
    border-bottom: 1px solid rgba(226, 217, 204, 0.5);
  }
  .lgn-details-block:last-child {
    margin-bottom: 0;
    padding-bottom: 0;
    border-bottom: none;
  }
  .lgn-details-block h3 {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 10px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #9C9080;
    margin-bottom: 12px;
  }
  .lgn-details-block p {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 14px;
    line-height: 1.7;
    color: #3D3530;
  }
  .lgn-details-link {
    display: block;
    font-family: 'Didact Gothic', sans-serif;
    font-size: 14px;
    color: #3D3530;
    text-decoration: none;
    line-height: 1.7;
    transition: color 0.2s;
  }
  .lgn-details-link:hover {
    color: #9e5c4a;
  }
  .lgn-details-cta {
    text-align: center;
    padding-top: 8px;
    padding-bottom: 40px;
  }
  .lgn-btn {
    display: inline-block;
    font-family: 'Didact Gothic', sans-serif;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    color: #FAF8F3;
    background: #9e5c4a;
    padding: 16px 36px;
    transition: opacity 0.2s;
  }
  .lgn-btn:hover {
    opacity: 0.85;
  }

  /* ─── GALLERY ─── */
  .lgn-gallery {
    border-bottom: 1px solid #E2D9CC;
  }
  .lgn-gallery-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 80px;
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 40px;
    align-items: start;
  }
  .lgn-gallery-tall img {
    width: 100%;
    aspect-ratio: 3/4;
    object-fit: cover;
    display: block;
  }
  .lgn-gallery-offset {
    padding-top: 120px;
  }
  .lgn-gallery-offset img {
    width: 100%;
    aspect-ratio: 4/5;
    object-fit: cover;
    display: block;
  }

  /* ─── SEASONAL MENU ─── */
  .lgn-menu {
    border-bottom: 1px solid #E2D9CC;
  }
  .lgn-menu-inner {
    max-width: 1000px;
    margin: 0 auto;
    padding: 80px;
  }
  .lgn-menu-label {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #9C9080;
    margin-bottom: 16px;
  }
  .lgn-menu-inner > h2 {
    font-family: 'Gilda Display', serif;
    font-size: clamp(28px, 3vw, 40px);
    font-weight: 400;
    color: #1C1917;
    margin-bottom: 20px;
  }
  .lgn-menu-intro {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 16px;
    line-height: 1.7;
    color: #6B6256;
    margin-bottom: 48px;
    max-width: 700px;
  }
  .lgn-menu-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 48px;
    margin-bottom: 40px;
  }
  .lgn-menu-col h3 {
    font-family: 'Gilda Display', serif;
    font-style: italic;
    font-size: 20px;
    color: #1C1917;
    margin-bottom: 20px;
    padding-bottom: 16px;
    border-bottom: 1px solid #E2D9CC;
  }
  .lgn-menu-col p {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 14px;
    line-height: 1.6;
    color: #3D3530;
    margin-bottom: 16px;
    padding-bottom: 16px;
    border-bottom: 1px solid rgba(226, 217, 204, 0.3);
  }
  .lgn-menu-col p:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }
  .lgn-menu-note {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 12px;
    color: #9C9080;
    font-style: italic;
  }

  /* ─── QUOTE ─── */
  .lgn-quote {
    border-bottom: 1px solid #E2D9CC;
  }
  .lgn-quote-inner {
    max-width: 900px;
    margin: 0 auto;
    padding: 96px 80px;
    text-align: center;
  }
  .lgn-quote-inner h2 {
    font-family: 'Gilda Display', serif;
    font-style: italic;
    font-size: clamp(24px, 3.5vw, 44px);
    font-weight: 400;
    line-height: 1.3;
    color: #1C1917;
  }

  /* ─── CTA ─── */
  .lgn-cta {
    padding: 80px;
    text-align: center;
    border-bottom: 1px solid #E2D9CC;
  }
  .lgn-cta p {
    font-family: 'Gilda Display', serif;
    font-style: italic;
    font-size: clamp(20px, 2.5vw, 28px);
    color: #3D3530;
    margin-bottom: 32px;
  }
  .lgn-cta-btn {
    display: inline-block;
    font-family: 'Didact Gothic', sans-serif;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    color: #FAF8F3;
    background: #9e5c4a;
    padding: 16px 36px;
    transition: opacity 0.2s;
  }
  .lgn-cta-btn:hover {
    opacity: 0.85;
  }

  /* ─── RESPONSIVE ─── */
  @media (max-width: 900px) {
    .lgn-hero-content {
      padding: 0 24px 48px;
    }
    .lgn-tagline-inner {
      padding: 48px 24px;
    }
    .lgn-narrative-inner {
      grid-template-columns: 1fr;
      padding: 48px 24px;
      gap: 40px;
    }
    .lgn-gallery-inner {
      grid-template-columns: 1fr;
      padding: 48px 24px;
      gap: 24px;
    }
    .lgn-gallery-offset {
      padding-top: 0;
    }
    .lgn-menu-inner {
      padding: 48px 24px;
    }
    .lgn-menu-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .lgn-quote-inner {
      padding: 64px 24px;
    }
    .lgn-cta {
      padding: 48px 24px;
    }
  }
</style>
