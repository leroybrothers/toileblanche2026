      </div>
    </section>

    <!-- PHILOSOPHY -->
    <section class="lgn-quote">
      <div class="lgn-quote-inner">
        <h2>Le déjeuner a duré trois heures. Personne ne s'en est rendu compte. Le rosé était frais, le poisson entier, et l'après-midi n'avait aucun programme.</h2>
      </div>
    </section>

    <!-- CTA -->
    <section class="lgn-cta">
      <p>Une table sous les arbres vous attend.</p>
      <a href="https://bookings.zenchef.com/results?rid=375927&pid=1001&lang=fr" target="_blank" rel="noopener noreferrer" data-zc-action="open" class="lgn-cta-btn">Réserver une Table</a>
    </section>
  </main>

  <Footer locale="fr" />
</Layout>

<script>
  (function () {
    const trigger = document.getElementById('lgn-menu-trigger');
    const content = document.getElementById('lgn-menu-content');
    if (!trigger || !content) return;
    const expandText = trigger.querySelector('.lgn-menu-expand-text');
    const viewMenu = trigger.dataset.view || 'Voir la carte';
    const hideMenu = trigger.dataset.hide || 'Masquer la carte';

    trigger.addEventListener('click', function () {
      const expanded = trigger.getAttribute('aria-expanded') === 'true';
      trigger.setAttribute('aria-expanded', String(!expanded));
      content.setAttribute('data-expanded', String(!expanded));
      content.toggleAttribute('hidden', expanded);
      if (expandText) expandText.textContent = expanded ? viewMenu : hideMenu;
    });
  })();
</script>

