---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import suitesData from '../../data/suites.fr.json';

function cardBase(path: string) {
  return path.replace(/\.[^.]+$/, '');
}

function srcset(path: string, widths: number[]) {
  const ext = path.substring(path.lastIndexOf('.'));
  const base = path.substring(0, path.lastIndexOf('.'));
  return widths.map(w => `${base}-${w}w${ext} ${w}w`).join(', ') + `, ${path} ${widths[widths.length - 1]! * 2}w`;
}

const suites = suitesData.suites.map(s => ({
  href: `/fr/suites/${s.slug}`,
  image: s.images.card,
  base: cardBase(s.images.card),
  hasOptimized: s.images.card.includes('/Homepage/'),
  alt: s.images.cardAlt,
  title: s.name,
  description: s.tagline,
}));
---

<Layout
  locale="fr"
  title="Toile Blanche | Saint-Paul de Vence"
  description="22 suites, deux restaurants et une collection d'art contemporain à Saint-Paul de Vence. Une œuvre déclarée des Leroy Brothers sur la Côte d'Azur."
  ogImage="https://www.toileblanche.com/assets/images/parallax1.jpg"
  homeHeroPreload
>
  <div class="loader" id="page-loader">
    <div class="loader-logo-wrapper">
      <img src="/assets/images/63a19dacd6b229843a52a138_Toile%20Blanche%20Logo%202022%20black.avif" loading="lazy" alt="Toile Blanche" width="200" height="60" />
      <div class="loader-line"></div>
    </div>
  </div>

  <main id="main-content">
  <header class="hero1" id="hero" style="opacity:0">
    <div class="hero-bg-wrapper hero-bg-parallax">
      <div class="hero-bg-slide hero-bg-slide-1 is-active" role="img" aria-label="Piscine et transats à Toile Blanche, Saint-Paul de Vence"></div>
    </div>
    <div class="hero-bg-overlay"></div>

    <Nav theme="both" locale="fr" />
  </header>

  <!-- Hero tagline: editorial statement below the image -->
  <section class="tb-hero-tagline" aria-label="Tagline">
    <div class="container">
      <p class="tb-hero-tagline-line">La Côte d'Azur, sans le spectacle.</p>
      <p class="tb-hero-tagline-line">L'art n'est pas sur les murs, il est les murs.</p>
    </div>
  </section>

  <div class="section tb-intro-section">
    <div class="container">
      <div class="tb-intro-blocks">
        <div class="tb-intro-block fade-up">
          <h2 class="tb-intro-block-title">L'Histoire</h2>
          <p>Quand les trois frères Leroy et leurs familles arrivent à Saint-Paul-de-Vence en 2004, ils créent une première version de Toile Blanche. Pas encore un grand projet, mais une intuition, et un amour profond pour ce coin de colline.</p>
          <p>Au fil des vingt années suivantes, le rêve prend forme. Maison après maison, Toile Blanche s'agrandit, se précise, devient ce qu'il avait toujours voulu être.</p>
          <p>Le résultat échappe à toute catégorie.</p>
          <p>22 suites. Deux restaurants. Trois piscines. 20 000 m² de jardins. D'innombrables sculptures. Saint-Paul-de-Vence.</p>
        </div>
        <div class="tb-intro-block fade-up">
          <h2 class="tb-intro-block-title">Le Lieu</h2>
          <p>Les artistes Picasso, Chagall et Giacometti et tant d'autres ont laissé leurs empreintes sur le village. La Fondation Maeght fait rayonner leur œuvre. Toile Blanche perpétue cet héritage en soutenant des artistes émergents. Leurs œuvres sont exposées et mises en valeur dans notre galerie et nos jardins.</p>
          <p>L'eau de la piscine est chaude. Le rosé est frais. L'art invite à la contemplation, puis on retourne à la piscine.</p>
          <p>C'est là l'essentiel. Et le plaisir particulier de ne rien faire pendant quelques jours.</p>
        </div>
      </div>
    </div>
  </div>

  <div class="section tb-suites-section overlap-section-top">
    <div class="home-room-slider-wrapper fade-up">
      <div class="home-room-slider js-slider" id="suites-slider" role="region" aria-label="Galerie des suites">
        <button type="button" class="room-slider-arrow room-slider-left-arrow js-slider-prev" aria-label="Suite précédente">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <button type="button" class="room-slider-arrow room-slider-right-arrow js-slider-next" aria-label="Suite suivante">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
        </button>
        <div class="home-room-mask js-slider-track">
          {suites.map((suite, i) => (
            <div class={`home-room-single-slide js-slide${suite.href === '/fr/suites/mas-artiste' ? ' room-slide-masartiste' : ''}`} data-slide-index={i} role="group" aria-label={`${i + 1} sur ${suites.length}`}>
              <a href={suite.href} class="room-slide-wrapper w-inline-block">
                <div class="room-slide-image-wrapper">
                  <div class="room-slide-image-container">
                    {suite.hasOptimized ? (
                    <picture>
                      <source type="image/avif" srcset={`${suite.base}-400w.avif 400w, ${suite.base}-800w.avif 800w, ${suite.base}-1200w.avif 1200w, ${suite.base}-1800w.avif 1800w`} sizes="100vw" />
                      <source type="image/webp" srcset={`${suite.base}-400w.webp 400w, ${suite.base}-800w.webp 800w, ${suite.base}-1200w.webp 1200w, ${suite.base}-1800w.webp 1800w`} sizes="100vw" />
                      <img loading="lazy" alt={suite.alt} src={`${suite.base}-800w.jpg`} srcset={`${suite.base}-400w.jpg 400w, ${suite.base}-800w.jpg 800w, ${suite.base}-1200w.jpg 1200w, ${suite.base}-1800w.jpg 1800w`} sizes="100vw" class="room-slide-image" width="533" height="400" />
                    </picture>
                  ) : (
                    <img loading="lazy" alt={suite.alt} src={suite.image} srcset={srcset(suite.image, [400, 800, 1200])} sizes="100vw" class="room-slide-image" width="533" height="400" />
                  )}
                  </div>
                </div>
                <div class="room-slide-content-wrapper">
                  <div class="room-slide-title">
                    <h2 class="light">{suite.title}</h2>
                  </div>
                  <div class="room-slide-description">
                    <p class="light">{suite.description}</p>
                  </div>
                </div>
              </a>
            </div>
          ))}
        </div>
      </div>
      <div class="room-slider-dots" aria-label="Navigation des slides">
        {suites.map((_, i) => (
          <button type="button" class="room-slider-dot js-slider-dot" data-index={i} aria-label={`Aller au slide ${i + 1}`} aria-current={i === 0 ? 'true' : undefined} />
        ))}
      </div>
    </div>
    <div class="suites-view-all-link">
      <a href="/fr/suites" class="suites-view-all-btn">Voir toutes les suites</a>
    </div>
  </div>

  <!-- Full-width parallax: pool (slideshow1) -->
  <div class="section no-bottom-padding no-top-padding">
    <div class="homepage-parallax-pool" role="img" aria-label="Piscine et transats à Toile Blanche, Saint-Paul de Vence"></div>
  </div>

  <div class="section top-padding-192">
    <div class="container">
      <div class="tb-three-blocks">
        <div class="tb-feature-block fade-up">
          <div class="tb-feature-block-image">
            <a href="/fr/art" class="tb-feature-block-image-link">
              <picture>
                <source type="image/avif" srcset="/assets/images/677ce5a0ffdffd79d9f89e13_Aerts 6 (1)-p-1600-524w.avif 524w, /assets/images/677ce5a0ffdffd79d9f89e13_Aerts 6 (1)-p-1600-800w.avif 800w" sizes="(max-width: 767px) 100vw, 524px" />
                <source type="image/webp" srcset="/assets/images/677ce5a0ffdffd79d9f89e13_Aerts 6 (1)-p-1600-524w.webp 524w, /assets/images/677ce5a0ffdffd79d9f89e13_Aerts 6 (1)-p-1600-800w.webp 800w" sizes="(max-width: 767px) 100vw, 524px" />
                <img src="/assets/images/677ce5a0ffdffd79d9f89e13_Aerts 6 (1)-p-1600-524w.jpg" srcset="/assets/images/677ce5a0ffdffd79d9f89e13_Aerts 6 (1)-p-1600-524w.jpg 524w, /assets/images/677ce5a0ffdffd79d9f89e13_Aerts 6 (1)-p-1600-800w.jpg 800w" sizes="(max-width: 767px) 100vw, 524px" alt="Art contemporain à Toile Blanche" width="524" height="654" loading="lazy" />
              </picture>
            </a>
          </div>
          <div class="tb-feature-block-content">
            <h2>Art</h2>
            <p>Les œuvres présentées sont choisies avec soin. Chaque pièce est sélectionnée en concertation avec l'artiste. Certaines ont été créées spécialement pour le lieu.</p>
            <p>La collection est évolutive: peintures, sculptures, photographies et installations.</p>
            <p>En 2026, Toile Blanche est déclarée œuvre des frères Leroy.</p>
            <a href="/fr/art" class="button secondary w-button">Découvrir l'art</a>
          </div>
        </div>

        <div class="tb-feature-block tb-feature-block--reverse fade-up">
          <div class="tb-feature-block-image">
            <a href="/fr/restaurants" class="tb-feature-block-image-link">
              <picture>
                <source type="image/avif" srcset="/assets/images/restaurants-terrace-524w.avif 524w, /assets/images/restaurants-terrace-800w.avif 800w" sizes="(max-width: 767px) 100vw, 524px" />
                <source type="image/webp" srcset="/assets/images/restaurants-terrace-524w.webp 524w, /assets/images/restaurants-terrace-800w.webp 800w" sizes="(max-width: 767px) 100vw, 524px" />
                <img src="/assets/images/restaurants-terrace-524w.jpg" srcset="/assets/images/restaurants-terrace-524w.jpg 524w, /assets/images/restaurants-terrace-800w.jpg 800w" sizes="(max-width: 767px) 100vw, 524px" alt="Terrasse du restaurant à Toile Blanche, Le Restaurant et La Guinguette" width="524" height="656" loading="lazy" />
              </picture>
            </a>
          </div>
          <div class="tb-feature-block-content">
            <h2>Deux tables qui valent le détour</h2>
            <p>La Guinguette, un déjeuner à l'ombre des arbres. Rosé, poisson grillé, mets provençaux à partager.</p>
            <p>Le Restaurant pour le soir. Raffiné, intime. L'été en terrasse.</p>
            <p>Venez pieds nus si vous voulez. Le Sud fera le reste.</p>
            <a href="/fr/restaurants" class="button secondary w-button">Réserver une table</a>
          </div>
        </div>

        <div class="tb-feature-block fade-up">
          <div class="tb-feature-block-image">
            <a href="/fr/la-vie-ici" class="tb-feature-block-image-link">
              <picture>
                <source type="image/avif" srcset="/assets/images/Experiences-524w.avif 524w, /assets/images/Experiences-800w.avif 800w" sizes="(max-width: 767px) 100vw, 524px" />
                <source type="image/webp" srcset="/assets/images/Experiences-524w.webp 524w, /assets/images/Experiences-800w.webp 800w" sizes="(max-width: 767px) 100vw, 524px" />
                <img src="/assets/images/Experiences-524w.jpg" srcset="/assets/images/Experiences-524w.jpg 524w, /assets/images/Experiences-800w.jpg 800w" sizes="(max-width: 767px) 100vw, 524px" alt="Expériences à Toile Blanche" width="524" height="656" loading="lazy" />
              </picture>
            </a>
          </div>
          <div class="tb-feature-block-content">
            <h2>La vie à Toile Blanche</h2>
            <p>Saint-Paul-de-Vence est à vingt minutes à pied. La Fondation Maeght à cinq en voiture. Visites d'ateliers, Route des Arts, vallée à vélo.</p>
            <p>Et par-dessus tout, le charme désuet de ne rien faire.</p>
            <a href="/fr/la-vie-ici" class="button secondary w-button">La Vie Ici</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="section no-bottom-padding no-top-padding">
    <div class="full-frame-image-wrapper homepage-one"></div>
  </div>

  <!-- Avantage Réservation Directe -->
  <section class="tb-direct-privilege">
    <h2 class="tb-dp-headline">Réservez à la Source.</h2>
    <p class="tb-dp-intro">Réservez votre séjour directement auprès de Toile Blanche pour une expérience plus personnelle et les meilleures conditions.</p>
    <div class="tb-dp-grid">
      <div class="tb-dp-item">
        <p class="tb-dp-label">Le Meilleur Tarif Garanti</p>
        <p class="tb-dp-desc">Le tarif le plus avantageux ne se trouve qu'ici.</p>
      </div>
      <div class="tb-dp-item">
        <p class="tb-dp-label">Priorité au Surclassement</p>
        <p class="tb-dp-desc">Nos clients directs sont prioritaires pour les surclassements de suite.</p>
      </div>
      <div class="tb-dp-item">
        <p class="tb-dp-label">Réservez direct</p>
        <p class="tb-dp-desc">Les mêmes conditions qu'ailleurs. Sauf que vous parlez directement avec nous. Pas de frais cachés. Et quelqu'un qui connaît vraiment Toile Blanche au bout du fil.</p>
      </div>
    </div>
    <div class="tb-dp-cta-wrap">
      <a href="#" class="tb-dp-cta distributor-open">Réserver Ma Suite</a>
    </div>
  </section>

  <div class="section padding-96 bg-color-2">
    <div class="container">
      <div class="tb-newsletter">
        <div class="tb-newsletter-content">
          <h2 class="tb-newsletter-title">Un chez-soi loin de chez soi, pour ceux qui possèdent des demeures exceptionnelles. Restez en contact.</h2>
          <p class="tb-newsletter-desc">Pas trop souvent. Juste assez. Une note occasionnelle depuis Saint-Paul-de-Vence, les nouvelles arrivées dans la collection, ce qui est à table cette saison, et ce qu'il vaut la peine de savoir avant d'arriver.</p>
          <p class="tb-newsletter-cta">Rejoignez les 4500 personnes qui le savent déjà.</p>
        </div>
        <div class="tb-newsletter-form-wrap">
          <form id="newsletter-form" class="tb-newsletter-form">
            <div class="tb-newsletter-row">
              <div class="tb-newsletter-field">
                <label for="nl-first">Prénom</label>
                <input id="nl-first" name="firstName" type="text" placeholder="Prénom" maxlength="256" required />
              </div>
              <div class="tb-newsletter-field">
                <label for="nl-last">Nom</label>
                <input id="nl-last" name="lastName" type="text" placeholder="Nom" maxlength="256" required />
              </div>
              <div class="tb-newsletter-field">
                <label for="nl-email">Adresse email</label>
                <input id="nl-email" name="email" type="email" placeholder="Adresse email" maxlength="256" required />
              </div>
              <button type="submit" class="tb-newsletter-submit">Rester en contact</button>
            </div>
          </form>
          <p class="tb-newsletter-msg tb-newsletter-success" aria-live="polite">Merci. Vous êtes inscrit(e).</p>
          <p class="tb-newsletter-msg tb-newsletter-error" aria-live="polite">Une erreur est survenue. Veuillez réessayer.</p>
          <p class="tb-newsletter-legal">En vous abonnant au Journal Toile Blanche, vous acceptez notre <a href="/fr/privacy-policy">politique de confidentialité</a></p>
        </div>
      </div>
    </div>
  </div>

  <div class="divider _96px"></div>

  <Footer locale="fr" />
  </main>
</Layout>

<script is:inline>
(function () {
  var form = document.getElementById('newsletter-form');
  if (!form) return;

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    var wrap = form.closest('.tb-newsletter-form-wrap');
    var btn = form.querySelector('.tb-newsletter-submit');
    var data = new FormData(form);

    wrap.classList.remove('is-error');
    btn.classList.add('is-sending');
    btn.textContent = '…';

    fetch('/api/newsletter', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        email: data.get('email'),
        firstName: data.get('firstName'),
        lastName: data.get('lastName')
      })
    })
      .then(function (res) {
        if (!res.ok) throw new Error(res.status);
        wrap.classList.add('is-success');
      })
      .catch(function () {
        wrap.classList.add('is-error');
        btn.classList.remove('is-sending');
        btn.textContent = 'Rester en contact';
      });
  });
})();
</script>
