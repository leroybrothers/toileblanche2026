---
import NavMenu from './NavMenu.astro';
import { useTranslations, getLocaleFromPath, localePath, type Locale } from '../i18n/index';

export interface Props {
  theme?: 'dark' | 'light' | 'both';
  ctaText?: string;
  ctaHref?: string;
  ctaAction?: 'mews' | 'zenchef';
  zenchefRid?: string;
  zenchefPid?: string;
  locale?: Locale;
  showTableCta?: boolean;
  secondaryCtaText?: string;
  secondaryCtaHref?: string;
  secondaryCtaAction?: 'zenchef';
  secondaryZenchefRid?: string;
  secondaryZenchefPid?: string;
}

const currentPath = Astro.url.pathname;
const locale = Astro.props.locale ?? getLocaleFromPath(currentPath);
const t = useTranslations(locale);
const {
  theme = 'both',
  ctaText = t.nav.bookStay,
  ctaHref,
  ctaAction,
  zenchefRid = '357953',
  zenchefPid,
  showTableCta = false,
  secondaryCtaText,
  secondaryCtaHref,
  secondaryCtaAction,
  secondaryZenchefRid,
  secondaryZenchefPid,
} = Astro.props;
const ctaIsLink = !!ctaHref && ctaAction !== 'zenchef';
const restaurantsPath = localePath('/restaurants', locale);
const zenchefBookingUrl = (rid: string, pid?: string) =>
  pid
    ? `https://bookings.zenchef.com/results?rid=${rid}&pid=${pid}&lang=${locale}`
    : `https://bookings.zenchef.com/results?rid=${rid}&lang=${locale}`;
const zenchefUrl = zenchefBookingUrl(zenchefRid, zenchefPid);
const secondaryZenchefUrl =
  secondaryCtaAction === 'zenchef' && secondaryZenchefRid
    ? zenchefBookingUrl(secondaryZenchefRid, secondaryZenchefPid)
    : secondaryCtaHref;
const homePath = localePath('/', locale);
const altLocale: Locale = locale === 'en' ? 'fr' : 'en';
const altPath = locale === 'en' ? `/fr${currentPath}` : currentPath.replace(/^\/fr/, '') || '/';
---

<!-- Dark Navigation (used on hero pages with video/dark bg) -->
{(theme === 'dark' || theme === 'both') && (
  <nav class="navigation-dark" id="nav-dark">
    <div class="navigation-bar dark">
      <div class="nav-container">
        <div class="nav-left">
          <a href={altPath} class="tb-lang-switch" aria-label={altLocale === 'fr' ? 'Version française' : 'English version'}>{altLocale.toUpperCase()}</a>
        </div>
        <a href={homePath} class={`nav-logo w-nav-brand${currentPath === homePath ? ' w--current' : ''}`} aria-current={currentPath === homePath ? 'page' : undefined}>
          <img src="/assets/images/63a19dac0c5c8e779178fddf_Toile%20Blanche%20Logo%202022%20light.webp" alt="Toile Blanche" class="nav-logo-img" fetchpriority="high" />
          <span class="nav-logo-text">TOILE BLANCHE</span>
        </a>
        <div class="nav-right">
          <div class="book-button">
            {ctaIsLink ? (
              <a href={ctaHref} target="_blank" rel="noopener noreferrer" class="tb-book-cta tb-book-cta-link">{ctaText}</a>
            ) : ctaAction === 'zenchef' ? (
              <a href={zenchefUrl} target="_blank" rel="noopener noreferrer" data-zc-action="open" class="tb-book-cta">{ctaText}</a>
            ) : (
              <button type="button" class="distributor-open tb-book-cta">{ctaText}</button>
            )}
            {showTableCta && (
              <a href={restaurantsPath} class="tb-book-cta tb-book-cta-link">{t.nav.bookTable}</a>
            )}
            {secondaryCtaText && secondaryZenchefUrl && (
              secondaryCtaAction === 'zenchef' ? (
                <a href={secondaryZenchefUrl} target="_blank" rel="noopener noreferrer" data-zc-action="open" class="tb-book-cta">{secondaryCtaText}</a>
              ) : (
                <a href={secondaryZenchefUrl} target="_blank" rel="noopener noreferrer" class="tb-book-cta tb-book-cta-link">{secondaryCtaText}</a>
              )
            )}
          </div>
          <button class="menu-button w-inline-block js-menu-toggle" aria-label={t.nav.toggleMenu} aria-expanded="false">
            <div class="menu-icon-wrap">
              <span class="menu-bar top"></span>
              <span class="menu-bar middle"></span>
              <span class="menu-bar bottom"></span>
            </div>
          </button>
        </div>
      </div>
    </div>

    <div class="nav-links-container tb-fullpage-menu dark js-nav-links" hidden>
      <NavMenu
        currentPath={currentPath}
        ctaText={ctaText}
        ctaHref={ctaHref}
        ctaAction={ctaAction}
        zenchefRid={zenchefRid}
        zenchefPid={zenchefPid}
        secondaryCtaText={secondaryCtaText}
        secondaryCtaHref={secondaryCtaHref}
        secondaryCtaAction={secondaryCtaAction}
        secondaryZenchefRid={secondaryZenchefRid}
        secondaryZenchefPid={secondaryZenchefPid}
        locale={locale}
      />
    </div>
  </nav>
)}

<!-- Light Navigation (used on non-hero / scroll-triggered) -->
{(theme === 'light' || theme === 'both') && (
  <nav class="navigation-light" id="nav-light" style={theme === 'both' ? 'display:none' : undefined}>
    <div class="navigation-bar">
      <div class="nav-container">
        <div class="nav-left">
          <a href={altPath} class="tb-lang-switch" aria-label={altLocale === 'fr' ? 'Version française' : 'English version'}>{altLocale.toUpperCase()}</a>
        </div>
        <a href={homePath} class={`nav-logo w-nav-brand${currentPath === homePath ? ' w--current' : ''}`} aria-current={currentPath === homePath ? 'page' : undefined}>
          <img src="/assets/images/63a19dacd6b229843a52a138_Toile%20Blanche%20Logo%202022%20black.avif" alt="Toile Blanche" class="nav-logo-img nav-logo-img--light" fetchpriority="high" />
          <span class="nav-logo-text">TOILE BLANCHE</span>
        </a>
        <div class="nav-right">
          <div class="book-button">
            {ctaIsLink ? (
              <a href={ctaHref} target="_blank" rel="noopener noreferrer" class="tb-book-cta tb-book-cta-link">{ctaText}</a>
            ) : ctaAction === 'zenchef' ? (
              <a href={zenchefUrl} target="_blank" rel="noopener noreferrer" data-zc-action="open" class="tb-book-cta">{ctaText}</a>
            ) : (
              <button type="button" class="distributor-open tb-book-cta">{ctaText}</button>
            )}
            {showTableCta && (
              <a href={restaurantsPath} class="tb-book-cta tb-book-cta-link">{t.nav.bookTable}</a>
            )}
            {secondaryCtaText && secondaryZenchefUrl && (
              secondaryCtaAction === 'zenchef' ? (
                <a href={secondaryZenchefUrl} target="_blank" rel="noopener noreferrer" data-zc-action="open" class="tb-book-cta">{secondaryCtaText}</a>
              ) : (
                <a href={secondaryZenchefUrl} target="_blank" rel="noopener noreferrer" class="tb-book-cta tb-book-cta-link">{secondaryCtaText}</a>
              )
            )}
          </div>
          <button class="menu-button w-inline-block js-menu-toggle" aria-label={t.nav.toggleMenu} aria-expanded="false">
            <div class="menu-icon-wrap">
              <span class="menu-bar top"></span>
              <span class="menu-bar middle"></span>
              <span class="menu-bar bottom"></span>
            </div>
          </button>
        </div>
      </div>
    </div>

    <div class="nav-links-container tb-fullpage-menu light js-nav-links" hidden>
      <NavMenu
        currentPath={currentPath}
        ctaText={ctaText}
        ctaHref={ctaHref}
        ctaAction={ctaAction}
        zenchefRid={zenchefRid}
        zenchefPid={zenchefPid}
        secondaryCtaText={secondaryCtaText}
        secondaryCtaHref={secondaryCtaHref}
        secondaryCtaAction={secondaryCtaAction}
        secondaryZenchefRid={secondaryZenchefRid}
        secondaryZenchefPid={secondaryZenchefPid}
        locale={locale}
      />
    </div>
  </nav>
)}
