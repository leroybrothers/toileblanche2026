---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { heroSrcset } from '../../utils/images';

const refList = [
  'La pétanque',
  'La baignade à 7h',
  'Le vélo dans la vallée du Loup',
  "L'apéritif du vendredi — avec les artistes",
  'La conversation sur les œuvres',
  'Fondation Maeght en Fondation CAB',
  'Le marché, avec un panier',
  "Le massage d'Amadine",
  'Le tour des galeries',
  'Les routes que personne ne prend',
];
---

<Layout
  title="Experiences | Toile Blanche | Saint-Paul de Vence"
  description="Works available during your stay — from the pools and the valley to Fondation Maeght and the pleasure of doing none of it."
  ogImage="https://www.toileblanche.com/assets/images/og-experiences.jpg"
>
  <Nav theme="both" />

  <section class="exp-ref-hero">
    <div class="exp-ref-hero-image">
      <img src="/assets/images/slideshow5.jpg" srcset={heroSrcset('/assets/images/slideshow5.jpg')} sizes="100vw" width="4897" height="3267" alt="The estate at Toile Blanche" loading="eager" fetchpriority="high" />
    </div>
  </section>

  <main id="main-content">
    <section class="exp-ref-list">
      <h2 class="exp-ref-title">Works Available During Your Stay</h2>
      <div class="exp-ref-items">
        {refList.map((line) => (
          <p class="exp-ref-line">{line}</p>
        ))}
        <p class="exp-ref-line exp-ref-line--final">Et le plaisir particulier de n'en faire aucun.</p>
      </div>
      <p class="exp-ref-note">Reception can arrange everything. Or write to us before you arrive.</p>
    </section>

    <section class="exp-cta">
      <h2 class="exp-cta-title">Stay inside the canvas</h2>
      <div class="exp-cta-links">
        <a href="/suites" class="exp-cta-primary">Explore the Suites</a>
        <a href="/upcoming-events" class="exp-cta-secondary">Upcoming Events</a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .exp-ref-hero {
    position: relative;
    width: 100%;
    aspect-ratio: 4897 / 3267;
    min-height: 60vh;
    overflow: hidden;
  }
  .exp-ref-hero-image {
    position: absolute;
    inset: 0;
  }
  .exp-ref-hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .exp-ref-list {
    max-width: 42rem;
    margin: 0 auto;
    padding: clamp(80px, 12vw, 140px) clamp(24px, 6vw, 80px);
  }
  .exp-ref-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(18px, 2vw, 22px);
    font-weight: 400;
    color: var(--color-ink-mid);
    margin-bottom: clamp(32px, 4vw, 48px);
    letter-spacing: 0.02em;
  }
  .exp-ref-items {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(22px, 2.5vw, 28px);
    font-weight: 400;
    line-height: 2;
    color: var(--color-ink-deep);
  }
  .exp-ref-line {
    margin: 0;
  }
  .exp-ref-line--final {
    margin-top: 1em;
    font-style: italic;
  }
  .exp-ref-note {
    margin-top: clamp(48px, 6vw, 72px);
    padding: 1.25rem 1.5rem;
    font-family: 'Didact Gothic', sans-serif;
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-ink-mid);
    background: var(--color-bg-warm);
    border: 1px solid var(--color-border);
    border-radius: 2px;
  }

  .exp-cta {
    text-align: center;
    padding: 120px 24px;
    border-top: 1px solid var(--color-border);
  }
  .exp-cta-title {
    font-family: 'Gilda Display', serif;
    font-size: clamp(28px, 3vw, 42px);
    font-weight: 400;
    font-style: italic;
    color: var(--color-ink-deep);
    margin-bottom: 32px;
  }
  .exp-cta-links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 32px;
    flex-wrap: wrap;
  }
  .exp-cta-primary {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 11px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    background: var(--color-terracotta-mid);
    color: #fff;
    text-decoration: none;
    padding: 16px 40px;
    transition: background 0.3s;
  }
  .exp-cta-primary:hover {
    background: var(--color-terracotta-deep);
  }
  .exp-cta-secondary {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 11px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-stone);
    text-decoration: none;
    border-bottom: 1px solid rgba(0,0,0,0.1);
    padding-bottom: 2px;
    transition: border-color 0.2s;
  }
  .exp-cta-secondary:hover {
    border-color: var(--color-ink-deep);
  }

  @media (max-width: 900px) {
    .exp-ref-hero {
      min-height: 50vh;
    }
    .exp-ref-list {
      padding: 60px 24px;
    }
    .exp-cta {
      padding: 80px 24px;
    }
  }
</style>
