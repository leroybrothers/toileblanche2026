---
/**
 * TOILE BLANCHE - SUITE PÉNARD
 * Layout: Monograph style (Villa La Coste reference)
 * Typography: Gilda Display (Serif) & Didact Gothic (Sans)
 */
import Layout from '../../../layouts/Layout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';

// DATA OBJECT
const suite = {
  name: "Suite Pénard",
  tagline: "French windows, a private patio, and morning light that arrives exactly on time.",
  description: "The right amount of everything. Pénard is the smallest of our categories, but it is perhaps the most precise. Built into the original stone structures, these suites are exercises in restraint and curated comfort.",
  specs: {
    count: "6 suites",
    size: "30m²",
    occupancy: "Up to 2 guests",
    view: "Garden view",
    features: "Private patio · Walk-in shower"
  },
  amenities: [
    "King size Tréca bed · Premium bedding",
    "Air conditioning",
    "Free WiFi",
    "Flat screen TV",
    "In-room safe",
    "Bean-to-cup coffee machine",
    "Curated minibar — full bottles of Côtes de Provence wine",
    "Les Grandes Vacances toiletries by Les Choses Simples",
    "Bluetooth audio system with in-ceiling speakers",
    "Private patio",
    "Walk-in shower"
  ]
};
---

<Layout title={`${suite.name} | Toile Blanche | Saint-Paul de Vence`}>
  <Nav />
  
  <main class="bg-[#F9F7F2] text-[#0A0A0A] min-h-screen pt-32 pb-24">
    <!-- Hero Section -->
    <section class="max-w-[1280px] mx-auto px-6 grid grid-cols-1 lg:grid-cols-12 gap-12 items-end mb-24">
      <div class="lg:col-span-7">
        <h2 class="font-didact uppercase tracking-[0.15em] text-xs mb-4 opacity-60">01 — {suite.specs.count}</h2>
        <h1 class="font-gilda text-5xl md:text-7xl mb-8 tracking-tight">{suite.name}</h1>
        <p class="font-gilda italic text-2xl md:text-3xl leading-relaxed max-w-2xl opacity-90">
          "{suite.tagline}"
        </p>
      </div>
      <div class="lg:col-span-5 border-l border-black/10 pl-8 pb-2">
        <div class="font-didact space-y-2 text-sm uppercase tracking-wider">
          <p>{suite.specs.size} · {suite.specs.occupancy}</p>
          <p>{suite.specs.view}</p>
          <p>{suite.specs.features}</p>
        </div>
      </div>
    </section>

    <!-- Imagery Gallery -->
    <section class="max-w-[1440px] mx-auto px-6 mb-32">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="aspect-[3/4] bg-neutral-100 overflow-hidden rounded-sm group relative">
          <img 
            src="/assets/images/suites/penard-1.jpg" 
            alt="Interior of Suite Pénard" 
            class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105"
            onerror="this.style.display='none'; this.parentElement.classList.add('flex','items-center','justify-center'); this.parentElement.innerHTML='<span class=\'font-didact text-xs opacity-20\'>Suite Interior Image</span>'"
          />
        </div>
        <div class="aspect-[3/4] bg-neutral-100 overflow-hidden rounded-sm group md:mt-24 relative">
          <img 
            src="/assets/images/suites/penard-2.jpg" 
            alt="Patio of Suite Pénard" 
            class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105"
            onerror="this.style.display='none'; this.parentElement.classList.add('flex','items-center','justify-center'); this.parentElement.innerHTML='<span class=\'font-didact text-xs opacity-20\'>Suite Patio Image</span>'"
          />
        </div>
      </div>
    </section>

    <!-- Detailed Narrative & Maxibar -->
    <section class="max-w-[1280px] mx-auto px-6 grid grid-cols-1 lg:grid-cols-12 gap-16 mb-32">
      <div class="lg:col-span-6">
        <h3 class="font-gilda text-3xl mb-8 text-[#AD5D47] tracking-tight">The Narrative</h3>
        <p class="font-didact text-lg leading-relaxed opacity-80 mb-8">
          {suite.description}
        </p>
        <p class="font-didact text-lg leading-relaxed opacity-80">
          The cabinet is stocked with full bottles rather than miniatures — Côtes de Provence rosé, white and red from local producers, champagne, regional provisions, and the Toile Blanche bonbons that guests tend to mention unprompted.
        </p>
      </div>
      
      <!-- Specifications & Amenities -->
      <div class="lg:col-span-6 bg-white/40 p-10 md:p-14 rounded-sm border border-black/5">
        <h3 class="font-didact uppercase tracking-[0.2em] text-[10px] mb-12 opacity-50">Specifications & Amenities</h3>
        <ul class="font-didact grid grid-cols-1 md:grid-cols-2 gap-y-5 gap-x-10 text-[13px] leading-snug">
          {suite.amenities.map(item => (
            <li class="border-b border-black/5 pb-2 opacity-80">{item}</li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Footer CTA -->
    <section class="max-w-[1280px] mx-auto px-6 text-center py-32 border-t border-black/5">
      <h4 class="font-gilda text-4xl mb-12 italic opacity-90 tracking-tight">Ready for a Pénéquet?</h4>
      <a 
        href="https://app.mews.com/distributor/150bd326-7c63-4a24-b668-abcf00c6bb22" 
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block bg-[#AD5D47] text-white font-didact uppercase tracking-[0.2em] px-14 py-6 text-xs hover:bg-[#964d3a] transition-all duration-300"
      >
        Book Suite Pénard
      </a>
    </section>
  </main>

  <Footer />
</Layout>

<style is:global>
  /* Ensure local fonts are defined - assuming Inter is a fallback for Didact if missing */
  .font-gilda { font-family: 'Gilda Display', serif; }
  .font-didact { font-family: 'Didact Gothic', sans-serif; }
</style>