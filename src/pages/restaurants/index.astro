---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { gallerySrcset } from '../../utils/images';
---

<Layout
  title="Restaurants | Toile Blanche | Saint-Paul de Vence"
  description="Two tables worth travelling for. Built around what is in season, what is local, and what is honest."
  ogImage="https://www.toileblanche.com/assets/images/restaurant/IMG_7598.jpg"
  hideBookingBar={true}
  loadZenchef={true}
>
  <Nav theme="both" ctaText="Book my Table" ctaAction="zenchef" />

  <main id="main-content">
    <!-- HERO -->
    <section class="rst-hero">
      <div class="rst-hero-image">
        <img src="/assets/images/restaurant/IMG_7598.jpg" srcset={gallerySrcset('/assets/images/restaurant/IMG_7598.jpg')} sizes="100vw" width="1024" height="768" alt="Dining at Toile Blanche" loading="eager" fetchpriority="high" />
        <div class="rst-hero-overlay"></div>
      </div>
      <div class="rst-hero-content">
        <p class="rst-hero-eyebrow">The Kitchen</p>
        <h1>Two Tables Worth<br />Travelling For</h1>
      </div>
    </section>

    <!-- TAGLINE -->
    <section class="rst-tagline">
      <div class="rst-tagline-inner">
        <p>Built around what is in season, what is local, and what is honest. The herb garden is twenty metres from the kitchen.</p>
      </div>
    </section>

    <!-- THE TWO VENUES -->
    <section class="rst-venues">
      <div class="rst-venues-inner">

        <!-- Le Restaurant -->
        <div class="rst-venue">
          <a href="/le-restaurant" class="rst-venue-image">
            <img src="/assets/images/page-img-14433f29c9500d.jpg" alt="Le Restaurant de Toile Blanche" width="1170" height="780" loading="lazy" />
          </a>
          <div class="rst-venue-content">
            <h2 id="rst-title-restaurant"><a href="/le-restaurant" class="rst-venue-title-link">Le Restaurant</a></h2>
            <p class="rst-venue-tagline">An ode to the Côte d'Azur. The Mediterranean tradition, more considered, more intimate.</p>
            <p class="rst-venue-desc">Fresh produce from local growers. Open year-round for dinner.</p>
            <div class="rst-venue-actions">
              <a href="/le-restaurant" class="rst-venue-link">Discover Le Restaurant &rarr;</a>
            </div>
          </div>
        </div>

        <!-- La Guinguette -->
        <div class="rst-venue">
          <a href="/la-guinguette" class="rst-venue-image">
            <img src="/assets/images/guinguette-hero.jpg" alt="La Guinguette de Toile Blanche" width="1024" height="768" loading="lazy" />
          </a>
          <div class="rst-venue-content">
            <h2 id="rst-title-guinguette"><a href="/la-guinguette" class="rst-venue-title-link">La Guinguette</a></h2>
            <p class="rst-venue-tagline">A convivial shared moment under the trees. Rosé, Provençal dishes to share.</p>
            <p class="rst-venue-desc">La Guinguette is the heart of the garden. The particular pleasure of a good table in Provence. The South will do the rest.</p>
            <div class="rst-venue-actions">
              <a href="/la-guinguette" class="rst-venue-link">Discover La Guinguette &rarr;</a>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- BREAKFAST -->
    <section class="rst-breakfast">
      <div class="rst-breakfast-inner">
        <a href="/breakfast" class="rst-breakfast-image">
          <img src="/assets/images/breakfast/breakfast-2026-03.png" sizes="(max-width: 900px) 100vw, 50vw" width="1170" height="1422" alt="Breakfast at Toile Blanche" loading="lazy"  />
        </a>
        <div class="rst-breakfast-content">
          <p class="rst-breakfast-eyebrow">Every Morning</p>
          <h2 id="rst-title-breakfast"><a href="/breakfast" class="rst-venue-title-link">Le Petit-Déjeuner</a></h2>
          <p class="rst-breakfast-tagline">The garden wakes up. The day begins, and it stays with you.</p>
          <p class="rst-breakfast-desc">Freshly pressed juice, coffee, croissants, bread from a local bakery, seasonal fruit, an egg as you like it, local honey, jams and cheeses.</p>
          <p class="rst-breakfast-desc">In the breakfast room or on the terrace.</p>
          <p class="rst-breakfast-hours">Served daily, 8:00 – 10:30</p>
          <a href="/breakfast" class="rst-venue-link">More about breakfast &rarr;</a>
        </div>
      </div>
    </section>

    <!-- PHILOSOPHY -->
    <section class="rst-philosophy">
      <div class="rst-philosophy-inner">
        <h2>The Table</h2>
        <p>Chefs Nicolas Leclair and sous Chef Melissa Giordano's kitchen reinvents itself with the rhythm of the seasons: early morning deliveries, herbs cut minutes before service, the day's catch. A celebration of the ingredient in its purest form.</p>
        <p>The wine list is a declaration of love for the region. It champions local producers, estates in Bellet, Bandol, Cassis, and the hills above Vence. Some bottles are available exclusively at Toile Blanche.</p>
      </div>
    </section>

    <!-- CTA -->
    <section class="rst-cta">
      <p>The table is set.</p>
    </section>
  </main>

  <Footer />
</Layout>

