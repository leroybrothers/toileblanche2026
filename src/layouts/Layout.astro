---
import { getLocaleFromPath, getAlternateUrls, type Locale } from '../i18n/index';
import BookingBar from '../components/BookingBar.astro';
import '../styles/site-overrides.css';

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  locale?: Locale;
  hideBookingBar?: boolean;
  /** When true, preloads first homepage slideshow frame at a size matching viewport (LCP). */
  homeHeroPreload?: boolean;
  /** When true, loads Zenchef SDK (restaurant booking). Omit on non-restaurant pages to avoid CORS errors. */
  loadZenchef?: boolean;
}

const currentPath = Astro.url.pathname;
const locale = Astro.props.locale ?? getLocaleFromPath(currentPath);

const DEFAULT_DESCRIPTION = "Twenty-two suites, two restaurants, and a contemporary art collection in Saint-Paul de Vence. A declared artwork on the Côte d'Azur by the Leroy Brothers.";
const descRaw = Astro.props.description;
const description = (typeof descRaw === 'string' && descRaw.trim().length > 0) ? descRaw.trim() : DEFAULT_DESCRIPTION;

const {
  title = "Toile Blanche | Suites & Restaurant",
  ogImage = "https://www.toileblanche.com/assets/images/63c833490a337a19059088b6_Toile%20Blanche%20video%202020%20(1)-poster-00001.jpg",
  canonicalURL = Astro.url.href,
  hideBookingBar = false,
  homeHeroPreload = false,
  loadZenchef = false,
} = Astro.props;

const GTM_ID = "GTM-52R8BBP";
const AXEPTIO_ID = "63ce737f6a87883d8a3d1f79";
const alternates = getAlternateUrls(currentPath);
---

<!DOCTYPE html>
<html lang={locale}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {homeHeroPreload && (
    <>
      <link rel="preload" as="image" href="/assets/images/slideshow1-800w.avif" type="image/avif" media="(max-width: 639px)" fetchpriority="high" />
      <link rel="preload" as="image" href="/assets/images/slideshow1-1200w.avif" type="image/avif" media="(min-width: 640px) and (max-width: 1279px)" fetchpriority="high" />
      <link rel="preload" as="image" href="/assets/images/slideshow1.avif" type="image/avif" media="(min-width: 1280px)" fetchpriority="high" />
    </>
  )}

  <!-- Open Graph -->
  <meta property="og:site_name" content="Toile Blanche" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:locale" content={locale === 'fr' ? 'fr_FR' : 'en_GB'} />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Canonical & Alternates -->
  <link rel="canonical" href={canonicalURL} />
  {alternates.map(alt => (
    <link rel="alternate" hreflang={alt.locale} href={alt.href} />
  ))}
  <link rel="alternate" hreflang="x-default" href={alternates.find(a => a.locale === 'en')?.href} />

  <!-- Favicon -->
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
  <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#FAF8F3" />

  <!-- Preconnect: max 4 origins (fonts, GTM, Axeptio). Zenchef omitted — loads async, not LCP-critical -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
  <link rel="preconnect" href="https://static.axept.io" crossorigin />
  <!-- Fonts: load async to avoid render blocking (display=swap already in URL) -->
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;1,400;1,500;1,600&family=Didact+Gothic&family=Gilda+Display&family=Heebo:wght@400&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
  <noscript><link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;1,400;1,500;1,600&family=Didact+Gothic&family=Gilda+Display&family=Heebo:wght@400&display=swap" rel="stylesheet" /></noscript>

  <!-- Site Stylesheet (site-overrides imported above — Vite minifies in prod) -->
  <link rel="stylesheet" href="/css/tokens.css" />
  <link rel="stylesheet" href="/css/toile-blanche.min.css" />

  <!-- Restaurant/breakfast overrides (inline in Layout, IDs for max specificity) -->
  <style is:global>
    #rst-title-restaurant,
    #rst-title-guinguette,
    #rst-title-breakfast,
    #rst-title-restaurant a,
    #rst-title-guinguette a,
    #rst-title-breakfast a { font-size: clamp(36px, 4.5vw, 52px) !important; font-family: 'Gilda Display', Georgia, serif !important; font-weight: 400 !important; }
    .rst-breakfast-image-fixed { aspect-ratio: 2/1 !important; }
    .rst-breakfast-image-fixed img { width: 100% !important; height: 100% !important; object-fit: cover !important; object-position: center 35% !important; }
    .bkf-image { aspect-ratio: 2/1 !important; max-height: 320px !important; }
    .bkf-image img { height: 100% !important; object-fit: cover !important; object-position: center 40% !important; }
  </style>

  <!-- Google Site Verification -->
  <meta name="google-site-verification" content="ybV56V__njW0TIX5AEH_299IVdVUSQYtEk-I8KSaeQQ" />

  <!-- Consent Mode V2 -->
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    gtag('consent', 'default', {
      'analytics_storage': 'denied',
      'ad_storage': 'denied',
      'ad_user_data': 'denied',
      'ad_personalization': 'denied',
      'wait_for_update': 500
    });
  </script>

  <!-- Google Tag Manager: load on first scroll/click to reduce unused JS on initial load -->
  <script define:vars={{ GTM_ID }}>
    (function(w,d,s,l,i){
      var loaded = false;
      function loadGTM(){
        if (loaded) return;
        loaded = true;
        w[l]=w[l]||[];
        w[l].push({'gtm.start': new Date().getTime(), event:'gtm.js'});
        var f=d.getElementsByTagName(s)[0], j=d.createElement(s), dl=l!='dataLayer'?'&l='+l:'';
        j.async=true;
        j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;
        f.parentNode.insertBefore(j,f);
      }
      function onInteraction() {
        loadGTM();
        w.removeEventListener('scroll', onInteraction, true);
        w.removeEventListener('click', onInteraction, true);
        w.removeEventListener('keydown', onInteraction, true);
      }
      w.addEventListener('scroll', onInteraction, { passive: true, capture: true });
      w.addEventListener('click', onInteraction, true);
      w.addEventListener('keydown', onInteraction, true);
      setTimeout(loadGTM, 4000);
    })(window,document,'script','dataLayer', GTM_ID);
  </script>

  <!-- Axeptio Consent Manager: deferred 1.5s to reduce initial JS payload -->
  <script define:vars={{ AXEPTIO_ID, locale }}>
    window.axeptioSettings = {
      clientId: AXEPTIO_ID,
      cookiesVersion: locale === 'fr' ? 'toileblanche-fr' : 'toileblanche-en'
    };

    function loadAxeptio() {
      if (document.querySelector('script[src*="axept.io"]') || window.axeptio) return;
      var d = document, s = 'script', t = d.getElementsByTagName(s)[0], e = d.createElement(s);
      e.async = true;
      e.src = "https://static.axept.io/sdk.js";
      t.parentNode.insertBefore(e, t);

      void 0 === window._axcb && (window._axcb = []);
      window._axcb.push(function(axeptio) {
        axeptio.on("cookies:complete", function(choices) {
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag('consent', 'update', {
            'analytics_storage': choices.google_analytics ? 'granted' : 'denied',
            'ad_storage': choices.google_ads ? 'granted' : 'denied',
            'ad_user_data': choices.google_ads ? 'granted' : 'denied',
            'ad_personalization': choices.google_ads ? 'granted' : 'denied'
          });
        });
      });
    }
    setTimeout(loadAxeptio, 1500);
  </script>

  <!-- Mews Booking Engine: loaded on demand when user clicks Book (saves ~1.2MB initial payload) -->

  <!-- Schema.org Structured Data -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": ["Hotel", "ArtGallery"],
      "name": "Toile Blanche",
      "description": "22 suites, two restaurants, and a contemporary art collection in Saint-Paul de Vence. A declared artwork by the Leroy Brothers on the Côte d'Azur.",
      "image": "https://www.toileblanche.com/assets/images/63c833490a337a19059088b6_Toile%20Blanche%20video%202020%20(1)-poster-00001.jpg",
      "@id": "https://www.toileblanche.com#hotel",
      "url": "https://www.toileblanche.com",
      "telephone": "+33493327421",
      "email": "info@toileblanche.com",
      "priceRange": "€€€€",
      "starRating": {
        "@type": "Rating",
        "ratingValue": "4"
      },
      "numberOfRooms": 22,
      "checkinTime": "16:00",
      "checkoutTime": "11:00",
      "petsAllowed": false,
      "amenityFeature": [
        { "@type": "LocationFeatureSpecification", "name": "Free WiFi", "value": true },
        { "@type": "LocationFeatureSpecification", "name": "Free Parking", "value": true },
        { "@type": "LocationFeatureSpecification", "name": "Outdoor Pool", "value": true },
        { "@type": "LocationFeatureSpecification", "name": "Restaurant", "value": true },
        { "@type": "LocationFeatureSpecification", "name": "Air Conditioning", "value": true },
        { "@type": "LocationFeatureSpecification", "name": "EV Charging", "value": true },
        { "@type": "LocationFeatureSpecification", "name": "Spa Services", "value": true },
        { "@type": "LocationFeatureSpecification", "name": "Electric Bike Rental", "value": true }
      ],
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "826, chemin de la Pounchounière",
        "addressLocality": "Saint-Paul de Vence",
        "postalCode": "06570",
        "addressRegion": "Provence-Alpes-Côte d'Azur",
        "addressCountry": "FR"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 43.6874494,
        "longitude": 7.1285941
      },
      "openingHoursSpecification": {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],
        "opens": "08:00",
        "closes": "22:00"
      },
      "hasMap": "https://goo.gl/maps/VoKrme28X62qbvTk7",
      "sameAs": [
        "https://www.instagram.com/toileblanche/"
      ]
    }
  </script>
</head>
<body>
  <a href="#main-content" class="tb-skip-link">{locale === 'fr' ? 'Aller au contenu' : 'Skip to content'}</a>

  <!-- Google Tag Manager (noscript) -->
  <noscript>
    <iframe src={`https://www.googletagmanager.com/ns.html?id=${GTM_ID}`}
      height="0" width="0" style="display:none;visibility:hidden"></iframe>
  </noscript>

  <slot />

  {!hideBookingBar && <BookingBar locale={locale} />}

  <!-- Smooth scroll + scroll reveals: load on first scroll to avoid unused JS on initial load -->
  <script>
    (function() {
      var loaded = false;
      function load() {
        if (loaded) return;
        loaded = true;
        import('../scripts/smooth-scroll').then(function(m) { m.initSmoothScroll(); }).catch(function() {});
      }
      function onScroll() {
        load();
        window.removeEventListener('scroll', onScroll, { passive: true });
        window.removeEventListener('touchstart', onScroll, { passive: true });
      }
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('touchstart', onScroll, { passive: true });
      // Fallback: load after 6s if user hasn't scrolled (e.g. reading above fold)
      setTimeout(load, 6000);
    })();
  </script>
  <!-- Site JS -->
  <script src="/js/site.js?v=5" defer></script>

  <!-- Vercel Web Analytics -->
  <script>
    import { inject } from '@vercel/analytics';
    inject();
  </script>

  <!-- Vercel Speed Insights -->
  <script>
    import { injectSpeedInsights } from '@vercel/speed-insights';
    injectSpeedInsights();
  </script>

  {loadZenchef && (
    <script
      id="zc-sdk"
      data-restaurant="357953"
      data-hide-button="true"
      data-lang={locale}
      data-color="AD5D47"
      src="https://sdk.zenchef.com/sdk.js"
      async
    ></script>
  )}

  <!-- Mews Booking Engine: lazy-load on first hover/focus (saves ~1.2MB until user shows intent) -->
  <script is:inline>
    (function() {
      var mewsLoaded = false;
      var mewsInitialized = false;

      function loadAndInitMews() {
        if (mewsInitialized) return;
        if (!mewsLoaded) {
          mewsLoaded = true;
          var s = document.createElement('script');
          s.src = 'https://api.mews.com/distributor/distributor.min.js';
          s.onload = function() {
            Mews.Distributor({ configurationIds: ['150bd326-7c63-4a24-b668-abcf00c6bb22'], openElements: '.distributor-open' });
            mewsInitialized = true;
          };
          document.body.appendChild(s);
        }
      }

      // Preload on hover/focus so first click opens immediately (programmatic click is untrusted and fails)
      document.addEventListener('mouseover', function(e) {
        if (e.target.closest && e.target.closest('.distributor-open')) loadAndInitMews();
      }, true);
      document.addEventListener('focusin', function(e) {
        if (e.target.closest && e.target.closest('.distributor-open')) loadAndInitMews();
      }, true);
      document.addEventListener('touchstart', function(e) {
        if (e.target.closest && e.target.closest('.distributor-open')) loadAndInitMews();
      }, { passive: true, capture: true });

      // Fallback: if user clicks before hover (e.g. keyboard), load; user may need to click again
      document.addEventListener('click', function(e) {
        var target = e.target.closest('.distributor-open');
        if (!target) return;
        if (!mewsInitialized) {
          e.preventDefault();
          e.stopPropagation();
          loadAndInitMews();
        }
      }, true);

      // Broader preload: after 2s idle, or on first scroll, so keyboard/fast-click users often get it ready
      var preloadScheduled = false;
      function schedulePreload() {
        if (preloadScheduled || mewsLoaded) return;
        preloadScheduled = true;
        setTimeout(loadAndInitMews, 2000);
      }
      if ('requestIdleCallback' in window) {
        requestIdleCallback(schedulePreload, { timeout: 3000 });
      } else {
        setTimeout(schedulePreload, 2000);
      }
      window.addEventListener('scroll', function() { loadAndInitMews(); }, { passive: true, once: true });
    })();
  </script>
</body>
</html>
