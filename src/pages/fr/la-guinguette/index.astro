<style>
  /* ─── HERO ─── */
  .lgn-hero {
    position: relative;
    height: 85vh;
    min-height: 500px;
    overflow: hidden;
  }
  .lgn-hero-image {
    position: absolute;
    inset: 0;
  }
  .lgn-hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .lgn-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.5) 0%, transparent 55%);
  }
  .lgn-hero-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 0 80px 72px;
    color: #fff;
  }
  .lgn-hero-eyebrow {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    opacity: 0.8;
    margin-bottom: 16px;
    color: #fff;
  }
  .lgn-hero-content h1 {
    font-family: 'Gilda Display', serif;
    font-size: clamp(40px, 6vw, 80px);
    font-weight: 400;
    line-height: 1.05;
    color: #fff;
    margin-bottom: 16px;
  }
  .lgn-insta-ref {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: #fff;
    opacity: 0.55;
    transition: opacity 0.4s ease;
  }
  .lgn-insta-ref:hover {
    opacity: 1;
  }
  .lgn-insta-ref span {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 12px;
    letter-spacing: 0.12em;
    color: #fff !important;
  }

  /* ─── TAGLINE ─── */
  .lgn-tagline {
    border-bottom: 1px solid #E2D9CC;
  }
  .lgn-tagline-inner {
    max-width: 800px;
    margin: 0 auto;
    padding: 64px 80px;
    text-align: center;
  }
  .lgn-tagline-inner p {
    font-family: 'Gilda Display', serif;
