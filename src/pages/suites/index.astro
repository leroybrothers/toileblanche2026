---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const suites = [
  {
    slug: "penard",
    index: "01",
    name: "Suite Pénard",
    headline: "The right amount of everything.",
    description: "French windows, a private patio, and morning light that arrives exactly on time.",
    count: "6 suites",
    size: "30m²",
    guests: "2 guests",
    specs: "Garden view · Private patio · Walk-in shower",
    image: "/assets/images/page-img-eb795e7700a147.jpg",
    imageAlt: "Suite Pénard at Toile Blanche",
    hasPool: false,
  },
  {
    slug: "petanque",
    index: "02",
    name: "Suite Pétanque",
    headline: "Where the afternoon lasts longest.",
    description: "Named for the game played in the shade nearby. Forty square metres that feel considerably larger.",
    count: "4 suites",
    size: "40m²",
    guests: "2 guests",
    specs: "Garden view · Living area · Terrace with sun loungers · Walk-in shower",
    image: "/assets/images/page-img-833a78c568fe35.jpg",
    imageAlt: "Suite Pétanque at Toile Blanche",
    hasPool: false,
  },
  {
    slug: "bronzette",
    index: "03",
    name: "Suite de la Bronzette",
    headline: "Photographers come for the light. Guests stay for everything else.",
    description: "The name says it all. Fifty-five square metres, a spa bathroom, and a private terrace designed for serious sun.",
    count: "2 suites",
    size: "55m²",
    guests: "2 guests",
    specs: "Garden view · Spa bathroom · Bathtub · Large private terrace",
    image: "/assets/images/page-img-8626fb58027da5.jpg",
    imageAlt: "Suite de la Bronzette at Toile Blanche",
    hasPool: false,
    note: "Extra bed available — €80/night",
  },
  {
    slug: "cabanat",
    index: "04",
    name: "Suite Cabanat",
    headline: "Built into the slope. The only suite with a valley view.",
    description: "Built into the slope, which gives it something the others do not have — a valley view, and a sunbed cabana you will not want to leave.",
    count: "3 suites",
    size: "55m²",
    guests: "2 guests",
    specs: "Valley view · Split-level · Outdoor shower · Bathtub · Private garden · Sunbed cabana",
    image: "/assets/images/page-img-826f21859fa23e.jpg",
    imageAlt: "Suite Cabanat at Toile Blanche",
    hasPool: false,
  },
  {
    slug: "suite-artiste",
    index: "05",
    name: "Suite de l'Artiste",
    headline: "The oldest walls on the property.",
    description: "The 200-year-old farmhouse, with its original beams and stone, and a balcony that has been watching the same view for two centuries.",
    count: "2 suites",
    size: "60–70m²",
    guests: "2 guests",
    specs: "200-year-old farmhouse · Original stone and beams · Balcony · Bathtub",
    image: "/assets/images/page-img-e1708f1e9761a9.jpg",
    imageAlt: "Suite de l'Artiste at Toile Blanche",
    hasPool: false,
  },
  {
    slug: "mas-artiste",
    index: "06",
    name: "Mas de l'Artiste",
    headline: "The farmhouse, kept almost entirely for you.",
    description: "The largest suite in the farmhouse. Ninety square metres, a private Provençal courtyard, and room for the people you actually want to travel with.",
    count: "1 suite",
    size: "90m²",
    guests: "Up to 4 guests",
    specs: "200-year-old farmhouse · Maisonette · Private Provençal courtyard · Bathtub",
    image: "/assets/images/page-img-6106adc613aeb2.jpg",
    imageAlt: "Mas de l'Artiste at Toile Blanche",
    hasPool: false,
    note: "Extra bed available — €80/night",
  },
  {
    slug: "bonvivant",
    index: "07",
    name: "Suite du Bon-Vivant",
    headline: "A private pool and a terrace where the sunset is unreasonably good.",
    description: "A private pool, a terrace, and a sunset that arrives from the right direction at the right time of day. Some things are simply well arranged.",
    count: "2 suites",
    size: "55–60m²",
    guests: "2 guests",
    specs: "Private pool · Terrace · Bathtub",
    image: "/assets/images/page-img-707417a43d47ee.jpg",
    imageAlt: "Suite du Bon-Vivant at Toile Blanche",
    hasPool: true,
    note: "Extra bed available — €80/night",
  },
  {
    slug: "penequet",
    index: "08",
    name: "Villa du Pénéquet",
    headline: "Two floors, one pool, and the Provençal art of going nowhere.",
    description: "Pénéquet — the Provençal word for power-nap. Two floors, a private pool, and the particular art of doing absolutely nothing on purpose.",
    count: "2 villas",
    size: "80m²",
    guests: "2 guests",
    specs: "Private pool · Two floors · Garden view · Bathtub",
    image: "/assets/images/page-img-5f8a45f5b552ed.jpg",
    imageAlt: "Villa du Pénéquet at Toile Blanche",
    hasPool: true,
    note: "Extra bed available",
  },
]
---

<Layout
  title="Suites | Toile Blanche | Saint-Paul de Vence"
  description="Twenty-two suites across seven buildings in Saint-Paul de Vence. No two buildings the same. No two views identical."
  ogImage="/assets/images/suites/og-suites.jpg"
>
  <Nav theme="both" />

  <main>

    <!-- HERO -->
    <section class="suites-hero">
      <p class="eyebrow">Seven buildings · Saint-Paul de Vence</p>
      <h1>Twenty-two suites<br /><em>across seven buildings.</em></h1>
      <p class="hero-sub">No two buildings the same. No two views identical.</p>
    </section>

    <!-- SUITE CARDS -->
    <div class="suite-list">
      {suites.map((suite, i) => (
        <>
          {i === 4 && (
            <div class="interlude">
              <p>Three pools for everyone.<br /><em>Four more that are entirely yours.</em></p>
            </div>
          )}
          <article class={`suite-card ${i % 2 !== 0 ? 'reversed' : ''}`}>

            <a href={`/suites/${suite.slug}`} class="card-image">
              <img src={suite.image} alt={suite.imageAlt} loading="lazy" />
              {suite.hasPool && <span class="pool-tag">Private pool</span>}
            </a>

            <div class="card-body">
              <p class="card-meta">{suite.index} — {suite.count} · {suite.size} · {suite.guests}</p>
              <h2>{suite.name}</h2>
              <p class="card-headline">{suite.headline}</p>
              <p class="card-desc">{suite.description}</p>
              <p class="card-specs">{suite.specs}</p>
              {suite.note && <p class="card-note">{suite.note}</p>}
              <div class="card-actions">
                <a href={`/suites/${suite.slug}`} class="link-cta">Discover the suite →</a>
                <a href="https://app.mews.com/distributor/150bd326-7c63-4a24-b668-abcf00c6bb22" class="btn-book">Reserve</a>
              </div>
            </div>

          </article>
        </>
      ))}
    </div>

    <!-- PAGE CLOSE -->
    <div class="page-close">
      <p>Three pools for everyone.<br /><em>Four more that are entirely yours.</em></p>
      <a href="https://app.mews.com/distributor/150bd326-7c63-4a24-b668-abcf00c6bb22" class="btn-book">Book a suite</a>
    </div>

  </main>

  <Footer />

</Layout>

<style>

  /* ─────────────────────────────
     HERO
  ───────────────────────────── */
  .suites-hero {
    padding: 160px 80px 80px;
  }

  .eyebrow {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #9C9080;
    margin-bottom: 28px;
  }

  .suites-hero h1 {
    font-family: 'Gilda Display', serif;
    font-size: clamp(48px, 7vw, 88px);
    font-weight: 400;
    line-height: 1.0;
    color: #1C1917;
    margin-bottom: 28px;
  }

  .suites-hero h1 em {
    font-style: italic;
  }

  .hero-sub {
    font-family: 'Gilda Display', serif;
    font-size: 20px;
    font-style: italic;
    color: #6B6256;
    line-height: 1.5;
  }

  /* ─────────────────────────────
     SUITE LIST
  ───────────────────────────── */
  .suite-list {
    border-top: 1px solid #E2D9CC;
  }

  /* ─────────────────────────────
     SUITE CARD
  ───────────────────────────── */
  .suite-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-bottom: 1px solid #E2D9CC;
    min-height: 580px;
  }

  .suite-card.reversed .card-image { order: 2; }
  .suite-card.reversed .card-body  { order: 1; }

  /* Image */
  .card-image {
    display: block;
    position: relative;
    overflow: hidden;
    background: #D9D0C3;
    text-decoration: none;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.8s ease;
  }

  .suite-card:hover .card-image img {
    transform: scale(1.04);
  }

  .pool-tag {
    position: absolute;
    bottom: 24px;
    left: 24px;
    font-family: 'Didact Gothic', sans-serif;
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #FAF8F3;
    background: rgba(28, 25, 23, 0.5);
    backdrop-filter: blur(6px);
    padding: 8px 14px;
  }

  /* Body */
  .card-body {
    padding: 64px 72px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: #FAF8F3;
  }

  .card-meta {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #9C9080;
    margin-bottom: 20px;
  }

  .card-body h2 {
    font-family: 'Gilda Display', serif;
    font-size: clamp(32px, 3vw, 50px);
    font-weight: 400;
    line-height: 1.05;
    color: #1C1917;
    margin-bottom: 16px;
  }

  .card-headline {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #9C9080;
    margin-bottom: 20px;
  }

  .card-desc {
    font-family: 'Gilda Display', serif;
    font-size: 19px;
    font-style: italic;
    line-height: 1.65;
    color: #3D3530;
    margin-bottom: 28px;
    padding-bottom: 28px;
    border-bottom: 1px solid #E2D9CC;
  }

  .card-specs {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 11px;
    letter-spacing: 0.08em;
    color: #6B6256;
    line-height: 2;
    margin-bottom: 8px;
  }

  .card-note {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 11px;
    letter-spacing: 0.06em;
    color: #9C9080;
    font-style: italic;
    margin-bottom: 0;
  }

  /* Actions */
  .card-actions {
    display: flex;
    align-items: center;
    gap: 32px;
    margin-top: 40px;
  }

  .link-cta {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    color: #1C1917;
    border-bottom: 1px solid #1C1917;
    padding-bottom: 2px;
    transition: opacity 0.2s;
  }

  .link-cta:hover { opacity: 0.45; }

  .btn-book {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    color: #FAF8F3;
    background: #1C1917;
    padding: 13px 28px;
    transition: opacity 0.2s;
    display: inline-block;
  }

  .btn-book:hover { opacity: 0.7; }

  /* ─────────────────────────────
     INTERLUDE
  ───────────────────────────── */
  .interlude {
    background: #1C1917;
    padding: 100px 80px;
    text-align: center;
  }

  .interlude p {
    font-family: 'Gilda Display', serif;
    font-size: clamp(28px, 4.5vw, 60px);
    font-weight: 400;
    line-height: 1.3;
    color: #F5F0E8;
  }

  .interlude em {
    font-style: italic;
    color: #C4A882;
  }

  /* ─────────────────────────────
     PAGE CLOSE
  ───────────────────────────── */
  .page-close {
    padding: 100px 80px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 48px;
    border-top: 1px solid #E2D9CC;
  }

  .page-close p {
    font-family: 'Gilda Display', serif;
    font-size: clamp(24px, 3vw, 42px);
    color: #1C1917;
    line-height: 1.3;
  }

  .page-close em {
    font-style: italic;
  }

  /* ─────────────────────────────
     RESPONSIVE
  ───────────────────────────── */
  @media (max-width: 900px) {

    .suites-hero {
      padding: 120px 24px 60px;
    }

    .suite-card {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .suite-card.reversed .card-image { order: 0; }
    .suite-card.reversed .card-body  { order: 1; }

    .card-image { aspect-ratio: 4/3; }

    .card-body {
      padding: 40px 24px;
    }

    .interlude {
      padding: 64px 24px;
    }

    .page-close {
      flex-direction: column;
      align-items: flex-start;
      padding: 64px 24px;
    }
  }

</style>