---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { gallerySrcset } from '../../utils/images';
---

<Layout
  title="Events | Toile Blanche | Saint-Paul de Vence"
  description="Toile Blanche Sessions — Art, Gastronomy, and Music in Harmony. Exclusive moments where the Living Canvas becomes a stage."
>
  <Nav theme="light" />

  <main id="main-content">
    <!-- HEADER -->
    <section class="evt-header">
      <div class="evt-header-inner">
        <p class="evt-header-eyebrow">Culture — The Sessions</p>
        <h1>Toile Blanche<br />Sessions</h1>
        <p class="evt-header-tagline">Art, Gastronomy, and Music in Harmony. Exclusive moments where the Living Canvas becomes a stage.</p>
      </div>
    </section>

    <!-- GALLERY: 8-image grid centered -->
    <section class="evt-gallery">
      <div class="evt-gallery-inner">
        <div class="evt-gallery-grid">
          <div class="evt-gallery-cell">
            <img src="/assets/images/art/DSCF5047.JPG" srcset={gallerySrcset('/assets/images/art/DSCF5047.JPG')} sizes="(max-width: 900px) 50vw, 25vw" width="2080" height="3120" alt="Toile Blanche Sessions — live performance" loading="lazy" />
          </div>
          <div class="evt-gallery-cell">
            <img src="/assets/images/art/IMG_4383.jpg" srcset={gallerySrcset('/assets/images/art/IMG_4383.jpg')} sizes="(max-width: 900px) 50vw, 25vw" width="3024" height="4032" alt="Toile Blanche Sessions — art event" loading="lazy" />
          </div>
          <div class="evt-gallery-cell">
            <img src="/assets/images/art/IMG_4376.jpg" srcset={gallerySrcset('/assets/images/art/IMG_4376.jpg')} sizes="(max-width: 900px) 50vw, 25vw" width="3024" height="4032" alt="Toile Blanche Sessions — evening gathering" loading="lazy" />
          </div>
          <div class="evt-gallery-cell">
            <img src="/assets/images/art/DSCF4849.JPG" srcset={gallerySrcset('/assets/images/art/DSCF4849.JPG')} sizes="(max-width: 900px) 50vw, 25vw" width="4160" height="6240" alt="Toile Blanche Sessions — creative experience" loading="lazy" />
          </div>
          <!-- 4 placeholder cells — add images when ready -->
          <div class="evt-gallery-cell evt-gallery-placeholder"></div>
          <div class="evt-gallery-cell evt-gallery-placeholder"></div>
          <div class="evt-gallery-cell evt-gallery-placeholder"></div>
          <div class="evt-gallery-cell evt-gallery-placeholder"></div>
        </div>
      </div>
    </section>

    <!-- THE CONCEPT + CALENDAR LINK -->
    <section class="evt-concept">
      <div class="evt-concept-inner">
        <div class="evt-concept-text">
          <h2>The Sessions</h2>
          <p>Several times a year, we host the Toile Blanche Sessions. Each edition invites a visionary visual artist to create a captivating exhibition in our gallery or gardens. A guest chef collaborates with our kitchen to craft refined dishes, while a musician, DJ or band sets the mood with enchanting sounds.</p>
          <p class="evt-concept-quote">Join us in the afternoon at La Guinguette or the evening at Le Restaurant for a celebration of togetherness.</p>
        </div>
        <div class="evt-calendar">
          <p class="evt-calendar-label">Live Calendar</p>
          <h3>The Current Rota</h3>
          <p>Our full calendar of sessions, artist residencies, and exhibition openings is live and managed through our Contemporary Art ecosystem.</p>
          <a href="https://www.toileblanchecontemporary.com/events/" target="_blank" rel="noopener noreferrer" class="evt-calendar-btn">Explore Upcoming Dates &rarr;</a>
          <p class="evt-calendar-note">Opens toileblanchecontemporary.com</p>
        </div>
      </div>
    </section>

    <!-- PAST SESSIONS -->
    <section class="evt-past">
      <div class="evt-past-inner">
        <p class="evt-past-label">Past Sessions</p>
        <p class="evt-past-intro">Our full archive of sessions, residencies, and exhibitions — always up to date.</p>
        <a href="https://www.toileblanchecontemporary.com/events/" target="_blank" rel="noopener noreferrer" class="evt-past-btn">View the full events calendar &rarr;</a>
      </div>
    </section>

    <!-- PRIVATE TAKEOVERS -->
    <section class="evt-private">
      <div class="evt-private-inner">
        <h2>Your Own Session</h2>
        <p>The estate is available for private takeovers, intimate weddings, and curated creative retreats. Twenty-two suites, two restaurants, 20,000m² of gardens, and a team that knows how to make an evening disappear in the best possible way.</p>
        <a href="mailto:events@toileblanche.com?subject=Private%20Event%20Enquiry" class="evt-private-link">Enquire about private events &rarr;</a>
      </div>
    </section>

    <!-- CTA -->
    <section class="evt-cta">
      <p>The next session is being prepared.</p>
      <a href="https://www.toileblanchecontemporary.com/events/" target="_blank" rel="noopener noreferrer" class="evt-cta-btn">See What's Coming &rarr;</a>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* ─── HEADER ─── */
  .evt-header {
    padding: 200px 80px 80px;
    border-bottom: 1px solid #E2D9CC;
  }
  .evt-header-inner {
    max-width: 900px;
  }
  .evt-header-eyebrow {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #9C9080;
    margin-bottom: 32px;
  }
  .evt-header h1 {
    font-family: 'Gilda Display', serif;
    font-size: clamp(48px, 7vw, 96px);
    font-weight: 400;
    line-height: 1.05;
    color: #1C1917;
    margin-bottom: 40px;
  }
  .evt-header-tagline {
    font-family: 'Gilda Display', serif;
    font-style: italic;
    font-size: clamp(18px, 2vw, 24px);
    line-height: 1.55;
    color: #6B6256;
    max-width: 650px;
  }

  /* ─── GALLERY: 8-image grid centered ─── */
  .evt-gallery {
    border-bottom: 1px solid #E2D9CC;
  }
  .evt-gallery-inner {
    max-width: 1000px;
    margin: 0 auto;
    padding: 80px;
    display: flex;
    justify-content: center;
  }
  .evt-gallery-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
    min-height: 0;
  }
  .evt-gallery-cell {
    overflow: hidden;
    min-height: 0;
    aspect-ratio: 1/1;
  }
  .evt-gallery-cell img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.8s ease;
  }
  .evt-gallery-cell:hover img {
    transform: scale(1.03);
  }
  .evt-gallery-placeholder {
    background: rgba(226, 217, 204, 0.2);
  }

  /* ─── CONCEPT + CALENDAR ─── */
  .evt-concept {
    border-bottom: 1px solid #E2D9CC;
  }
  .evt-concept-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 80px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: start;
  }
  .evt-concept-text h2 {
    font-family: 'Gilda Display', serif;
    font-size: clamp(28px, 3vw, 40px);
    font-weight: 400;
    color: #1C1917;
    margin-bottom: 24px;
  }
  .evt-concept-text > p {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 16px;
    line-height: 1.8;
    color: #3D3530;
    margin-bottom: 24px;
  }
  .evt-concept-quote {
    font-family: 'Gilda Display', serif;
    font-style: italic;
    font-size: 18px;
    line-height: 1.6;
    color: #6B6256;
    padding-top: 24px;
    border-top: 1px solid #E2D9CC;
  }

  .evt-calendar {
    padding: 48px;
    background: rgba(226, 217, 204, 0.15);
    text-align: center;
  }
  .evt-calendar-label {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #9C9080;
    margin-bottom: 20px;
  }
  .evt-calendar h3 {
    font-family: 'Gilda Display', serif;
    font-style: italic;
    font-size: 28px;
    color: #1C1917;
    margin-bottom: 16px;
  }
  .evt-calendar > p {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 14px;
    line-height: 1.7;
    color: #6B6256;
    margin-bottom: 28px;
  }
  .evt-calendar-btn {
    display: inline-block;
    font-family: 'Didact Gothic', sans-serif;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    color: #FAF8F3;
    background: #9e5c4a;
    padding: 16px 36px;
    transition: opacity 0.2s;
    margin-bottom: 16px;
  }
  .evt-calendar-btn:hover {
    opacity: 0.85;
  }
  .evt-calendar-note {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #C4B9AA;
  }

  /* ─── PAST SESSIONS ─── */
  .evt-past {
    border-bottom: 1px solid #E2D9CC;
  }
  .evt-past-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 80px;
  }
  .evt-past-label {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #9C9080;
    margin-bottom: 16px;
  }
  .evt-past-intro {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 15px;
    line-height: 1.7;
    color: #6B6256;
    margin-bottom: 28px;
    max-width: 480px;
  }
  .evt-past-btn {
    display: inline-block;
    font-family: 'Didact Gothic', sans-serif;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    color: #FAF8F3;
    background: #9e5c4a;
    padding: 16px 36px;
    transition: opacity 0.2s;
  }
  .evt-past-btn:hover {
    opacity: 0.85;
  }

  /* ─── PRIVATE TAKEOVERS ─── */
  .evt-private {
    border-bottom: 1px solid #E2D9CC;
  }
  .evt-private-inner {
    max-width: 700px;
    margin: 0 auto;
    padding: 96px 80px;
    text-align: center;
  }
  .evt-private-inner h2 {
    font-family: 'Gilda Display', serif;
    font-style: italic;
    font-size: clamp(28px, 3.5vw, 44px);
    font-weight: 400;
    color: #1C1917;
    margin-bottom: 24px;
  }
  .evt-private-inner > p {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 16px;
    line-height: 1.8;
    color: #6B6256;
    margin-bottom: 32px;
  }
  .evt-private-link {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    color: #9e5c4a;
    border-bottom: 1px solid #9e5c4a;
    padding-bottom: 2px;
    transition: opacity 0.2s;
  }
  .evt-private-link:hover {
    opacity: 0.7;
  }

  /* ─── CTA ─── */
  .evt-cta {
    padding: 80px;
    text-align: center;
    border-bottom: 1px solid #E2D9CC;
  }
  .evt-cta p {
    font-family: 'Gilda Display', serif;
    font-style: italic;
    font-size: clamp(20px, 2.5vw, 28px);
    color: #3D3530;
    margin-bottom: 32px;
  }
  .evt-cta-btn {
    display: inline-block;
    font-family: 'Didact Gothic', sans-serif;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    color: #FAF8F3;
    background: #9e5c4a;
    padding: 16px 36px;
    transition: opacity 0.2s;
  }
  .evt-cta-btn:hover {
    opacity: 0.85;
  }

  /* ─── RESPONSIVE ─── */
  @media (max-width: 900px) {
    .evt-header {
      padding: 140px 24px 48px;
    }
    .evt-gallery-inner {
      padding: 48px 24px;
    }
    .evt-gallery-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 6px;
    }
    .evt-concept-inner {
      grid-template-columns: 1fr;
      padding: 48px 24px;
      gap: 40px;
    }
    .evt-past-inner {
      padding: 48px 24px;
    }
    .evt-private-inner {
      padding: 64px 24px;
    }
    .evt-cta {
      padding: 48px 24px;
    }
  }
</style>
