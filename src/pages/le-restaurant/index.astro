      </div>
      <div class="lrs-gallery-item">
        <img src="/assets/images/restaurant/restaurantgallery/IMG_0597.jpg" srcset={gallerySrcset('/assets/images/restaurant/restaurantgallery/IMG_0597.jpg')} sizes="(max-width: 900px) 100vw, 50vw" width="1200" height="800" alt="Terrace dining at Le Restaurant" loading="lazy" />
      </div>
      <div class="lrs-gallery-item">
        <img src={encodePath('/assets/images/restaurant/DSCF4081 2.JPG')} srcset={gallerySrcset('/assets/images/restaurant/DSCF4081 2.JPG')} sizes="(max-width: 900px) 100vw, 50vw" width="1200" height="800" alt="Seasonal dish at Le Restaurant" loading="lazy" />
