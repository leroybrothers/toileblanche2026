{
  "name": "toileblanche",
  "type": "module",
  "version": "1.0.0",
  "browserslist": [
    "Chrome >= 111",
    "Firefox >= 114",
    "Safari >= 16.4",
    "Edge >= 111"
  ],
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "optimize-images": "node scripts/optimize-suite-images.mjs",
    "optimize-slideshow": "node scripts/optimize-slideshow-images.mjs",
    "optimize-homepage-cards": "node scripts/optimize-homepage-cards.mjs",
    "optimize-homepage-features": "node scripts/optimize-homepage-features.mjs",
    "generate-favicons": "node scripts/generate-favicons.mjs",
    "optimize-gallery-webp": "node scripts/optimize-gallery-webp.mjs",
    "optimize-restaurant-guinguette": "node scripts/optimize-restaurant-guinguette.mjs",
    "optimize-all": "npm run optimize-slideshow && npm run optimize-images && npm run optimize-restaurant-guinguette && npm run optimize-homepage-cards && npm run optimize-homepage-features && npm run optimize-gallery-webp && node scripts/optimize-archive-images.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.2.1",
