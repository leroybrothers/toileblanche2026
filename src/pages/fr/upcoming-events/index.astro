---
import Layout from '../../../layouts/Layout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import OptimizedImage from '../../../components/OptimizedImage.astro';
---

<Layout
  locale="fr"
  title="Événements | Toile Blanche | Saint-Paul de Vence"
  description="Les Sessions Toile Blanche — Art, Gastronomie et Musique en Harmonie. Des moments exclusifs où la Toile Vivante devient une scène."
>
  <Nav locale="fr" theme="light" />

  <main id="main-content">
    <!-- HEADER -->
    <section class="evt-header">
      <div class="evt-header-inner">
        <p class="evt-header-eyebrow">Culture — Les Sessions</p>
        <h1>Les Sessions<br />Toile Blanche</h1>
        <p class="evt-header-tagline">Art, Gastronomie et Musique en Harmonie. Des moments exclusifs où la Toile Vivante devient une scène.</p>
      </div>
    </section>

    <!-- GALLERY: 8-image grid centered -->
    <section class="evt-gallery">
      <div class="evt-gallery-inner">
        <div class="evt-gallery-grid">
          <div class="evt-gallery-cell">
            <OptimizedImage src="/assets/images/art/DSCF5047.JPG" sizes="(max-width: 900px) 50vw, 25vw" width={2080} height={3120} alt="Les Sessions Toile Blanche — performance live" loading="lazy" />
          </div>
          <div class="evt-gallery-cell">
            <OptimizedImage src="/assets/images/art/evt-IMG_0268.jpg" sizes="(max-width: 900px) 50vw, 25vw" width={1200} height={800} alt="Les Sessions Toile Blanche — événement artistique" loading="lazy" />
          </div>
          <div class="evt-gallery-cell">
            <OptimizedImage src="/assets/images/art/IMG_4376.jpg" sizes="(max-width: 900px) 50vw, 25vw" width={3024} height={4032} alt="Les Sessions Toile Blanche — soirée" loading="lazy" />
          </div>
          <div class="evt-gallery-cell">
            <OptimizedImage src="/assets/images/art/DSCF4849.JPG" sizes="(max-width: 900px) 50vw, 25vw" width={4160} height={6240} alt="Les Sessions Toile Blanche — expérience créative" loading="lazy" />
          </div>
          <div class="evt-gallery-cell">
            <OptimizedImage src="/assets/images/art/etoileblanche48.jpg" sizes="(max-width: 900px) 50vw, 25vw" width={1200} height={800} alt="Les Sessions Toile Blanche — art culinaire" loading="lazy" />
          </div>
          <div class="evt-gallery-cell">
            <OptimizedImage src="/assets/images/art/evt-IMG_0554.jpg" sizes="(max-width: 900px) 50vw, 25vw" width={1200} height={800} alt="Les Sessions Toile Blanche — installation artistique" loading="lazy" />
          </div>
          <div class="evt-gallery-cell">
            <OptimizedImage src="/assets/images/art/StP25-ToileBlanche-c-GaelleSimon-12.jpg" sizes="(max-width: 900px) 50vw, 25vw" width={1200} height={800} alt="Les Sessions Toile Blanche — galerie" loading="lazy" widths={[800, 1200]} />
          </div>
          <div class="evt-gallery-cell">
            <OptimizedImage src="/assets/images/art/DSCF4033.JPG" sizes="(max-width: 900px) 50vw, 25vw" width={1200} height={800} alt="Les Sessions Toile Blanche — soirée en plein air" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <!-- THE CONCEPT + CALENDAR LINK -->
    <section class="evt-concept">
      <div class="evt-concept-inner">
        <div class="evt-concept-text">
          <h2>Les Sessions</h2>
          <p>Plusieurs fois par an, nous organisons les Sessions Toile Blanche. Chaque édition invite un artiste visuel visionnaire à créer une exposition captivante dans notre galerie ou nos jardins. Un chef invité collabore avec notre cuisine pour élaborer des plats raffinés, tandis qu'un musicien, DJ ou groupe crée l'ambiance avec des sons envoûtants.</p>
          <p class="evt-concept-quote">Rejoignez-nous l'après-midi à La Guinguette ou le soir au Restaurant pour une célébration du vivre-ensemble.</p>
        </div>
        <div class="evt-calendar">
          <p class="evt-calendar-label">Calendrier en direct</p>
          <h3>Le Calendrier</h3>
          <p>Notre calendrier complet des sessions, résidences d'artistes et vernissages est en ligne et géré par notre écosystème d'Art Contemporain.</p>
          <a href="https://www.toileblanchecontemporary.com/events/" target="_blank" rel="noopener noreferrer" class="evt-calendar-btn">Explorer les prochaines dates &rarr;</a>
          <p class="evt-calendar-note">Ouvre toileblanchecontemporary.com</p>
        </div>
      </div>
    </section>

    <!-- PAST SESSIONS -->
    <section class="evt-past">
      <div class="evt-past-inner">
        <p class="evt-past-label">Sessions passées</p>
        <p class="evt-past-intro">Notre archive complète des sessions, résidences et expositions — toujours à jour.</p>
        <a href="https://www.toileblanchecontemporary.com/events/" target="_blank" rel="noopener noreferrer" class="evt-past-btn">Voir le calendrier complet des événements &rarr;</a>
      </div>
    </section>

    <!-- PRIVATE TAKEOVERS -->
    <section class="evt-private">
      <div class="evt-private-inner">
        <h2>Votre Propre Session</h2>
        <p>Le domaine est disponible pour des privatisations et des retraites créatives sur mesure. Vingt-deux suites, deux restaurants, 20 000 m² de jardins et une équipe qui sait comment faire disparaître une soirée de la plus belle des manières.</p>
        <a href="mailto:events@toileblanche.com?subject=Demande%20Événement%20Privé" class="evt-private-link">Renseignements événements privés &rarr;</a>
      </div>
    </section>

    <!-- YOUR OWN SESSION GALLERY (sessions folder) -->
    <section class="evt-gallery">
      <div class="evt-gallery-inner">
        <div class="evt-gallery-grid">
          <div class="evt-gallery-cell">
            <OptimizedImage src="/assets/images/sessions/IMG_0184.jpg" sizes="(max-width: 900px) 50vw, 25vw" width={600} height={600} alt="Les Sessions Toile Blanche — événement privé" loading="lazy" />
          </div>
          <div class="evt-gallery-cell">
            <OptimizedImage src="/assets/images/sessions/DSCF3883.JPG" sizes="(max-width: 900px) 50vw, 25vw" width={600} height={600} alt="Les Sessions Toile Blanche — soirée sur mesure" loading="lazy" />
          </div>
          <div class="evt-gallery-cell">
            <OptimizedImage src="/assets/images/sessions/IMG_0011.jpg" sizes="(max-width: 900px) 50vw, 25vw" width={600} height={600} alt="Les Sessions Toile Blanche — retraite créative" loading="lazy" />
          </div>
          <div class="evt-gallery-cell">
            <OptimizedImage src="/assets/images/sessions/IMG_3259.jpg" sizes="(max-width: 900px) 50vw, 25vw" width={600} height={600} alt="Les Sessions Toile Blanche — privatisation" loading="lazy" />
          </div>
          <div class="evt-gallery-cell">
            <OptimizedImage src="/assets/images/sessions/DSCF4881.JPG" sizes="(max-width: 900px) 50vw, 25vw" width={600} height={600} alt="Les Sessions Toile Blanche — soirée au domaine" loading="lazy" />
          </div>
          <div class="evt-gallery-cell">
            <OptimizedImage src="/assets/images/sessions/IMG_3539.jpg" sizes="(max-width: 900px) 50vw, 25vw" width={600} height={600} alt="Les Sessions Toile Blanche — moment exclusif" loading="lazy" />
          </div>
          <div class="evt-gallery-cell">
            <OptimizedImage src="/assets/images/sessions/etoileblanche45.jpg" sizes="(max-width: 900px) 50vw, 25vw" width={600} height={600} alt="Les Sessions Toile Blanche — jardins et art" loading="lazy" />
          </div>
          <div class="evt-gallery-cell">
            <OptimizedImage src="/assets/images/sessions/IMG_0051.jpg" sizes="(max-width: 900px) 50vw, 25vw" width={600} height={600} alt="Les Sessions Toile Blanche — toile vivante" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="evt-cta">
      <p>La prochaine session se prépare.</p>
      <a href="https://www.toileblanchecontemporary.com/events/" target="_blank" rel="noopener noreferrer" class="evt-cta-btn">Voir ce qui arrive &rarr;</a>
    </section>
  </main>

  <Footer locale="fr" />
</Layout>

<style>
  /* ─── HEADER ─── */
  .evt-header {
    padding: 200px 80px 80px;
    border-bottom: 1px solid #E2D9CC;
  }
  .evt-header-inner {
    max-width: 900px;
  }
  .evt-header-eyebrow {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #9C9080;
    margin-bottom: 32px;
  }
  .evt-header h1 {
    font-family: 'Gilda Display', serif;
    font-size: clamp(48px, 7vw, 96px);
    font-weight: 400;
    line-height: 1.05;
    color: #1C1917;
    margin-bottom: 40px;
  }
  .evt-header-tagline {
    font-family: 'Gilda Display', serif;
    font-style: italic;
    font-size: clamp(18px, 2vw, 24px);
    line-height: 1.55;
    color: #6B6256;
    max-width: 650px;
  }

  /* ─── GALLERY: 8-image grid centered ─── */
  .evt-gallery {
    border-bottom: 1px solid #E2D9CC;
  }
  .evt-gallery-inner {
    max-width: 1000px;
    margin: 0 auto;
    padding: 80px;
    display: flex;
    justify-content: center;
  }
  .evt-gallery-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
    min-height: 0;
  }
  .evt-gallery-cell {
    overflow: hidden;
    min-height: 0;
    aspect-ratio: 1/1;
  }
  .evt-gallery-cell picture {
    display: block;
    width: 100%;
    height: 100%;
  }
  .evt-gallery-cell img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.8s ease;
  }
  .evt-gallery-cell:hover img {
    transform: scale(1.03);
  }

  /* ─── CONCEPT + CALENDAR ─── */
  .evt-concept {
    border-bottom: 1px solid #E2D9CC;
  }
  .evt-concept-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 80px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: start;
  }
  .evt-concept-text h2 {
    font-family: 'Gilda Display', serif;
    font-size: clamp(28px, 3vw, 40px);
    font-weight: 400;
    color: #1C1917;
    margin-bottom: 24px;
  }
  .evt-concept-text > p {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 16px;
    line-height: 1.8;
    color: #3D3530;
    margin-bottom: 24px;
  }
  .evt-concept-quote {
    font-family: 'Gilda Display', serif;
    font-style: italic;
    font-size: 18px;
    line-height: 1.6;
    color: #6B6256;
    padding-top: 24px;
    border-top: 1px solid #E2D9CC;
  }

  .evt-calendar {
    padding: 48px;
    background: rgba(226, 217, 204, 0.15);
    text-align: center;
  }
  .evt-calendar-label {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #9C9080;
    margin-bottom: 20px;
  }
  .evt-calendar h3 {
    font-family: 'Gilda Display', serif;
    font-style: italic;
    font-size: 28px;
    color: #1C1917;
    margin-bottom: 16px;
  }
  .evt-calendar > p {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 14px;
    line-height: 1.7;
    color: #6B6256;
    margin-bottom: 28px;
  }
  .evt-calendar-btn {
    display: inline-block;
    font-family: 'Didact Gothic', sans-serif;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    color: #FAF8F3;
    background: #9e5c4a;
    padding: 16px 36px;
    transition: opacity 0.2s;
    margin-bottom: 16px;
  }
  .evt-calendar-btn:hover {
    opacity: 0.85;
  }
  .evt-calendar-note {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #C4B9AA;
  }

  /* ─── PAST SESSIONS ─── */
  .evt-past {
    border-bottom: 1px solid #E2D9CC;
  }
  .evt-past-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 80px;
  }
  .evt-past-label {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #9C9080;
    margin-bottom: 16px;
  }
  .evt-past-intro {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 15px;
    line-height: 1.7;
    color: #6B6256;
    margin-bottom: 28px;
    max-width: 480px;
  }
  .evt-past-btn {
    display: inline-block;
    font-family: 'Didact Gothic', sans-serif;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    color: #FAF8F3;
    background: #9e5c4a;
    padding: 16px 36px;
    transition: opacity 0.2s;
  }
  .evt-past-btn:hover {
    opacity: 0.85;
  }

  /* ─── PRIVATE TAKEOVERS ─── */
  .evt-private {
    border-bottom: 1px solid #E2D9CC;
  }
  .evt-private-inner {
    max-width: 700px;
    margin: 0 auto;
    padding: 96px 80px;
    text-align: center;
  }
  .evt-private-inner h2 {
    font-family: 'Gilda Display', serif;
    font-style: italic;
    font-size: clamp(28px, 3.5vw, 44px);
    font-weight: 400;
    color: #1C1917;
    margin-bottom: 24px;
  }
  .evt-private-inner > p {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 16px;
    line-height: 1.8;
    color: #6B6256;
    margin-bottom: 32px;
  }
  .evt-private-link {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    color: #9e5c4a;
    border-bottom: 1px solid #9e5c4a;
    padding-bottom: 2px;
    transition: opacity 0.2s;
  }
  .evt-private-link:hover {
    opacity: 0.7;
  }

  /* ─── CTA ─── */
  .evt-cta {
    padding: 80px;
    text-align: center;
    border-bottom: 1px solid #E2D9CC;
  }
  .evt-cta p {
    font-family: 'Gilda Display', serif;
    font-style: italic;
    font-size: clamp(20px, 2.5vw, 28px);
    color: #3D3530;
    margin-bottom: 32px;
  }
  .evt-cta-btn {
    display: inline-block;
    font-family: 'Didact Gothic', sans-serif;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    color: #FAF8F3;
    background: #9e5c4a;
    padding: 16px 36px;
    transition: opacity 0.2s;
  }
  .evt-cta-btn:hover {
    opacity: 0.85;
  }

  /* ─── RESPONSIVE ─── */
  @media (max-width: 900px) {
    .evt-header {
      padding: 140px 24px 48px;
    }
    .evt-gallery-inner {
      padding: 48px 24px;
    }
    .evt-gallery-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 6px;
    }
    .evt-concept-inner {
      grid-template-columns: 1fr;
      padding: 48px 24px;
      gap: 40px;
    }
    .evt-past-inner {
      padding: 48px 24px;
    }
    .evt-private-inner {
      padding: 64px 24px;
    }
    .evt-cta {
      padding: 48px 24px;
    }
  }
</style>
