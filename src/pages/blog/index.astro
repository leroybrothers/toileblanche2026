---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const archiveFiles = import.meta.glob('../../content/archive/*.md', { eager: true });
const entries = Object.values(archiveFiles)
  .map((file: any) => file.frontmatter)
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
---

<Layout
  title="The Archive | Toile Blanche | Saint-Paul de Vence"
  description="Occasional notes from Saint-Paul de Vence — new arrivals in the collection, seasonal tables, and the technical residues of the living artwork."
>
  <Nav theme="light" />

  <main id="main-content">
    <!-- HEADER -->
    <section class="arc-header">
      <div class="arc-header-inner">
        <p class="arc-header-eyebrow">DNA — The Records</p>
        <h1>The Archive</h1>
        <p class="arc-header-tagline">Occasional notes from Saint-Paul de Vence — new arrivals in the collection, seasonal tables, and the technical residues of the living artwork.</p>
      </div>
    </section>

    <!-- ENTRIES -->
    <section class="arc-feed">
      {entries.map((entry, i) => (
        <a href={`/blog/${entry.slug}`} class="arc-entry">
          <div class="arc-entry-image">
            <img src={entry.image?.startsWith('/') ? `${import.meta.env.SITE}${entry.image}` : entry.image} alt={entry.title} loading="lazy" />
          </div>
          <div class="arc-entry-content">
            <span class="arc-entry-date">{entry.date}</span>
            <h2>{entry.title}</h2>
            <p>{entry.excerpt}</p>
          </div>
        </a>
      ))}
    </section>

    <!-- NEWSLETTER -->
    <section class="arc-newsletter">
      <div class="arc-newsletter-inner">
        <h2>The Journal</h2>
        <p>Not too often. Just enough. The occasional note from Saint-Paul de Vence — new arrivals in the collection and the things worth knowing before you visit.</p>
        <form id="newsletter-form" class="arc-nl-form">
          <input name="email" type="email" placeholder="Email address" required />
          <button type="submit">Subscribe</button>
        </form>
        <p class="tb-newsletter-msg tb-newsletter-success" aria-live="polite">Thank you. You are on the list.</p>
        <p class="tb-newsletter-msg tb-newsletter-error" aria-live="polite">Something went wrong. Please try again.</p>
        <p class="arc-newsletter-note">Join 2,000 travellers who already know.</p>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script is:inline>
(function () {
  var form = document.getElementById('newsletter-form');
  if (!form) return;
  form.addEventListener('submit', function (e) {
    e.preventDefault();
    var wrap = form.closest('.arc-newsletter-inner');
    var btn = form.querySelector('button');
    btn.textContent = '…';
    btn.disabled = true;
    fetch('/api/newsletter', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email: form.querySelector('[name="email"]').value })
    })
      .then(function (r) { if (!r.ok) throw new Error(); wrap.classList.add('is-success'); form.style.display = 'none'; })
      .catch(function () { wrap.classList.add('is-error'); btn.textContent = 'Subscribe'; btn.disabled = false; });
  });
})();
</script>

<style>
  /* ─── HEADER ─── */
  .arc-header {
    padding: 180px 80px 80px;
    border-bottom: 1px solid #E2D9CC;
  }
  .arc-header-inner {
    max-width: 800px;
  }
  .arc-header-eyebrow {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #9C9080;
    margin-bottom: 24px;
  }
  .arc-header h1 {
    font-family: 'Gilda Display', serif;
    font-size: clamp(48px, 7vw, 96px);
    font-weight: 400;
    line-height: 1.0;
    color: #1C1917;
    margin-bottom: 32px;
  }
  .arc-header-tagline {
    font-family: 'Gilda Display', serif;
    font-style: italic;
    font-size: clamp(18px, 2vw, 24px);
    line-height: 1.55;
    color: #6B6256;
    max-width: 600px;
  }

  /* ─── FEED ─── */
  .arc-feed {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 80px;
  }
  .arc-entry {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
    padding: 64px 0;
    border-bottom: 1px solid #E2D9CC;
    text-decoration: none;
    color: inherit;
  }
  .arc-entry-image {
    overflow: hidden;
  }
  .arc-entry-image img {
    width: 100%;
    aspect-ratio: 16/10;
    object-fit: cover;
    display: block;
    transition: transform 0.8s ease;
  }
  .arc-entry:hover .arc-entry-image img {
    transform: scale(1.03);
  }
  .arc-entry-date {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #9C9080;
    display: block;
    margin-bottom: 20px;
  }
  .arc-entry-content h2 {
    font-family: 'Gilda Display', serif;
    font-size: clamp(24px, 3vw, 40px);
    font-weight: 400;
    line-height: 1.15;
    color: #1C1917;
    margin-bottom: 20px;
  }
  .arc-entry-content p {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 16px;
    line-height: 1.7;
    color: #6B6256;
    margin-bottom: 28px;
    max-width: 420px;
  }
  /* ─── NEWSLETTER ─── */
  .arc-newsletter {
    border-bottom: 1px solid #E2D9CC;
  }
  .arc-newsletter-inner {
    max-width: 600px;
    margin: 0 auto;
    padding: 96px 80px;
    text-align: center;
  }
  .arc-newsletter-inner h2 {
    font-family: 'Gilda Display', serif;
    font-style: italic;
    font-size: clamp(28px, 3vw, 40px);
    font-weight: 400;
    color: #1C1917;
    margin-bottom: 20px;
  }
  .arc-newsletter-inner > p {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 16px;
    line-height: 1.7;
    color: #6B6256;
    margin-bottom: 40px;
  }
  .arc-nl-form {
    display: flex;
    gap: 12px;
    justify-content: center;
    margin-bottom: 16px;
  }
  .arc-nl-form input {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 14px;
    padding: 12px 16px;
    border: 1px solid #E2D9CC;
    background: transparent;
    color: #1C1917;
    min-width: 240px;
  }
  .arc-nl-form input::placeholder {
    color: rgba(44, 42, 38, 0.5);
  }
  .arc-nl-form button {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #FAF8F3;
    background: #1C1917;
    border: none;
    padding: 12px 24px;
    cursor: pointer;
    transition: opacity 0.2s;
  }
  .arc-nl-form button:hover {
    opacity: 0.7;
  }
  .arc-newsletter-note {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 10px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #C4B9AA;
    margin-top: 20px;
  }

  /* ─── RESPONSIVE ─── */
  @media (max-width: 900px) {
    .arc-header {
      padding: 140px 24px 48px;
    }
    .arc-feed {
      padding: 0 24px;
    }
    .arc-entry {
      grid-template-columns: 1fr;
      gap: 28px;
      padding: 40px 0;
    }
    .arc-newsletter-inner {
      padding: 64px 24px;
    }
  }
</style>
