---
import Layout from '../../../layouts/Layout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import menu from '../../../data/menu-restaurant.json';
const lang = 'fr';
---

<Layout
  locale="fr"
  title="Le Restaurant | Toile Blanche | Saint-Paul de Vence"
  description="La version du soir : plus réfléchie, plus intimiste, la cuisine à pleine attention. Une lettre d'amour au Var."
  ogImage="https://www.toileblanche.com/assets/images/page-img-14433f29c9500d.jpg"
>
  <Nav locale="fr" theme="both" ctaText="Réserver une table" ctaHref="https://bookings.zenchef.com/results?rid=357953" />

  <main id="main-content">
    <!-- HERO -->
    <section class="lrs-hero">
      <div class="lrs-hero-image">
        <img src="/assets/images/page-img-14433f29c9500d.jpg" alt="Le Restaurant de Toile Blanche" loading="eager" />
        <div class="lrs-hero-overlay"></div>
      </div>
      <div class="lrs-hero-content">
        <p class="lrs-hero-eyebrow">Dîner — Toute l'année</p>
        <h1>Le Restaurant</h1>
      </div>
    </section>

    <!-- TAGLINE -->
    <section class="lrs-tagline">
      <div class="lrs-tagline-inner">
        <p>La version du soir : plus réfléchie, plus intimiste, la cuisine à pleine attention. Une lettre d'amour au Var.</p>
      </div>
    </section>

    <!-- NARRATIVE + DETAILS -->
    <section class="lrs-narrative">
      <div class="lrs-narrative-inner">
        <div class="lrs-narrative-text">
          <h2>La Table</h2>
          <p>Le Restaurant est le lieu où la tradition méditerranéenne est réinventée à travers un regard contemporain. Le menu est construit autour du rythme des saisons — ce qui est arrivé le matin même du marché de Nice, ce qui pousse dans le jardin aromatique à vingt mètres de la cuisine, ce que les pêcheurs ont ramené à l'aube.</p>
          <p>La carte des vins se lit comme une lettre d'amour à la région. L'accent est mis sur les producteurs à portée de route — des domaines de Bellet, Bandol, Cassis et des collines au-dessus de Vence. Certaines bouteilles ne se trouvent nulle part ailleurs.</p>
          <h2>Le Lieu</h2>
          <p>Le dîner est servi sur la terrasse surplombant la vallée, ou dans la salle en pierre lorsque le mistral en décide autrement. L'ambiance est décontractée — pas de veste exigée, pas de conversations chuchotées. Simplement de la bonne cuisine dans une belle lumière.</p>
        </div>
        <div class="lrs-details">
          <p class="lrs-details-label">Informations Pratiques</p>

          <div class="lrs-details-block">
            <h3>Horaires</h3>
            <p>Dîner : 19h00 – 22h00</p>
            <p>Ouvert toute l'année</p>
            <p>Fermé le mardi (basse saison)</p>
          </div>

          <div class="lrs-details-block">
            <h3>Réservation</h3>
            <p>Recommandée pour tous les convives.</p>
            <p>Les hôtes de l'hôtel peuvent réserver via la réception ou lors de leur réservation.</p>
          </div>

          <div class="lrs-details-block lrs-details-cta">
            <a href="https://bookings.zenchef.com/results?rid=357953" target="_blank" rel="noopener noreferrer" class="lrs-btn">Réserver une Table</a>
          </div>

          <div class="lrs-details-block">
            <h3>Adresse</h3>
            <p>Toile Blanche</p>
            <p>826, chemin de la Pounchounière</p>
            <p>06570 Saint-Paul de Vence</p>
            <p>France</p>
          </div>

          <div class="lrs-details-block">
            <h3>Contact</h3>
            <a href="tel:+33493327421" class="lrs-details-link">+33 4 93 32 74 21</a>
            <a href="mailto:restaurant@toileblanche.com" class="lrs-details-link">restaurant@toileblanche.com</a>
          </div>
        </div>
      </div>
    </section>

    <!-- GALLERY PAIR -->
    <section class="lrs-gallery">
      <div class="lrs-gallery-inner">
        <div class="lrs-gallery-tall">
          <img src="/assets/images/page-img-cc1d88d7ddf7f1.jpg" alt="La terrasse du Restaurant à Toile Blanche" loading="lazy" />
        </div>
        <div class="lrs-gallery-offset">
          <img src="/assets/images/page-img-21bedcbb150956.avif" alt="Plat de saison au Restaurant" loading="lazy" />
        </div>
      </div>
    </section>

    <!-- SEASONAL MENU -->
    <section class="lrs-menu">
      <div class="lrs-menu-inner">
        <p class="lrs-menu-label">{menu.meta.season[lang]}</p>
        <h2>La Carte</h2>
        <p class="lrs-menu-intro">{menu.meta.philosophy[lang]}</p>
        <p class="lrs-menu-chefs">Chefs : {menu.meta.chefs.join(' & ')}</p>

        <!-- SET MENU -->
        <div class="lrs-menu-set">
          <div class="lrs-menu-set-header">
            <h3>Menu {menu.set_menu.title}</h3>
            <span class="lrs-menu-set-price">{menu.set_menu.price}€</span>
          </div>
          {menu.set_menu.courses.map(course => (
            <div class="lrs-menu-course">
              <p class="lrs-menu-course-label">{course.type[lang]}</p>
              {course.options.map(opt => (
                <p class="lrs-menu-dish">{opt[lang]}</p>
              ))}
            </div>
          ))}
        </div>

        <!-- À LA CARTE: ENTRÉES -->
        <div class="lrs-menu-section">
          <h3>{menu.a_la_carte.starters.title[lang]}</h3>
          {menu.a_la_carte.starters.items.map(item => (
            <div class="lrs-menu-item">
              <p class="lrs-menu-dish">{item[lang]}</p>
              <span class="lrs-menu-price">{item.price}€</span>
            </div>
          ))}
        </div>

        <!-- À LA CARTE: PLATS -->
        {Object.values(menu.a_la_carte.mains).map(sub => (
          <div class="lrs-menu-section">
            <h3>{sub.title[lang]}</h3>
            {sub.items.map(item => (
              <div class="lrs-menu-item">
                <p class="lrs-menu-dish">{item[lang]}</p>
                <span class="lrs-menu-price">{item.price}€</span>
              </div>
            ))}
          </div>
        ))}

        <!-- EXTRAS -->
        <div class="lrs-menu-section lrs-menu-extras">
          <h3>{menu.a_la_carte.extras.title[lang]}</h3>
          <div class="lrs-menu-extras-grid">
            {menu.a_la_carte.extras.items.map(item => (
              <div class="lrs-menu-item">
                <p class="lrs-menu-dish">{item[lang]}</p>
                <span class="lrs-menu-price">{item.price}€</span>
              </div>
            ))}
          </div>
        </div>

        <!-- DESSERTS -->
        <div class="lrs-menu-section">
          <h3>{menu.a_la_carte.desserts.title[lang]}</h3>
          {menu.a_la_carte.desserts.items.map(item => (
            <div class="lrs-menu-item">
              <p class="lrs-menu-dish">{item[lang]}</p>
              <span class="lrs-menu-price">{item.price}€</span>
            </div>
          ))}
        </div>

        <!-- LEGAL -->
        <div class="lrs-menu-legal">
          <p>{menu.legal.meat_origins[lang]}</p>
          <p>{menu.legal.allergy_note[lang]}</p>
        </div>
      </div>
    </section>

    <!-- PHILOSOPHY -->
    <section class="lrs-quote">
      <div class="lrs-quote-inner">
        <h2>Les tomates sont arrivées ce matin. Les herbes ont été coupées il y a dix minutes. Le vin vient de la vallée voisine.</h2>
      </div>
    </section>

    <!-- CTA -->
    <section class="lrs-cta">
      <p>La table est dressée.</p>
      <a href="https://bookings.zenchef.com/results?rid=357953" target="_blank" rel="noopener noreferrer" class="lrs-cta-btn">Réserver une Table</a>
    </section>
  </main>

  <Footer locale="fr" />
</Layout>

<script type="application/ld+json" is:inline>
{
  "@context": "https://schema.org",
  "@type": "Restaurant",
  "name": "Le Restaurant — Toile Blanche",
  "description": "Cuisine bistronomique toute en finesse. Tous les plats sont faits maison et mettent en valeur des ingrédients locaux de qualité. Menu d'hiver par les chefs Nicolas Leclair et Melissa Giordano.",
  "image": "https://www.toileblanche.com/assets/images/page-img-14433f29c9500d.jpg",
  "url": "https://www.toileblanche.com/fr/le-restaurant",
  "telephone": "+33493327421",
  "servesCuisine": ["Méditerranéenne", "Française", "Bistronomique"],
  "priceRange": "€€€",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "826, chemin de la Pounchounière",
    "addressLocality": "Saint-Paul de Vence",
    "postalCode": "06570",
    "addressCountry": "FR"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 43.6874494,
    "longitude": 7.1285941
  },
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Monday","Wednesday","Thursday","Friday","Saturday","Sunday"],
    "opens": "19:00",
    "closes": "22:00"
  },
  "acceptsReservations": "True",
  "hasMenu": {
    "@type": "Menu",
    "name": "Menu d'Hiver 2025/26",
    "hasMenuSection": [
      {
        "@type": "MenuSection",
        "name": "Menu Toile Blanche (69€)",
        "hasMenuItem": [
          {"@type": "MenuItem", "name": "Langoustines rôties dans une nage de crustacés", "description": "Avocat, citron combawa, céleri et poire nashi, Goma wakamé"},
          {"@type": "MenuItem", "name": "Tortellinis maison de carotte d'hiver", "description": "Potimarron, gomasio au romarin, écume végétale d'oignons doux des Cévennes"},
          {"@type": "MenuItem", "name": "Lieu jaune sauvage grillé", "description": "Écume chaude de haddock, chips de riz aux algues nori, pomme de terre fondante"},
          {"@type": "MenuItem", "name": "Volaille fermière grillée au barbecue", "description": "Panais, cacahuètes, lard de Colonnata et jus de viande"},
          {"@type": "MenuItem", "name": "Chocolat Ocoa 70%", "description": "Crumble aux amandes, crème glacée mascarpone, fleur de sel et réduction de balsamique"},
          {"@type": "MenuItem", "name": "Baba au Rhum", "description": "Ananas rôti au poivre de Timut, crème végétale au lait de coco, condiment fruit de la passion"}
        ]
      },
      {
        "@type": "MenuSection",
        "name": "Nos Entrées",
        "hasMenuItem": [
          {"@type": "MenuItem", "name": "Langoustines rôties", "offers": {"@type": "Offer", "price": "26", "priceCurrency": "EUR"}},
          {"@type": "MenuItem", "name": "Pot-au-feu de foie gras et os à moelle", "offers": {"@type": "Offer", "price": "29", "priceCurrency": "EUR"}},
          {"@type": "MenuItem", "name": "Tortellinis maison de carotte d'hiver", "offers": {"@type": "Offer", "price": "22", "priceCurrency": "EUR"}},
          {"@type": "MenuItem", "name": "Petits Farcis Niçois", "offers": {"@type": "Offer", "price": "24", "priceCurrency": "EUR"}}
        ]
      },
      {
        "@type": "MenuSection",
        "name": "La Mer",
        "hasMenuItem": [
          {"@type": "MenuItem", "name": "Lieu jaune sauvage grillé", "offers": {"@type": "Offer", "price": "36", "priceCurrency": "EUR"}},
          {"@type": "MenuItem", "name": "Linguine de Gragnano au homard", "offers": {"@type": "Offer", "price": "48", "priceCurrency": "EUR"}},
          {"@type": "MenuItem", "name": "Poisson du jour grillé", "offers": {"@type": "Offer", "price": "32", "priceCurrency": "EUR"}}
        ]
      },
      {
        "@type": "MenuSection",
        "name": "La Terre",
        "hasMenuItem": [
          {"@type": "MenuItem", "name": "Volaille fermière grillée au barbecue", "offers": {"@type": "Offer", "price": "32", "priceCurrency": "EUR"}},
          {"@type": "MenuItem", "name": "Filet de Boeuf Simmenthal", "offers": {"@type": "Offer", "price": "43", "priceCurrency": "EUR"}},
          {"@type": "MenuItem", "name": "Carré de Porcelet braisé au romarin", "offers": {"@type": "Offer", "price": "37", "priceCurrency": "EUR"}}
        ]
      },
      {
        "@type": "MenuSection",
        "name": "Nos Desserts",
        "hasMenuItem": [
          {"@type": "MenuItem", "name": "Sélection de fromages par la maison Mons (MOF)", "offers": {"@type": "Offer", "price": "14", "priceCurrency": "EUR"}},
          {"@type": "MenuItem", "name": "Chocolat Ocoa 70% crumble aux amandes", "offers": {"@type": "Offer", "price": "14", "priceCurrency": "EUR"}},
          {"@type": "MenuItem", "name": "Baba au Rhum", "offers": {"@type": "Offer", "price": "14", "priceCurrency": "EUR"}},
          {"@type": "MenuItem", "name": "L'agrume dans tous ses états", "offers": {"@type": "Offer", "price": "14", "priceCurrency": "EUR"}},
          {"@type": "MenuItem", "name": "Pain d'épices grillé, glace yaourt", "offers": {"@type": "Offer", "price": "14", "priceCurrency": "EUR"}}
        ]
      }
    ]
  }
}
</script>

<style>
  /* ─── HERO ─── */
  .lrs-hero {
    position: relative;
    height: 85vh;
    min-height: 500px;
    overflow: hidden;
  }
  .lrs-hero-image {
    position: absolute;
    inset: 0;
  }
  .lrs-hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .lrs-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.5) 0%, transparent 55%);
  }
  .lrs-hero-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 0 80px 72px;
    color: #fff;
  }
  .lrs-hero-eyebrow {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    opacity: 0.8;
    margin-bottom: 16px;
    color: #fff;
  }
  .lrs-hero-content h1 {
    font-family: 'Gilda Display', serif;
    font-size: clamp(40px, 6vw, 80px);
    font-weight: 400;
    line-height: 1.05;
    color: #fff;
  }

  /* ─── TAGLINE ─── */
  .lrs-tagline {
    border-bottom: 1px solid #E2D9CC;
  }
  .lrs-tagline-inner {
    max-width: 800px;
    margin: 0 auto;
    padding: 64px 80px;
    text-align: center;
  }
  .lrs-tagline-inner p {
    font-family: 'Gilda Display', serif;
    font-style: italic;
    font-size: clamp(20px, 2.5vw, 28px);
    line-height: 1.55;
    color: #3D3530;
  }

  /* ─── NARRATIVE + DETAILS ─── */
  .lrs-narrative {
    border-bottom: 1px solid #E2D9CC;
  }
  .lrs-narrative-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 80px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: start;
  }
  .lrs-narrative-text h2 {
    font-family: 'Gilda Display', serif;
    font-size: clamp(24px, 3vw, 36px);
    font-weight: 400;
    margin-bottom: 24px;
    color: #1C1917;
  }
  .lrs-narrative-text h2:not(:first-child) {
    margin-top: 48px;
  }
  .lrs-narrative-text p {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 16px;
    line-height: 1.8;
    color: #3D3530;
    margin-bottom: 16px;
  }

  .lrs-details {
    padding: 48px;
    background: rgba(226, 217, 204, 0.15);
  }
  .lrs-details-label {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #9C9080;
    margin-bottom: 40px;
  }
  .lrs-details-block {
    margin-bottom: 32px;
    padding-bottom: 32px;
    border-bottom: 1px solid rgba(226, 217, 204, 0.5);
  }
  .lrs-details-block:last-child {
    margin-bottom: 0;
    padding-bottom: 0;
    border-bottom: none;
  }
  .lrs-details-block h3 {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 10px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #9C9080;
    margin-bottom: 12px;
  }
  .lrs-details-block p {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 14px;
    line-height: 1.7;
    color: #3D3530;
  }
  .lrs-details-link {
    display: block;
    font-family: 'Didact Gothic', sans-serif;
    font-size: 14px;
    color: #3D3530;
    text-decoration: none;
    line-height: 1.7;
    transition: color 0.2s;
  }
  .lrs-details-link:hover {
    color: #9e5c4a;
  }
  .lrs-details-cta {
    text-align: center;
    padding-top: 8px;
    padding-bottom: 40px;
  }
  .lrs-btn {
    display: inline-block;
    font-family: 'Didact Gothic', sans-serif;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    color: #FAF8F3;
    background: #9e5c4a;
    padding: 16px 36px;
    transition: opacity 0.2s;
  }
  .lrs-btn:hover {
    opacity: 0.85;
  }

  /* ─── GALLERY ─── */
  .lrs-gallery {
    border-bottom: 1px solid #E2D9CC;
  }
  .lrs-gallery-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 80px;
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 40px;
    align-items: start;
  }
  .lrs-gallery-tall img {
    width: 100%;
    aspect-ratio: 3/4;
    object-fit: cover;
    display: block;
  }
  .lrs-gallery-offset {
    padding-top: 120px;
  }
  .lrs-gallery-offset img {
    width: 100%;
    aspect-ratio: 4/5;
    object-fit: cover;
    display: block;
  }

  /* ─── SEASONAL MENU ─── */
  .lrs-menu {
    border-bottom: 1px solid #E2D9CC;
  }
  .lrs-menu-inner {
    max-width: 800px;
    margin: 0 auto;
    padding: 80px;
  }
  .lrs-menu-label {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #9C9080;
    margin-bottom: 16px;
  }
  .lrs-menu-inner > h2 {
    font-family: 'Gilda Display', serif;
    font-size: clamp(28px, 3vw, 40px);
    font-weight: 400;
    color: #1C1917;
    margin-bottom: 16px;
  }
  .lrs-menu-intro {
    font-family: 'Gilda Display', serif;
    font-style: italic;
    font-size: clamp(16px, 2vw, 20px);
    line-height: 1.55;
    color: #3D3530;
    margin-bottom: 8px;
    max-width: 700px;
  }
  .lrs-menu-chefs {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 12px;
    letter-spacing: 0.1em;
    color: #9C9080;
    margin-bottom: 56px;
  }

  /* Set menu */
  .lrs-menu-set {
    margin-bottom: 64px;
    padding: 48px;
    background: rgba(226, 217, 204, 0.12);
  }
  .lrs-menu-set-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 32px;
    padding-bottom: 20px;
    border-bottom: 1px solid #E2D9CC;
  }
  .lrs-menu-set-header h3 {
    font-family: 'Gilda Display', serif;
    font-style: italic;
    font-size: clamp(22px, 2.5vw, 30px);
    font-weight: 400;
    color: #1C1917;
  }
  .lrs-menu-set-price {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 18px;
    color: #9e5c4a;
    letter-spacing: 0.05em;
  }
  .lrs-menu-course {
    margin-bottom: 28px;
  }
  .lrs-menu-course:last-child {
    margin-bottom: 0;
  }
  .lrs-menu-course-label {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #9C9080;
    margin-bottom: 12px;
  }

  /* À la carte sections */
  .lrs-menu-section {
    margin-bottom: 48px;
  }
  .lrs-menu-section:last-of-type {
    margin-bottom: 40px;
  }
  .lrs-menu-section h3 {
    font-family: 'Gilda Display', serif;
    font-style: italic;
    font-size: 22px;
    font-weight: 400;
    color: #1C1917;
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom: 1px solid #E2D9CC;
  }
  .lrs-menu-item {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 24px;
    padding-bottom: 16px;
    margin-bottom: 16px;
    border-bottom: 1px solid rgba(226, 217, 204, 0.3);
  }
  .lrs-menu-item:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }
  .lrs-menu-dish {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 15px;
    line-height: 1.6;
    color: #3D3530;
    flex: 1;
  }
  .lrs-menu-price {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 15px;
    color: #9C9080;
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* Extras grid */
  .lrs-menu-extras-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 40px;
  }

  /* Legal */
  .lrs-menu-legal {
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid #E2D9CC;
  }
  .lrs-menu-legal p {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 11px;
    color: #9C9080;
    line-height: 1.6;
    margin-bottom: 4px;
  }

  /* ─── QUOTE ─── */
  .lrs-quote {
    border-bottom: 1px solid #E2D9CC;
  }
  .lrs-quote-inner {
    max-width: 900px;
    margin: 0 auto;
