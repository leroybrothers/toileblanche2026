---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const suites = [
  {
    href: '/suites/suite-petanque',
    image: '/assets/images/694514f7700aaf8cf582cf9b_IMG_2662.jpg',
    alt: 'Suite Pétanque',
    title: 'Suite Pétanque',
    description: 'Suite Pétanque set within a beautifully renovated residence, offers more space than our smallest category, complete with a living area, a terrace with sun loungers, and a tranquil setting to unwind.',
  },
  {
    href: '/suites/bronzette',
    image: '/assets/images/678e1fd67876e5f39084f009_DSCF7500 (1)-p-3200.jpg',
    alt: 'Suite de la Bronzette',
    title: 'Suite de la Bronzette',
    description: "Spacious suites with bedroom and living room, allowing for extra privacy and the possibility to add an extra bed. You'll find a sumptuous spa-like bathroom here, along with a large, private outdoor area with sunbeds.",
  },
  {
    href: '/suites/bonvivant',
    image: '/assets/images/678e3042a536f8fb4e4e08ca_IMG_4830 (5)-p-1600.jpg',
    alt: 'Suite du Bon-Vivant',
    title: 'Suite du Bon-Vivant',
    description: 'Our bright Suites du Bon-Vivant come with ample bedroom and lounging space, along with a luxury bathroom. The main attraction, however, is the exceptional terrace with a private pool. Here, the sunset is just magical.',
  },
  {
    href: '/suites/suiteaartiste',
    image: '/assets/images/suite-de-l-artist.jpg',
    alt: "Suite de l'Artiste",
    title: "Suite de l'Artiste",
    description: "This modern rustic suite is situated in the 200-year-old farmhouse, where authentic details (think wooden beams and natural stone) have been preserved to complement the contemporary design. But, the picturesque balcony with views of the surroundings is what makes this suite so special.",
  },
  {
    href: '/suites/masartiste',
    image: '/assets/images/mas-de-l-artist.jpg',
    alt: "Mas de l'Artiste",
    title: "Mas de l'Artiste",
    description: "This vast sun-flooded maisonette is housed in the 200-year-old restored farmhouse. The sleeping area is neatly separated to ensure complete intimacy, whereas the living area gives direct access to a private Provençal courtyard with sun loungers and a very cosy sitting corner.",
  },
  {
    href: '/suites/penequet',
    image: '/assets/images/694514f7700aaf8cf582cf9b_IMG_2662.jpg',
    alt: 'Villa du Pénéquet',
    title: 'Villa du Pénéquet',
    description: 'The Villas du Pénéquet–the Provençal word for power-nap–are the only suites boasting two floors. Downstairs houses the luxurious living area with direct access to your own private pool and sun loungers. On the first floor, we find the master bedroom and a bathroom with a large bathtub and separate walk-in shower.',
  },
];
---

<Layout>
  <!-- Page Loader -->
  <div class="loader" id="page-loader">
    <div class="loader-logo-wrapper">
      <img src="/assets/images/63a19dacd6b229843a52a138_Toile%20Blanche%20Logo%202022%20black.avif" loading="lazy" alt="Toile Blanche" />
      <div class="loader-line"></div>
    </div>
  </div>

  <!-- Hero Section -->
  <header class="hero1" id="hero" style="opacity:0">
    <div class="hero-bg-wrapper hero-bg-parallax">
      <div class="hero-bg-slide hero-bg-slide-1 is-active" role="img" aria-label="Toile Blanche, Saint-Paul de Vence"></div>
      <div class="hero-bg-slide hero-bg-slide-2" aria-hidden="true"></div>
      <div class="hero-bg-slide hero-bg-slide-3" aria-hidden="true"></div>
      <div class="hero-bg-slide hero-bg-slide-4" aria-hidden="true"></div>
      <div class="hero-bg-slide hero-bg-slide-5" aria-hidden="true"></div>
    </div>
    <div class="hero-bg-overlay"></div>

    <Nav theme="both" />

    <div class="hero1-content-wrapper">
      <div class="hero1-content" id="hero-content">
        <h1 class="hero-headline light">The Côte d'Azur,<br />without the spectacle.</h1>
        <div class="hero-second-line light">The art is not on the walls, it is the walls.</div>
        <div class="hero-body light">And the particular pleasure of going nowhere for a few days.</div>
        <div class="hero1-arrow">
          <img
            src="/assets/images/639af6c370637a631de3b0f3_big_arrow_down_light.svg"
            loading="lazy"
            alt="Scroll down"
            class="hero-arrow-image"
            id="hero-arrow"
          />
        </div>
      </div>
    </div>
  </header>

  <!-- Booking Buttons -->
  <section class="subhero-section">
    <div class="container">
      <div class="booking-button-wrapper">
        <div class="button-row space-around">
          <a href="https://bookings.zenchef.com/results?rid=357953&pid=1001" target="_blank" rel="noopener noreferrer" class="button secondary w-button">Book My Table</a>
          <a href="https://app.mews.com/distributor/150bd326-7c63-4a24-b668-abcf00c6bb22" target="_blank" rel="noopener noreferrer" class="button secondary w-button">Book My Suite</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Introduction -->
  <div class="section tb-intro-section">
    <div class="container">
      <div class="tb-intro-blocks">
        <div class="tb-intro-block">
          <h3 class="tb-intro-block-title">The Story</h3>
          <p>The Leroy Brothers arrived in Saint-Paul de Vence in 2004 with three rooms and a long-term view.</p>
          <p>Over twenty years, they bought the neighbouring houses one by one — from neighbours who became friends. Then, when the time was right, they stopped and built the version they had always had in mind.</p>
          <p>The result is something genuinely difficult to categorise.</p>
          <p>22 suites. Two restaurants. Three pools. 20,000m² of gardens. Saint-Paul de Vence.</p>
        </div>
        <div class="tb-intro-block">
          <h3 class="tb-intro-block-title">The Feeling</h3>
          <p>Toile Blanche sits on the edge of Saint-Paul de Vence — the village that gave the world Fondation Maeght, that sheltered Picasso, Chagall and Calder — and it takes that responsibility seriously.</p>
          <p>But not seriously in the way that makes you feel watched. The pool is warm. The rosé is cold. The art will make you stop and think, and then you will go back to the pool.</p>
          <p>This is the point.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Suites Slider -->
  <div class="section tb-suites-section overlap-section-top">
    <div class="home-room-slider-wrapper">
      <div class="home-room-slider js-slider" id="suites-slider" role="region" aria-label="Suite gallery">
        <div class="home-room-mask js-slider-track">
          {suites.map((suite, i) => (
            <div class={`home-room-single-slide js-slide${suite.href === '/suites/masartiste' ? ' room-slide-masartiste' : ''}`} data-slide-index={i} role="group" aria-label={`${i + 1} of ${suites.length}`}>
              <a href={suite.href} class="room-slide-wrapper w-inline-block">
                <div class="room-slide-image-wrapper">
                  <div class="room-slide-image-container">
                    <img loading="lazy" alt={suite.alt} src={suite.image} class="room-slide-image" />
                  </div>
                </div>
                <div class="room-slide-content-wrapper">
                  <div class="room-slide-title">
                    <h3 class="light">{suite.title}</h3>
                  </div>
                  <div class="room-slide-description">
                    <p class="light">{suite.description}</p>
                  </div>
                </div>
              </a>
            </div>
          ))}
        </div>
      </div>
      <div class="room-slider-dots" aria-label="Slide navigation">
        {suites.map((_, i) => (
          <button type="button" class="room-slider-dot js-slider-dot" data-index={i} aria-label={`Go to slide ${i + 1}`} aria-current={i === 0 ? 'true' : undefined} />
        ))}
      </div>
    </div>
    <div class="suites-view-all-link">
      <a href="/suites" class="suites-view-all-btn">View all suites</a>
    </div>
  </div>

  <!-- Art, Restaurants, Experiences -->
  <div class="section top-padding-192">
    <div class="container">
      <div class="tb-three-blocks">
        <!-- Art -->
        <div class="tb-feature-block">
          <div class="tb-feature-block-image">
            <img
              src="/assets/images/677ce5a0ffdffd79d9f89e13_Aerts 6 (1)-p-1600.jpg"
              loading="lazy"
              width="524"
              sizes="(max-width: 767px) 100vw, 524px"
              alt="Contemporary art at Toile Blanche"
            />
          </div>
          <div class="tb-feature-block-content">
            <h3>The Art</h3>
            <p>The works at Toile Blanche are chosen, not accumulated. Each piece was selected by the Leroy Brothers — who are themselves artists — in conversation with the people who made them. The collection spans painting, sculpture, photography and installation. It changes. New works arrive each season.</p>
            <p>Staying here more than once means encountering a different conversation with the same rooms.</p>
            <a href="/art" class="button secondary w-button">Discover the art</a>
          </div>
        </div>

        <!-- Restaurants -->
        <div class="tb-feature-block tb-feature-block--reverse">
          <div class="tb-feature-block-image">
            <img
              src="/assets/images/twotable2.jpg"
              loading="lazy"
              width="524"
              sizes="(max-width: 767px) 100vw, 524px"
              alt="Toile Blanche restaurants"
            />
          </div>
          <div class="tb-feature-block-content">
            <h3>Two Tables Worth Travelling For</h3>
            <p>La Guinguette is lunch under the plane trees — rosé, grilled fish, the specific joy of eating outside in Provence. Le Restaurant is the evening version: more considered, more intimate, the kitchen at full attention. Both menus are built around what is in season, what is local, what is honest.</p>
            <a href="/restaurants" class="button secondary w-button">Reserve a table</a>
          </div>
        </div>

        <!-- Experiences -->
        <div class="tb-feature-block">
          <div class="tb-feature-block-image">
            <img
              src="/assets/images/Experiences.jpg"
              loading="lazy"
              width="524"
              sizes="(max-width: 767px) 100vw, 524px"
              alt="Experiences at Toile Blanche"
            />
          </div>
          <div class="tb-feature-block-content">
            <h3>Life at Toile Blanche</h3>
            <p>Saint-Paul de Vence is three minutes on foot. Fondation Maeght is five. Beyond that — studio visits, the Art Route, the valley on a bicycle, and the particular pleasure of doing none of it.</p>
            <a href="/experiences" class="button secondary w-button">Explore experiences</a>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- Booking CTA -->
  <div class="section no-bottom-padding no-top-padding">
    <div class="subhero-section">
      <div class="container">
        <div class="booking-button-wrapper">
          <div class="button-row space-around">
            <a href="https://bookings.zenchef.com/results?rid=357953&pid=1001" target="_blank" rel="noopener noreferrer" class="button secondary w-button">Book My Table</a>
            <a href="https://app.mews.com/distributor/150bd326-7c63-4a24-b668-abcf00c6bb22" target="_blank" rel="noopener noreferrer" class="button secondary w-button">Book My Suite</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Full frame image 1 -->
  <div class="section no-bottom-padding no-top-padding">
    <div class="full-frame-image-wrapper homepage-one"></div>
  </div>

  <!-- Newsletter -->
  <div class="section padding-96 bg-color-2">
    <div class="container">
      <div class="tb-newsletter">
        <div class="tb-newsletter-content">
          <h3 class="tb-newsletter-title">A home away from home, for people who have exceptional homes. Stay in touch.</h3>
          <p class="tb-newsletter-desc">Not too often. Just enough. The occasional note from Saint-Paul de Vence — new arrivals in the collection, what is on the table this season, and the things worth knowing before you visit.</p>
          <p class="tb-newsletter-cta">Join 2,000 people who already know.</p>
        </div>
        <div class="tb-newsletter-form-wrap">
          <form id="newsletter-form" name="newsletter-form" method="POST" class="tb-newsletter-form" action="/api/newsletter">
            <div class="tb-newsletter-row">
              <div class="tb-newsletter-field">
                <label for="First-Name">First name</label>
                <input id="First-Name" name="First-Name" type="text" placeholder="First name" maxlength="256" required />
              </div>
              <div class="tb-newsletter-field">
                <label for="Last-Name">Last name</label>
                <input id="Last-Name" name="Last-Name" type="text" placeholder="Last name" maxlength="256" required />
              </div>
              <div class="tb-newsletter-field">
                <label for="Email">Email address</label>
                <input id="Email" name="Email" type="email" placeholder="Email address" maxlength="256" required />
              </div>
              <button type="submit" class="tb-newsletter-submit">Stay in Touch</button>
            </div>
          </form>
          <p class="tb-newsletter-legal">By subscribing to The Toile Blanche Journal you agree to our <a href="/privacy-policy">privacy policy</a></p>
        </div>
      </div>
    </div>
  </div>

  <div class="divider _96px"></div>

  <Footer />
</Layout>
