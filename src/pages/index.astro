---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import suitesData from '../data/suites.json';

function srcset(path: string, widths: number[]) {
  const ext = path.substring(path.lastIndexOf('.'));
  const base = path.substring(0, path.lastIndexOf('.'));
  return widths.map(w => `${base}-${w}w${ext} ${w}w`).join(', ') + `, ${path} ${widths[widths.length - 1] * 2}w`;
}

const suites = suitesData.suites.map(s => ({
  href: `/suites/${s.slug}`,
  image: s.images.card,
  srcset: srcset(s.images.card, [400]),
  alt: s.images.cardAlt,
  title: s.name,
  description: s.tagline,
}));
---

<Layout
  title="Toile Blanche | Saint-Paul de Vence"
  description="22 suites, two restaurants, and a contemporary art collection in Saint-Paul de Vence. A declared artwork by the Leroy Brothers on the Côte d'Azur."
  ogImage="https://www.toileblanche.com/assets/images/slideshow1.jpg"
>
  <!-- Page Loader -->
  <div class="loader" id="page-loader">
    <div class="loader-logo-wrapper">
      <img src="/assets/images/63a19dacd6b229843a52a138_Toile%20Blanche%20Logo%202022%20black.avif" loading="lazy" alt="Toile Blanche" />
      <div class="loader-line"></div>
    </div>
  </div>

  <!-- Hero Section -->
  <main id="main-content">
  <header class="hero1" id="hero" style="opacity:0">
    <div class="hero-bg-wrapper hero-bg-parallax hero-bg-video">

      <!-- Desktop & tablet (≥ 769px) — landscape 16:9 -->
      <video
        class="hero-video hero-video--landscape"
        autoplay muted loop playsinline
        preload="auto"
        poster="/assets/videos/hero-landscape-poster.jpg"
        aria-label="Toile Blanche, Saint-Paul de Vence"
      >
        <source src="/assets/videos/hero-landscape.mp4" type="video/mp4">
      </video>

      <!-- Mobile (≤ 768px portrait) — portrait 9:16 (lazy loaded) -->
      <video
        class="hero-video hero-video--portrait"
        autoplay muted loop playsinline
        preload="none"
        poster="/assets/videos/hero-portrait-poster.jpg"
        aria-hidden="true"
      >
        <source src="/assets/videos/hero-portrait.mp4" type="video/mp4">
      </video>
    </div>
    <div class="hero-bg-overlay"></div>

    <Nav theme="both" />

    <div class="hero1-content-wrapper">
      <div class="hero1-content" id="hero-content">
        <h1 class="hero-headline light">The Côte d'Azur,<br />without the spectacle.</h1>
        <div class="hero-second-line light">The art is not on the walls — it is the walls.</div>
        <div class="hero-body light">And the particular pleasure of going nowhere for a few days.</div>
        <div class="hero-cta-wrap">
          <a href="#" class="hero-cta distributor-open">Book My Stay</a>
        </div>
        <p class="hero-micro">Direct bookings include our best rate guarantee, priority for suite upgrades, and complimentary breakfast.</p>
        <div class="hero1-arrow">
          <img
            src="/assets/images/639af6c370637a631de3b0f3_big_arrow_down_light.svg"
            loading="lazy"
            alt="Scroll down"
            class="hero-arrow-image"
            id="hero-arrow"
          />
        </div>
      </div>
    </div>
  </header>

  <!-- Introduction -->
  <div class="section tb-intro-section">
    <div class="container">
      <div class="tb-intro-blocks">
        <div class="tb-intro-block">
          <h2 class="tb-intro-block-title">The Story</h2>
          <p>The Leroy Brothers — three artists — arrived in Saint-Paul de Vence in 2004 with three rooms and a long-term view.</p>
          <p>Over twenty years, they bought the neighbouring houses one by one — from neighbours who became friends. Then, when the time was right, they stopped and built the version they had always had in mind.</p>
          <p>The result is something genuinely difficult to categorise.</p>
          <p>22 suites. Two restaurants. Three pools. 20,000m² of gardens. Saint-Paul de Vence.</p>
        </div>
        <div class="tb-intro-block">
          <h2 class="tb-intro-block-title">The Feeling</h2>
          <p>Toile Blanche sits on the edge of Saint-Paul de Vence — the village that gave the world Fondation Maeght, that sheltered Picasso, Chagall and Calder — and it takes that responsibility seriously.</p>
          <p>But not seriously in the way that makes you feel watched. The pool is warm. The rosé is cold. The art will make you stop and think, and then you will go back to the pool.</p>
          <p>This is the point.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Suites Slider -->
  <div class="section tb-suites-section overlap-section-top">
    <div class="home-room-slider-wrapper">
      <div class="home-room-slider js-slider" id="suites-slider" role="region" aria-label="Suite gallery">
        <div class="home-room-mask js-slider-track">
          {suites.map((suite, i) => (
            <div class={`home-room-single-slide js-slide${suite.href === '/suites/mas-artiste' ? ' room-slide-masartiste' : ''}`} data-slide-index={i} role="group" aria-label={`${i + 1} of ${suites.length}`}>
              <a href={suite.href} class="room-slide-wrapper w-inline-block">
                <div class="room-slide-image-wrapper">
                  <div class="room-slide-image-container">
                    <img loading="lazy" alt={suite.alt} src={suite.image} srcset={suite.srcset} sizes="(max-width: 900px) 80vw, 33vw" class="room-slide-image" />
                  </div>
                </div>
                <div class="room-slide-content-wrapper">
                  <div class="room-slide-title">
                    <h2 class="light">{suite.title}</h2>
                  </div>
                  <div class="room-slide-description">
                    <p class="light">{suite.description}</p>
                  </div>
                </div>
              </a>
            </div>
          ))}
        </div>
      </div>
      <div class="room-slider-dots" aria-label="Slide navigation">
        {suites.map((_, i) => (
          <button type="button" class="room-slider-dot js-slider-dot" data-index={i} aria-label={`Go to slide ${i + 1}`} aria-current={i === 0 ? 'true' : undefined} />
        ))}
      </div>
    </div>
    <div class="suites-view-all-link">
      <a href="/suites" class="suites-view-all-btn">View all suites</a>
    </div>
  </div>

  <!-- Art, Restaurants, Experiences -->
  <div class="section top-padding-192">
    <div class="container">
      <div class="tb-three-blocks">
        <!-- Art -->
        <div class="tb-feature-block">
          <div class="tb-feature-block-image">
            <a href="/art" class="tb-feature-block-image-link">
              <img
                src="/assets/images/677ce5a0ffdffd79d9f89e13_Aerts 6 (1)-p-1600.jpg"
                loading="lazy"
                width="524"
                sizes="(max-width: 767px) 100vw, 524px"
                alt="Contemporary art at Toile Blanche"
              />
            </a>
          </div>
          <div class="tb-feature-block-content">
            <h2>The Art</h2>
            <p>The works at Toile Blanche are chosen, not accumulated. Each piece was selected by the Leroy Brothers — who are themselves artists — in conversation with the people who made them. The collection spans painting, sculpture, photography and installation. It changes. New works arrive each season.</p>
            <p>Staying here more than once means encountering a different conversation with the same rooms.</p>
            <a href="/art" class="button secondary w-button">Discover the art</a>
          </div>
        </div>

        <!-- Restaurants -->
        <div class="tb-feature-block tb-feature-block--reverse">
          <div class="tb-feature-block-image">
            <a href="/restaurants" class="tb-feature-block-image-link">
              <img
                src="/assets/images/twotable2.jpg"
                loading="lazy"
                width="524"
                sizes="(max-width: 767px) 100vw, 524px"
                alt="Toile Blanche restaurants"
              />
            </a>
          </div>
          <div class="tb-feature-block-content">
            <h2>Two Tables Worth Travelling For</h2>
            <p>La Guinguette is lunch under the plane trees — rosé, grilled fish, the specific joy of eating outside in Provence. Le Restaurant is the evening version: more considered, more intimate, the kitchen at full attention. Both menus are built around what is in season, what is local, what is honest.</p>
            <a href="/restaurants" class="button secondary w-button">Reserve a table</a>
          </div>
        </div>

        <!-- Experiences -->
        <div class="tb-feature-block">
          <div class="tb-feature-block-image">
            <a href="/experiences" class="tb-feature-block-image-link">
              <img
                src="/assets/images/Experiences.jpg"
                loading="lazy"
                width="524"
                sizes="(max-width: 767px) 100vw, 524px"
                alt="Experiences at Toile Blanche"
              />
            </a>
          </div>
          <div class="tb-feature-block-content">
            <h2>Life at Toile Blanche</h2>
            <p>Saint-Paul de Vence is three minutes on foot. Fondation Maeght is five. Beyond that — studio visits, the Art Route, the valley on a bicycle, and the particular pleasure of doing none of it.</p>
            <a href="/experiences" class="button secondary w-button">Explore experiences</a>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- Booking CTA -->
  <div class="section no-bottom-padding no-top-padding">
    <div class="subhero-section">
      <div class="container">
        <div class="booking-button-wrapper">
          <div class="button-row space-around">
            <button type="button" data-zc-action="open" class="button secondary w-button">Book My Table</button>
            <a href="#" class="button secondary w-button distributor-open">Book My Suite</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Full frame image 1 -->
  <div class="section no-bottom-padding no-top-padding">
    <div class="full-frame-image-wrapper homepage-one"></div>
  </div>

  <!-- Direct Privilege -->
  <section class="tb-direct-privilege">
    <h2 class="tb-dp-headline">Book at the Source.</h2>
    <p class="tb-dp-intro">Reserve your stay directly with Toile Blanche for a more personal experience and the best available value.</p>
    <div class="tb-dp-grid">
      <div class="tb-dp-item">
        <p class="tb-dp-label">Best Rate Guaranteed</p>
        <p class="tb-dp-desc">The most favourable price is only found here.</p>
      </div>
      <div class="tb-dp-item">
        <p class="tb-dp-label">Priority Upgrades</p>
        <p class="tb-dp-desc">Direct guests are first in line for suite surclasses.</p>
      </div>
      <div class="tb-dp-item">
        <p class="tb-dp-label">Breakfast Included</p>
        <p class="tb-dp-desc">Our full Provençal morning ritual is always complimentary.</p>
      </div>
    </div>
    <div class="tb-dp-cta-wrap">
      <a href="#" class="tb-dp-cta distributor-open">Reserve My Suite</a>
    </div>
  </section>

  <!-- Newsletter -->
  <div class="section padding-96 bg-color-2">
    <div class="container">
      <div class="tb-newsletter">
        <div class="tb-newsletter-content">
          <h2 class="tb-newsletter-title">The Toile Blanche Journal.<br />Not too often. Just enough.</h2>
          <p class="tb-newsletter-desc">The occasional note from Saint-Paul de Vence — new arrivals in the collection, what is on the table this season, and the things worth knowing before you visit.</p>
          <p class="tb-newsletter-cta">Join 2,000 people who already know.</p>
        </div>
        <div class="tb-newsletter-form-wrap">
          <form id="newsletter-form" class="tb-newsletter-form">
            <div class="tb-newsletter-row">
              <div class="tb-newsletter-field">
                <label for="nl-first">First name</label>
                <input id="nl-first" name="firstName" type="text" placeholder="First name" maxlength="256" required />
              </div>
              <div class="tb-newsletter-field">
                <label for="nl-last">Last name</label>
                <input id="nl-last" name="lastName" type="text" placeholder="Last name" maxlength="256" required />
              </div>
              <div class="tb-newsletter-field">
                <label for="nl-email">Email address</label>
                <input id="nl-email" name="email" type="email" placeholder="Email address" maxlength="256" required />
              </div>
              <button type="submit" class="tb-newsletter-submit">Stay in Touch</button>
            </div>
          </form>
          <p class="tb-newsletter-msg tb-newsletter-success" aria-live="polite">Thank you. You are on the list.</p>
          <p class="tb-newsletter-msg tb-newsletter-error" aria-live="polite">Something went wrong. Please try again.</p>
          <p class="tb-newsletter-legal">By subscribing to The Toile Blanche Journal you agree to our <a href="/privacy-policy">privacy policy</a></p>
        </div>
      </div>
    </div>
  </div>

  <div class="divider _96px"></div>

  <Footer />
  </main>
</Layout>

<script type="application/ld+json" is:inline>
{
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Toile Blanche — Saint-Paul de Vence",
  "description": "22 suites, two restaurants, and a contemporary art collection in Saint-Paul de Vence. A declared artwork by the Leroy Brothers on the Côte d'Azur.",
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": [".hero-headline", ".hero-second-line", ".hero-body", ".tb-intro-block"]
  },
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://www.toileblanche.com/"
      }
    ]
  }
}
</script>

<script is:inline>
(function () {
  var form = document.getElementById('newsletter-form');
  if (!form) return;

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    var wrap = form.closest('.tb-newsletter-form-wrap');
    var btn = form.querySelector('.tb-newsletter-submit');
    var data = new FormData(form);

    wrap.classList.remove('is-error');
    btn.classList.add('is-sending');
    btn.textContent = '…';

    fetch('/api/newsletter', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        email: data.get('email'),
        firstName: data.get('firstName'),
        lastName: data.get('lastName')
      })
    })
      .then(function (res) {
        if (!res.ok) throw new Error(res.status);
        wrap.classList.add('is-success');
      })
      .catch(function () {
        wrap.classList.add('is-error');
        btn.classList.remove('is-sending');
        btn.textContent = form.dataset.submitLabel || 'Stay in Touch';
      });
  });
})();
</script>
