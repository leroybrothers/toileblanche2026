---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { cardSrcset, gallerySrcset, heroSrcset } from '../../utils/images';
import { sortGalleryByCategory } from '../../utils/suite-gallery';
import suitesData from '../../data/suites.json';

export function getStaticPaths() {
  const { masterAmenities, suites } = suitesData;

  return suites.map((suite) => ({
    params: { slug: suite.slug },
    props: {
      suite,
      allSuites: suites,
      amenities: [...masterAmenities, ...suite.extras],
    },
  }));
}

const { suite, allSuites, amenities } = Astro.props;
const otherSuites = allSuites.filter(s => s.slug !== suite.slug);

const defaultSuiteSchema = {
  "@context": "https://schema.org",
  "@type": "HotelRoom",
  "name": suite.name,
  "description": suite.tagline,
  "image": `https://www.toileblanche.com${suite.images.hero}`,
  "url": `https://www.toileblanche.com/suites/${suite.slug}`,
  "occupancy": {
    "@type": "QuantitativeValue",
    "value": parseInt(suite.specs.occupancy) || 2,
    "unitText": "guests"
  },
  "floorSize": {
    "@type": "QuantitativeValue",
    "value": suite.specs.size,
    "unitCode": "MTK"
  },
  "numberOfRooms": suite.specs.count,
  "amenityFeature": [
    ...suite.extras.map(e => ({ "@type": "LocationFeatureSpecification", "name": e, "value": true })),
    { "@type": "LocationFeatureSpecification", "name": suite.specs.view, "value": true }
  ],
  "containedInPlace": {
    "@type": "Hotel",
    "name": "Toile Blanche",
    "url": "https://www.toileblanche.com"
  }
};
