---
import Layout from '../../../layouts/Layout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import menu from '../../../data/menu-guinguette.json';
import { gallerySrcset, encodePath } from '../../../utils/images';
const lang = 'fr';
---

<Layout
  locale="fr"
  title="La Guinguette | Toile Blanche | Saint-Paul de Vence"
  description="Le cœur du jardin. Venez pieds nus ou en espadrilles. La Provence s'invite à votre table."
  ogImage="https://www.toileblanche.com/assets/images/page-img-7f72d09199a7a2.jpg"
  hideBookingBar={true}
  loadZenchef={true}
>
  <Nav locale="fr" theme="both" ctaText="Réserver une table" ctaAction="zenchef" zenchefRid="375927" zenchefPid="1001" />

  <main id="main-content">
    <!-- HERO -->
    <section class="lgn-hero">
      <div class="lgn-hero-image">
        <img src="/assets/images/page-img-7f72d09199a7a2.jpg" alt="La Guinguette de Toile Blanche" width="1170" height="1702" loading="eager" fetchpriority="high" />
        <div class="lgn-hero-overlay"></div>
      </div>
      <div class="lgn-hero-content">
        <p class="lgn-hero-eyebrow">Déjeuner — Toute l'année</p>
        <h1>La Guinguette</h1>
        <a href="https://www.instagram.com/laguinguette.toileblanche/" target="_blank" rel="noopener noreferrer" class="lgn-insta-ref">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
          <span>@laguinguette.toileblanche</span>
        </a>
      </div>
    </section>

    <!-- TAGLINE -->
    <section class="lgn-tagline">
      <div class="lgn-tagline-inner">
        <p>Le cœur du jardin. Venez pieds nus ou en espadrilles. La Provence s'invite à votre table.</p>
      </div>
    </section>

    <!-- NARRATIVE + DETAILS -->
    <section class="lgn-narrative">
      <div class="lgn-narrative-inner">
        <div class="lgn-narrative-text">
          <h2>La Table du Jardin</h2>
          <p>La Guinguette est l'âme de l'été à Toile Blanche. Installée sous les platanes au bord de la piscine, c'est là que le déjeuner dure aussi longtemps qu'il le faut — quelque part entre un vrai repas et un long après-midi provençal.</p>
          <p>Le menu est conçu pour le partage. Les plats sont commandés au fil du repas et arrivent quand ils sont prêts. Pas de précipitation, pas de structure, pas de formalités. Juste la Méditerranée dans l'assiette.</p>
          <h2>Comment Ça Marche</h2>
          <p>La table est en mode partage. Commandez quelques plats pour le centre, ajoutez au fur et à mesure. Poisson grillé, légumes du marché, charcuterie, dips, pains plats — le menu change chaque semaine selon ce que les producteurs et le jardin ont à offrir.</p>
          <p>Le rosé est servi au verre ou à la bouteille. La sélection de vins privilégie les environs immédiats : Bellet, Côtes de Provence, et l'occasionnelle curiosité naturelle d'un vignoble voisin.</p>
        </div>
        <div class="lgn-details">
          <p class="lgn-details-label">Informations Pratiques</p>

          <div class="lgn-details-block">
            <h3>Saison</h3>
            <p>Ouvert toute l'année</p>
            <p>Selon la météo</p>
          </div>

          <div class="lgn-details-block">
            <h3>Horaires</h3>
            <p>Déjeuner : 12h00 – 15h00</p>
            <p>Boissons & en-cas : 15h00 – 18h00</p>
          </div>

          <div class="lgn-details-block">
            <h3>Réservation</h3>
            <p>Recommandée, surtout le week-end.</p>
            <p>Ouvert aux hôtes de l'hôtel et aux visiteurs extérieurs.</p>
          </div>

          <div class="lgn-details-block lgn-details-cta">
            <a href="https://bookings.zenchef.com/results?rid=375927&pid=1001&lang=fr" target="_blank" rel="noopener noreferrer" data-zc-action="open" class="lgn-btn">Réserver une Table</a>
          </div>

          <div class="lgn-details-block">
            <h3>Bon à Savoir</h3>
            <p>Les plats se commandent au fil du repas — pas besoin de tout commander d'un coup.</p>
            <p>Style partage. Pas d'assiettes individuelles sauf sur demande.</p>
            <p>Pieds nus bienvenus. Maillot de bain avec un paréo, c'est très bien.</p>
          </div>

          <div class="lgn-details-block">
            <h3>Adresse</h3>
            <p>Toile Blanche — Jardin de la Piscine</p>
            <p>826, chemin de la Pounchounière</p>
            <p>06570 Saint-Paul de Vence</p>
            <p>France</p>
          </div>

          <div class="lgn-details-block">
            <h3>Contact</h3>
            <a href="tel:+33493327421" class="lgn-details-link">+33 4 93 32 74 21</a>
            <a href="mailto:guinguette@toileblanche.com" class="lgn-details-link">guinguette@toileblanche.com</a>
          </div>
        </div>
      </div>
    </section>

    <!-- LA CARTE -->
    <section class="lgn-menu">
      <div class="lgn-menu-inner">
        <p class="lgn-menu-label">{menu.meta.season[lang]}</p>
        <h2>La Carte</h2>
        <p class="lgn-menu-intro">{menu.meta.philosophy[lang]}</p>

        {menu.sections.map(section => (
          <div class="lgn-menu-section">
            <h3>{section.title[lang]}</h3>
            {section.items.map(item => (
              <div class="lgn-menu-item">
                <p class="lgn-menu-dish">{item[lang]}</p>
                <span class="lgn-menu-price">{item.price}€</span>
              </div>
            ))}
          </div>
        ))}

        <p class="lgn-menu-note">{menu.footer_note[lang]}</p>
      </div>
    </section>

    <!-- GALLERY (masonry, bon-vivant style) -->
    <section class="lgn-gallery">
      <div class="lgn-gallery-item">
        <img src="/assets/images/guinguette/IMG_9122.jpg" srcset={gallerySrcset('/assets/images/guinguette/IMG_9122.jpg')} sizes="(max-width: 900px) 100vw, 50vw" width="3024" height="4032" alt="Plats à partager à La Guinguette" loading="lazy" />
      </div>
      <div class="lgn-gallery-item">
        <img src="/assets/images/guinguette/IMG_7301.jpg" srcset={gallerySrcset('/assets/images/guinguette/IMG_7301.jpg')} sizes="(max-width: 900px) 100vw, 50vw" width="4032" height="3024" alt="Déjeuner au bord de la piscine à Toile Blanche" loading="lazy" />
      </div>
      <div class="lgn-gallery-item">
        <img src="/assets/images/guinguette/IMG_7094.jpg" srcset={gallerySrcset('/assets/images/guinguette/IMG_7094.jpg')} sizes="(max-width: 900px) 100vw, 50vw" alt="Cadre du jardin à La Guinguette" loading="lazy" />
      </div>
      <div class="lgn-gallery-item">
        <img src="/assets/images/guinguette/IMG_8142.jpg" srcset={gallerySrcset('/assets/images/guinguette/IMG_8142.jpg')} sizes="(max-width: 900px) 100vw, 50vw" alt="Déjeuner en plein air à La Guinguette" loading="lazy" />
      </div>
      <div class="lgn-gallery-item">
      </div>
      <div class="lgn-gallery-item">
        <img src="/assets/images/guinguette/IMG_4191.jpg" srcset={gallerySrcset('/assets/images/guinguette/IMG_4191.jpg')} sizes="(max-width: 900px) 100vw, 50vw" alt="Plats à partager à La Guinguette" loading="lazy" />
      </div>
      <div class="lgn-gallery-item">
        <img src="/assets/images/guinguette/IMG_7092.jpg" srcset={gallerySrcset('/assets/images/guinguette/IMG_7092.jpg')} sizes="(max-width: 900px) 100vw, 50vw" alt="La Guinguette au bord de la piscine" loading="lazy" />
      </div>
      <div class="lgn-gallery-item">
        <img src="/assets/images/guinguette/IMG_7104.jpg" srcset={gallerySrcset('/assets/images/guinguette/IMG_7104.jpg')} sizes="(max-width: 900px) 100vw, 50vw" alt="Déjeuner au jardin à Toile Blanche" loading="lazy" />
      </div>
      <div class="lgn-gallery-item">
        <img src="/assets/images/guinguette/DSCF0310.JPG" srcset={gallerySrcset('/assets/images/guinguette/DSCF0310.JPG')} sizes="(max-width: 900px) 100vw, 50vw" alt="Déjeuner au bord de la piscine" loading="lazy" />
      </div>
      <div class="lgn-gallery-item">
        <img src="/assets/images/guinguette/DSCF0327.JPG" srcset={gallerySrcset('/assets/images/guinguette/DSCF0327.JPG')} sizes="(max-width: 900px) 100vw, 50vw" alt="Terrasse de La Guinguette" loading="lazy" />
      </div>
      <div class="lgn-gallery-item">
        <img src="/assets/images/guinguette/DSCF0438.JPG" srcset={gallerySrcset('/assets/images/guinguette/DSCF0438.JPG')} sizes="(max-width: 900px) 100vw, 50vw" alt="Plats à partager méditerranéens" loading="lazy" />
      </div>
      <div class="lgn-gallery-item">
        <img src="/assets/images/guinguette/DSCF0486.JPG" srcset={gallerySrcset('/assets/images/guinguette/DSCF0486.JPG')} sizes="(max-width: 900px) 100vw, 50vw" alt="Déjeuner à La Guinguette" loading="lazy" />
      </div>
      <div class="lgn-gallery-item">
        <img src="/assets/images/guinguette/DSCF4164.JPG" srcset={gallerySrcset('/assets/images/guinguette/DSCF4164.JPG')} sizes="(max-width: 900px) 100vw, 50vw" alt="Table au jardin à Toile Blanche" loading="lazy" />
      </div>
      <div class="lgn-gallery-item">
        <img src={encodePath('/assets/images/guinguette/DSCF4327 2.JPG')} srcset={gallerySrcset('/assets/images/guinguette/DSCF4327 2.JPG')} sizes="(max-width: 900px) 100vw, 50vw" alt="Ambiance au bord de la piscine" loading="lazy" />
      </div>
      <div class="lgn-gallery-item">
        <img src="/assets/images/guinguette/IMG_9320.jpg" srcset={gallerySrcset('/assets/images/guinguette/IMG_9320.jpg')} sizes="(max-width: 900px) 100vw, 50vw" alt="Dîner à partager" loading="lazy" />
      </div>
      <div class="lgn-gallery-item">
        <img src="/assets/images/guinguette/IMG_9344.jpg" srcset={gallerySrcset('/assets/images/guinguette/IMG_9344.jpg')} sizes="(max-width: 900px) 100vw, 50vw" alt="Jardin de La Guinguette" loading="lazy" />
      </div>
      <div class="lgn-gallery-item">
        <img src="/assets/images/guinguette/guinguette-dessert.jpg" srcset={gallerySrcset('/assets/images/guinguette/guinguette-dessert.jpg')} sizes="(max-width: 900px) 100vw, 50vw" alt="Dessert citron déconstruit, meringue et zeste d'agrume en terrasse" loading="lazy" />
      </div>
    </section>

    <!-- PHILOSOPHY -->
    <section class="lgn-quote">
      <div class="lgn-quote-inner">
        <h2>Le déjeuner a duré trois heures. Personne ne s'en est rendu compte. Le rosé était frais, le poisson entier, et l'après-midi n'avait aucun programme.</h2>
      </div>
    </section>

    <!-- CTA -->
    <section class="lgn-cta">
      <p>Une table sous les arbres vous attend.</p>
      <a href="https://bookings.zenchef.com/results?rid=375927&pid=1001&lang=fr" target="_blank" rel="noopener noreferrer" data-zc-action="open" class="lgn-cta-btn">Réserver une Table</a>
    </section>
  </main>

  <Footer locale="fr" />
</Layout>

<script type="application/ld+json" is:inline>
