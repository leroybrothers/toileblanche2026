---
/**
 * Renders a <picture> with AVIF, WebP, and JPEG fallback for gallery/hero images.
 * Requires -600w, -800w, -1200w variants and their .webp/.avif (run optimize-gallery-webp.mjs).
 */
import { srcset, srcsetWebp, srcsetAvif } from '../utils/images';

export interface Props {
  src: string;
  sizes: string;
  alt: string;
  width?: number;
  height?: number;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  class?: string;
  /** Hero uses [800, 1200], gallery uses [600, 1200] */
  widths?: [number, number];
}

const {
  src,
  sizes,
  alt,
  width,
  height,
  loading = 'lazy',
  fetchpriority,
  class: className,
  widths = [600, 1200],
} = Astro.props;

const [w1] = widths;
const jpgSrcset = srcset(src, widths);
const webpSrcset = srcsetWebp(src, widths);
const avifSrcset = srcsetAvif(src, widths);
const base = src.substring(0, src.lastIndexOf('.'));
const ext = src.substring(src.lastIndexOf('.'));
const fallbackSrc = `${base}-${w1}w${ext}`;
---

<picture>
  <source type="image/avif" srcset={avifSrcset} sizes={sizes} />
  <source type="image/webp" srcset={webpSrcset} sizes={sizes} />
  <img
    src={fallbackSrc}
    srcset={jpgSrcset}
    sizes={sizes}
    alt={alt}
    width={width}
    height={height}
    loading={loading}
    fetchpriority={fetchpriority}
    class={className}
    decoding="async"
  />
</picture>