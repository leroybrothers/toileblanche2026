        <img src={encodePath('/assets/images/restaurant/restaurantgallery/DSCF6204 2.JPG')} srcset={gallerySrcset('/assets/images/restaurant/restaurantgallery/DSCF6204 2.JPG')} sizes="(max-width: 900px) 100vw, 50vw" width="1200" height="800" alt="Evening at Le Restaurant" loading="lazy" />
      </div>
      <div class="lrs-gallery-item">
        <img src="/assets/images/restaurant/restaurantgallery/resto1.jpg" width="1200" height="800" alt="Le Restaurant" loading="lazy" />
      </div>
      <div class="lrs-gallery-item">
        <img src="/assets/images/restaurant/restaurantgallery/resto2.JPG" width="1200" height="800" alt="Le Restaurant" loading="lazy" />
      </div>
      <div class="lrs-gallery-item">
        <img src="/assets/images/restaurant/restaurantgallery/resto3.jpg" width="1200" height="800" alt="Le Restaurant" loading="lazy" />
      </div>
      <div class="lrs-gallery-item">
        <img src="/assets/images/restaurant/restaurantgallery/resto4.jpg" width="1200" height="800" alt="Le Restaurant" loading="lazy" />
      </div>
      <div class="lrs-gallery-item">
        <img src="/assets/images/restaurant/restaurantgallery/resto5.jpg" width="1200" height="800" alt="Le Restaurant" loading="lazy" />
      </div>
      <div class="lrs-gallery-item">
        <img src="/assets/images/restaurant/restaurantgallery/resto6.jpg" width="1200" height="800" alt="Le Restaurant" loading="lazy" />
      </div>
      <div class="lrs-gallery-item">
        <img src="/assets/images/restaurant/restaurantgallery/resto7.jpg" width="1200" height="800" alt="Le Restaurant" loading="lazy" />
      </div>
      <div class="lrs-gallery-item">
