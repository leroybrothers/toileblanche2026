---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
---

<Layout
  title="Gift Vouchers | Toile Blanche | Saint-Paul de Vence"
  description="Give the gift of Toile Blanche. Gift vouchers — a stay, a dinner, or the freedom to choose."
>
  <Nav theme="light" />

  <main id="main-content">
    <!-- HEADER -->
    <section class="gft-header">
      <div class="gft-header-inner">
        <p class="gft-header-eyebrow">Gifting</p>
        <h1>Gift Vouchers</h1>
        <p class="gft-header-tagline">A stay inside the artwork. A dinner under the plane trees. Or the freedom to choose. Toile Blanche gift vouchers are delivered digitally and valid for twelve months.</p>
      </div>
    </section>

    <!-- UBILIZ WIDGET (script must follow the target div — nested scripts often fail to initialise) -->
    <section class="gft-widget">
      <div class="gft-widget-inner">
        <div class="ubiliz-offers-widget" data-url="https://app.ubiliz.com/widget/liste-bons/4788"></div>
        <script is:inline src="https://app.ubiliz.com/widget/widget.js"></script>
        <p class="gft-widget-direct">
          <a href="https://giftvouchers.toileblanche.com/" target="_blank" rel="noopener noreferrer">Open the gift voucher boutique, full catalogue on our storefront.</a>
        </p>
        <p class="gft-widget-fallback">If the widget doesn't load, <a href="mailto:info@toileblanche.com?subject=Gift%20Voucher%20Enquiry">contact us</a> for gift vouchers.</p>
      </div>
    </section>

    <!-- HOW IT WORKS -->
    <section class="gft-how">
      <div class="gft-how-inner">
        <p class="gft-how-label">How It Works</p>
        <div class="gft-how-grid">
          <div class="gft-how-step">
            <span class="gft-how-num">01</span>
            <h3>Choose</h3>
            <p>Select a voucher from the options above — a specific experience or a monetary value.</p>
          </div>
          <div class="gft-how-step">
            <span class="gft-how-num">02</span>
            <h3>Personalise</h3>
            <p>Add a personal message. The voucher is generated as a beautifully designed PDF.</p>
          </div>
          <div class="gft-how-step">
            <span class="gft-how-num">03</span>
            <h3>Send</h3>
            <p>Delivered instantly by email — to you or directly to the recipient.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="gft-cta">
      <p>For bespoke gifting or corporate enquiries:</p>
      <a href="mailto:info@toileblanche.com?subject=Gift%20Voucher%20Enquiry" class="gft-cta-link">Contact us directly &rarr;</a>
    </section>
  </main>

  <Footer />

</Layout>

<style>
  /* ─── HEADER ─── */
  .gft-header {
    padding: 200px 80px 80px;
    border-bottom: 1px solid #E2D9CC;
  }
  .gft-header-inner {
    max-width: 800px;
  }
  .gft-header-eyebrow {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #9C9080;
    margin-bottom: 24px;
  }
  .gft-header h1 {
    font-family: 'Gilda Display', serif;
    font-size: clamp(48px, 7vw, 96px);
    font-weight: 400;
    line-height: 1.0;
    color: #1C1917;
    margin-bottom: 32px;
  }
  .gft-header-tagline {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 16px;
    line-height: 1.7;
    color: #6B6256;
    max-width: 560px;
  }

  /* ─── WIDGET ─── */
  .gft-widget {
    border-bottom: 1px solid #E2D9CC;
  }
  .gft-widget-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 80px;
  }
  .ubiliz-offers-widget {
    min-height: 320px;
  }
  .gft-widget-direct {
    margin-top: 28px;
    font-family: 'Didact Gothic', sans-serif;
    font-size: 13px;
    line-height: 1.55;
    font-weight: 400;
    color: #9C9080;
  }
  .gft-widget-direct a {
    color: #9e5c4a;
    font-size: inherit;
    font-weight: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .gft-widget-direct a:hover {
    opacity: 0.88;
  }
  .gft-widget-fallback {
    margin-top: 24px;
    font-family: 'Didact Gothic', sans-serif;
    font-size: 13px;
    color: #9C9080;
  }
  .gft-widget-fallback a {
    color: #9e5c4a;
    text-decoration: underline;
  }
  .gft-widget-fallback a:hover {
    opacity: 0.85;
  }

  /* ─── HOW IT WORKS ─── */
  .gft-how {
    border-bottom: 1px solid #E2D9CC;
  }
  .gft-how-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 80px;
  }
  .gft-how-label {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #9C9080;
    margin-bottom: 48px;
  }
  .gft-how-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 48px;
  }
  .gft-how-step {
    padding: 40px;
    background: rgba(226, 217, 204, 0.15);
  }
  .gft-how-num {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 11px;
    letter-spacing: 0.15em;
    color: #C4B9AA;
    display: block;
    margin-bottom: 20px;
  }
  .gft-how-step h3 {
    font-family: 'Gilda Display', serif;
    font-style: italic;
    font-size: 22px;
    color: #1C1917;
    margin-bottom: 12px;
  }
  .gft-how-step p {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 14px;
    line-height: 1.7;
    color: #6B6256;
  }

  /* ─── CTA ─── */
  .gft-cta {
    padding: 80px;
    text-align: center;
    border-bottom: 1px solid #E2D9CC;
  }
  .gft-cta p {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 16px;
    color: #6B6256;
    margin-bottom: 24px;
  }
  .gft-cta-link {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    color: #9e5c4a;
    border-bottom: 1px solid #9e5c4a;
    padding-bottom: 2px;
    transition: opacity 0.2s;
  }
  .gft-cta-link:hover {
    opacity: 0.7;
  }

  /* ─── RESPONSIVE ─── */
  @media (max-width: 900px) {
    .gft-header {
      padding: 140px 24px 48px;
    }
    .gft-widget-inner {
      padding: 48px 24px;
    }
    .gft-how-inner {
      padding: 48px 24px;
    }
    .gft-how-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .gft-cta {
      padding: 48px 24px;
    }
  }
</style>
