---
import { useTranslations, getLocaleFromPath, localePath, type Locale } from '../i18n/index';

export interface Props {
  locale?: Locale;
}
const locale = Astro.props.locale ?? getLocaleFromPath(Astro.url.pathname);
const t = useTranslations(locale);
const lp = (path: string) => localePath(path, locale);
const cntReadersChoiceUrl =
  'https://condenast-interactive.typeform.com/to/ECgybVMv?typeform-source=www.cntraveller.com';
---

<footer class="footer-section">
  <div class="footer-container">
    <div class="footer-wrapper">
      <div class="footer-top-row">
        <div class="footer-logo">
          <div class="footer-logo-text">
            <a href={lp('/')} class="footer-logo-link w-inline-block">
              <img src="/assets/images/63a19dacd6b229843a52a138_Toile%20Blanche%20Logo%202022%20black.avif" loading="lazy" alt="Toile Blanche" />
            </a>
            <p class="footer-tagline">{t.footer.tagline}</p>
            <p class="footer-stay-canvas">{t.footer.stayInCanvas}</p>
          </div>
          <div class="footer-social-links">
            <a href="https://www.instagram.com/toileblanche/" target="_blank" rel="noopener noreferrer" class="footer-social-link w-inline-block" aria-label={t.footer.instagramAriaLabel}>
              <img src="/assets/images/639af6c370637ac85ee3b0e7_Instagram_icon_48px.svg" loading="lazy" alt="" width="48" height="48" />
            </a>
            <span class="footer-social-link footer-michelin-key" aria-hidden="true">
              <img src="/assets/images/affiliations/michelin-key.png" alt="MICHELIN Key" width="48" height="48" loading="lazy" />
            </span>
            <a
              href="https://slh.com/hotels/toile-blanche"
              target="_blank"
              rel="noopener noreferrer"
              class="footer-social-link footer-slh w-inline-block"
              aria-label="Small Luxury Hotels of the World — Toile Blanche"
            >
              <img src="/assets/images/affiliations/logo-slh.svg" alt="" loading="lazy" class="footer-slh-img" />
            </a>
            <a
              href={cntReadersChoiceUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="footer-social-link footer-cnt-readers-choice w-inline-block"
              aria-label={t.nav.cntReadersChoiceAria}
            >
              <img
                src="/assets/images/affiliations/conde-nast-traveller-readers-choice.png"
                alt=""
                width="48"
                height="48"
                loading="lazy"
                class="footer-cnt-badge-img"
              />
            </a>
          </div>
        </div>

        <nav class="footer-menu" aria-label="Footer navigation - primary">
          <a href={lp('/suites')} class="footer-link">{t.nav.suites}</a>
          <a href={lp('/restaurants')} class="footer-link">{t.nav.restaurants}</a>
          <a href={lp('/art')} class="footer-link">{t.nav.theArt}</a>
          <a href={lp('/la-vie-ici')} class="footer-link">{t.nav.laVieIci}</a>
          <a href={lp('/experiences')} class="footer-link">{t.nav.experiences}</a>
          <a href={lp('/the-property')} class="footer-link">{t.nav.theProperty}</a>
        </nav>

        <nav class="footer-menu" aria-label="Footer navigation - secondary">
          <a href={lp('/about')} class="footer-link">{t.nav.about}</a>
          <a href={lp('/l-hiver')} class="footer-link">{t.nav.lHiver}</a>
          <a href={lp('/blog')} class="footer-link">{t.nav.archive}</a>
          <a href={lp('/press')} class="footer-link">{t.nav.press}</a>
          <a href={lp('/faq')} class="footer-link">{t.nav.faq}</a>
          <a
            href="https://leseminaire.toileblanche.com"
            class="footer-link"
            target="_blank"
            rel="noopener noreferrer"
          >{t.nav.seminaire}</a>
        </nav>

        <div class="footer-contact">
          <a href="tel:+33493327421" class="footer-contact-link w-inline-block">
            <img src="/assets/images/639af6c370637a66bae3b0e3_phone_icon.svg" loading="lazy" alt="Phone" class="footer-contact-icon" width="24" height="24" />
            <div>+33 4 93 32 74 21</div>
          </a>
          <a href="mailto:info@toileblanche.com" class="footer-contact-link w-inline-block">
            <img src="/assets/images/639af6c370637ab0a4e3b0e4_mail_icon.svg" loading="lazy" alt="Email" class="footer-contact-icon" width="24" height="24" />
            <div>info@toileblanche.com</div>
          </a>
          <a href="https://goo.gl/maps/VoKrme28X62qbvTk7" target="_blank" rel="noopener noreferrer" class="footer-contact-link w-inline-block">
            <img src="/assets/images/639af6c370637aaeb5e3b0e5_pin_icon.svg" loading="lazy" alt="Location" class="footer-contact-icon" width="24" height="24" />
            <div>826, chemin de la Pounchounière<br />06570 Saint-Paul de Vence<br />France</div>
          </a>
        </div>
      </div>

      <div class="footer-bottom-row">
        <nav class="footer-bottom-links" aria-label="Footer legal and utility links">
          <a href={lp('/travel-advisors')} class="footer-secondary-link">{t.nav.travelAdvisors}</a>
          <a href={lp('/careers')} class="footer-secondary-link">{t.nav.careers}</a>
          <a href={lp('/environmental-and-social-strategy')} class="footer-secondary-link">{t.footer.envStrategy}</a>
          <a href={lp('/booking-conditions')} class="footer-secondary-link">{t.footer.bookingConditions}</a>
          <a href={lp('/privacy-policy')} class="footer-secondary-link">{t.footer.privacyPolicy}</a>
          <a href={lp('/terms-of-use')} class="footer-secondary-link">{t.footer.termsOfUse}</a>
        </nav>
        <div>
          <div class="footer-secondary-link">© Toile Blanche {new Date().getFullYear()}</div>
        </div>
      </div>
    </div>
  </div>
</footer>
