---
import { useTranslations, getLocaleFromPath, localePath, type Locale } from '../i18n/index';

export interface Props {
  locale?: Locale;
}
const locale = Astro.props.locale ?? getLocaleFromPath(Astro.url.pathname);
const t = useTranslations(locale);
const lp = (path: string) => localePath(path, locale);
---

<footer class="footer-section">
  <div class="footer-container">
    <div class="footer-wrapper">
      <div class="footer-top-row">
        <div class="footer-logo">
          <div>
            <a href={lp('/')} class="footer-logo-link w-inline-block">
              <img src="/assets/images/63a19dacd6b229843a52a138_Toile%20Blanche%20Logo%202022%20black.avif" loading="lazy" alt="Toile Blanche" />
            </a>
            <p>{t.footer.tagline}</p>
          </div>
          <div class="footer-social-links">
            <a href="https://www.instagram.com/toileblanche/" target="_blank" rel="noopener noreferrer" class="footer-social-link w-inline-block">
              <img src="/assets/images/639af6c370637ac85ee3b0e7_Instagram_icon_48px.svg" loading="lazy" alt="Instagram" />
            </a>
          </div>
        </div>

        <nav class="footer-menu" aria-label="Footer navigation - primary">
          <a href={lp('/suites')} class="footer-link">{t.nav.suites}</a>
          <a href={lp('/restaurants')} class="footer-link">{t.nav.restaurants}</a>
          <a href={lp('/art')} class="footer-link">{t.nav.theArt}</a>
          <a href={lp('/experiences')} class="footer-link">{t.nav.experiences}</a>
        </nav>

        <nav class="footer-menu" aria-label="Footer navigation - secondary">
          <a href={lp('/about')} class="footer-link">{t.nav.about}</a>
          <a href={lp('/upcoming-events')} class="footer-link">{t.nav.events}</a>
          <a href={lp('/blog')} class="footer-link">{t.nav.archive}</a>
          <a href={lp('/press')} class="footer-link">{t.nav.press}</a>
        </nav>

        <div class="footer-contact">
          <a href="tel:+33493327421" class="footer-contact-link w-inline-block">
            <img src="/assets/images/639af6c370637a66bae3b0e3_phone_icon.svg" loading="lazy" alt="Phone" class="footer-contact-icon" />
            <div>+33 4 93 32 74 21</div>
          </a>
          <a href="mailto:info@toileblanche.com" class="footer-contact-link w-inline-block">
            <img src="/assets/images/639af6c370637ab0a4e3b0e4_mail_icon.svg" loading="lazy" alt="Email" class="footer-contact-icon" />
            <div>info@toileblanche.com</div>
          </a>
          <a href="https://goo.gl/maps/VoKrme28X62qbvTk7" target="_blank" rel="noopener noreferrer" class="footer-contact-link w-inline-block">
            <img src="/assets/images/639af6c370637aaeb5e3b0e5_pin_icon.svg" loading="lazy" alt="Location" class="footer-contact-icon" />
            <div>826, chemin de la Pounchounière<br />06570 Saint-Paul de Vence<br />France</div>
          </a>
        </div>
      </div>

      <div class="footer-bottom-row">
        <nav class="footer-bottom-links" aria-label="Footer legal and utility links">
          <a href={lp('/careers')} class="footer-secondary-link">{t.nav.careers}</a>
          <a href={lp('/environmental-and-social-strategy')} class="footer-secondary-link">{t.footer.envStrategy}</a>
          <a href={lp('/faq')} class="footer-secondary-link">{t.footer.faq}</a>
          <a href={lp('/booking-conditions')} class="footer-secondary-link">{t.footer.bookingConditions}</a>
          <a href={lp('/privacy-policy')} class="footer-secondary-link">{t.footer.privacyPolicy}</a>
          <a href={lp('/terms-of-use')} class="footer-secondary-link">{t.footer.termsOfUse}</a>
        </nav>
        <div>
          <div class="footer-secondary-link">© Toile Blanche {new Date().getFullYear()}</div>
        </div>
      </div>
    </div>
  </div>
</footer>
