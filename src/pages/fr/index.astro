---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import suitesData from '../../data/suites.fr.json';

function srcset(path: string, widths: number[]) {
  const ext = path.substring(path.lastIndexOf('.'));
  const base = path.substring(0, path.lastIndexOf('.'));
  return widths.map(w => `${base}-${w}w${ext} ${w}w`).join(', ') + `, ${path} ${widths[widths.length - 1] * 2}w`;
}

const suites = suitesData.suites.map(s => ({
  href: `/fr/suites/${s.slug}`,
  image: s.images.card,
  srcset: srcset(s.images.card, [400]),
  alt: s.images.cardAlt,
  title: s.name,
  description: s.tagline,
}));
---

<Layout
  locale="fr"
  title="Toile Blanche | Saint-Paul de Vence"
  description="22 suites, deux restaurants et une collection d'art contemporain à Saint-Paul de Vence. Une œuvre déclarée des Leroy Brothers sur la Côte d'Azur."
  ogImage="https://www.toileblanche.com/assets/images/slideshow1.jpg"
>
  <div class="loader" id="page-loader">
    <div class="loader-logo-wrapper">
      <img src="/assets/images/63a19dacd6b229843a52a138_Toile%20Blanche%20Logo%202022%20black.avif" loading="lazy" alt="Toile Blanche" />
      <div class="loader-line"></div>
    </div>
  </div>

  <main id="main-content">
  <header class="hero1" id="hero" style="opacity:0">
    <div class="hero-bg-wrapper hero-bg-parallax hero-bg-video">

      <!-- Desktop & tablet (≥ 769px) — landscape 16:9 -->
      <video
        class="hero-video hero-video--landscape"
        autoplay muted loop playsinline
        preload="auto"
        poster="/assets/videos/hero-landscape-poster.jpg"
        aria-label="Toile Blanche, Saint-Paul de Vence"
      >
        <source src="/assets/videos/hero-landscape.webm" type="video/webm">
        <source src="/assets/videos/hero-landscape.mp4" type="video/mp4">
      </video>

      <!-- Mobile (≤ 768px portrait) — portrait 9:16 (lazy loaded) -->
      <video
        class="hero-video hero-video--portrait"
        autoplay muted loop playsinline
        preload="none"
        poster="/assets/videos/hero-portrait-poster.jpg"
        aria-hidden="true"
      >
        <source src="/assets/videos/hero-portrait.webm" type="video/webm">
        <source src="/assets/videos/hero-portrait.mp4" type="video/mp4">
      </video>
    </div>
    <div class="hero-bg-overlay"></div>

    <Nav theme="both" locale="fr" />

    <div class="hero1-content-wrapper">
      <div class="hero1-content" id="hero-content">
        <h1 class="hero-headline light">La Côte d'Azur,<br />sans le spectacle.</h1>
        <div class="hero-second-line light">L'art n'est pas sur les murs — il est les murs.</div>
        <div class="hero-body light">Et le plaisir particulier de ne rien faire pendant quelques jours.</div>
        <div class="hero-cta-wrap">
          <a href="#" class="hero-cta distributor-open">Réserver</a>
        </div>
        <p class="hero-micro">Le meilleur tarif, priorité au surclassement et petit-déjeuner inclus pour toute réservation directe.</p>
        <div class="hero1-arrow">
          <img src="/assets/images/639af6c370637a631de3b0f3_big_arrow_down_light.svg" loading="lazy" alt="Défiler vers le bas" class="hero-arrow-image" id="hero-arrow" />
        </div>
      </div>
    </div>
  </header>

  <div class="section tb-intro-section">
    <div class="container">
      <div class="tb-intro-blocks">
        <div class="tb-intro-block">
          <h2 class="tb-intro-block-title">L'Histoire</h2>
          <p>Les Leroy Brothers — trois artistes — sont arrivés à Saint-Paul de Vence en 2004 avec trois chambres et une vision à long terme.</p>
          <p>En vingt ans, ils ont racheté les maisons voisines une par une — à des voisins devenus amis. Puis, quand le moment fut venu, ils se sont arrêtés et ont construit la version qu'ils avaient toujours eue en tête.</p>
          <p>Le résultat est quelque chose de véritablement difficile à catégoriser.</p>
          <p>22 suites. Deux restaurants. Trois piscines. 20 000m² de jardins. Saint-Paul de Vence.</p>
        </div>
        <div class="tb-intro-block">
          <h2 class="tb-intro-block-title">Le Ressenti</h2>
          <p>Toile Blanche se situe en lisière de Saint-Paul de Vence — le village qui a donné au monde la Fondation Maeght, qui a abrité Picasso, Chagall et Calder — et prend cette responsabilité au sérieux.</p>
          <p>Mais pas au sérieux d'une manière qui vous fait sentir observé. La piscine est chaude. Le rosé est frais. L'art vous fera vous arrêter et réfléchir, puis vous retournerez à la piscine.</p>
          <p>C'est tout le propos.</p>
        </div>
      </div>
    </div>
  </div>

  <div class="section tb-suites-section overlap-section-top">
    <div class="home-room-slider-wrapper">
      <div class="home-room-slider js-slider" id="suites-slider" role="region" aria-label="Galerie des suites">
        <div class="home-room-mask js-slider-track">
          {suites.map((suite, i) => (
            <div class={`home-room-single-slide js-slide${suite.href === '/fr/suites/mas-artiste' ? ' room-slide-masartiste' : ''}`} data-slide-index={i} role="group" aria-label={`${i + 1} sur ${suites.length}`}>
              <a href={suite.href} class="room-slide-wrapper w-inline-block">
                <div class="room-slide-image-wrapper">
                  <div class="room-slide-image-container">
                    <img loading="lazy" alt={suite.alt} src={suite.image} srcset={suite.srcset} sizes="(max-width: 900px) 80vw, 33vw" class="room-slide-image" />
                  </div>
                </div>
                <div class="room-slide-content-wrapper">
                  <div class="room-slide-title">
                    <h2 class="light">{suite.title}</h2>
                  </div>
                  <div class="room-slide-description">
                    <p class="light">{suite.description}</p>
                  </div>
                </div>
              </a>
            </div>
          ))}
        </div>
      </div>
      <div class="room-slider-dots" aria-label="Navigation des slides">
        {suites.map((_, i) => (
          <button type="button" class="room-slider-dot js-slider-dot" data-index={i} aria-label={`Aller au slide ${i + 1}`} aria-current={i === 0 ? 'true' : undefined} />
        ))}
      </div>
    </div>
    <div class="suites-view-all-link">
      <a href="/fr/suites" class="suites-view-all-btn">Voir toutes les suites</a>
    </div>
  </div>

  <div class="section top-padding-192">
    <div class="container">
      <div class="tb-three-blocks">
        <div class="tb-feature-block">
          <div class="tb-feature-block-image">
            <img src="/assets/images/677ce5a0ffdffd79d9f89e13_Aerts 6 (1)-p-1600.jpg" loading="lazy" width="524" sizes="(max-width: 767px) 100vw, 524px" alt="Art contemporain à Toile Blanche" />
          </div>
          <div class="tb-feature-block-content">
            <h2>Art</h2>
            <p>Les œuvres de Toile Blanche sont choisies, pas accumulées. Chaque pièce a été sélectionnée par les Leroy Brothers — qui sont eux-mêmes artistes — en conversation avec ceux qui les ont créées. La collection couvre la peinture, la sculpture, la photographie et l'installation. Elle change. De nouvelles œuvres arrivent chaque saison.</p>
            <p>Revenir plus d'une fois, c'est découvrir une conversation différente avec les mêmes chambres.</p>
            <a href="/fr/art" class="button secondary w-button">Découvrir l'art</a>
          </div>
        </div>

        <div class="tb-feature-block tb-feature-block--reverse">
          <div class="tb-feature-block-image">
            <img src="/assets/images/twotable2.jpg" loading="lazy" width="524" sizes="(max-width: 767px) 100vw, 524px" alt="Restaurants de Toile Blanche" />
          </div>
          <div class="tb-feature-block-content">
            <h2>Deux tables qui valent le détour</h2>
            <p>La Guinguette, c'est le déjeuner sous les platanes — rosé, poisson grillé, le plaisir spécifique de manger dehors en Provence. Le Restaurant, c'est la version du soir : plus attentionné, plus intime, la cuisine à son plein potentiel. Les deux menus sont construits autour de ce qui est de saison, local et honnête.</p>
            <a href="/fr/restaurants" class="button secondary w-button">Réserver une table</a>
          </div>
        </div>

        <div class="tb-feature-block">
          <div class="tb-feature-block-image">
            <img src="/assets/images/Experiences.jpg" loading="lazy" width="524" sizes="(max-width: 767px) 100vw, 524px" alt="Expériences à Toile Blanche" />
          </div>
          <div class="tb-feature-block-content">
            <h2>La vie à Toile Blanche</h2>
            <p>Saint-Paul de Vence est à trois minutes à pied. La Fondation Maeght à cinq. Au-delà — visites d'ateliers, la Route de l'Art, la vallée à vélo, et le plaisir particulier de ne rien faire de tout cela.</p>
            <a href="/fr/experiences" class="button secondary w-button">Explorer les expériences</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="section no-bottom-padding no-top-padding">
    <div class="subhero-section">
      <div class="container">
        <div class="booking-button-wrapper">
          <div class="button-row space-around">
            <button type="button" data-zc-action="open" class="button secondary w-button">Réserver ma table</button>
            <a href="#" class="button secondary w-button distributor-open">Réserver ma suite</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="section no-bottom-padding no-top-padding">
    <div class="full-frame-image-wrapper homepage-one"></div>
  </div>

  <!-- Avantage Réservation Directe -->
  <section class="tb-direct-privilege">
    <h2 class="tb-dp-headline">Réservez à la Source.</h2>
    <p class="tb-dp-intro">Réservez votre séjour directement auprès de Toile Blanche pour une expérience plus personnelle et les meilleures conditions.</p>
    <div class="tb-dp-grid">
      <div class="tb-dp-item">
        <p class="tb-dp-label">Le Meilleur Tarif Garanti</p>
        <p class="tb-dp-desc">Le tarif le plus avantageux ne se trouve qu'ici.</p>
      </div>
      <div class="tb-dp-item">
        <p class="tb-dp-label">Priorité au Surclassement</p>
        <p class="tb-dp-desc">Nos clients directs sont prioritaires pour les surclassements de suite.</p>
      </div>
      <div class="tb-dp-item">
        <p class="tb-dp-label">Petit-Déjeuner Inclus</p>
        <p class="tb-dp-desc">Notre rituel provençal du matin est toujours offert.</p>
      </div>
    </div>
    <div class="tb-dp-cta-wrap">
      <a href="#" class="tb-dp-cta distributor-open">Réserver Ma Suite</a>
    </div>
  </section>

  <div class="section padding-96 bg-color-2">
    <div class="container">
      <div class="tb-newsletter">
        <div class="tb-newsletter-content">
          <h2 class="tb-newsletter-title">Le Journal Toile Blanche.<br />Pas trop souvent. Juste assez.</h2>
          <p class="tb-newsletter-desc">Les nouvelles de Saint-Paul de Vence — nouveautés dans la collection, ce qui est à table cette saison, et ce qu'il faut savoir avant de venir.</p>
          <p class="tb-newsletter-cta">Rejoignez 2 000 personnes qui savent déjà.</p>
        </div>
        <div class="tb-newsletter-form-wrap">
          <form id="newsletter-form" class="tb-newsletter-form">
            <div class="tb-newsletter-row">
              <div class="tb-newsletter-field">
                <label for="nl-first">Prénom</label>
                <input id="nl-first" name="firstName" type="text" placeholder="Prénom" maxlength="256" required />
              </div>
              <div class="tb-newsletter-field">
                <label for="nl-last">Nom</label>
                <input id="nl-last" name="lastName" type="text" placeholder="Nom" maxlength="256" required />
              </div>
              <div class="tb-newsletter-field">
                <label for="nl-email">Adresse email</label>
                <input id="nl-email" name="email" type="email" placeholder="Adresse email" maxlength="256" required />
              </div>
              <button type="submit" class="tb-newsletter-submit">Rester en contact</button>
            </div>
          </form>
          <p class="tb-newsletter-msg tb-newsletter-success" aria-live="polite">Merci. Vous êtes inscrit(e).</p>
          <p class="tb-newsletter-msg tb-newsletter-error" aria-live="polite">Une erreur est survenue. Veuillez réessayer.</p>
          <p class="tb-newsletter-legal">En vous abonnant au Journal Toile Blanche, vous acceptez notre <a href="/fr/privacy-policy">politique de confidentialité</a></p>
        </div>
      </div>
    </div>
  </div>

  <div class="divider _96px"></div>

  <Footer locale="fr" />
  </main>
</Layout>

<script is:inline>
(function () {
  var form = document.getElementById('newsletter-form');
  if (!form) return;

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    var wrap = form.closest('.tb-newsletter-form-wrap');
    var btn = form.querySelector('.tb-newsletter-submit');
    var data = new FormData(form);

    wrap.classList.remove('is-error');
    btn.classList.add('is-sending');
    btn.textContent = '…';

    fetch('/api/newsletter', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        email: data.get('email'),
        firstName: data.get('firstName'),
        lastName: data.get('lastName')
      })
    })
      .then(function (res) {
        if (!res.ok) throw new Error(res.status);
        wrap.classList.add('is-success');
      })
      .catch(function () {
        wrap.classList.add('is-error');
        btn.classList.remove('is-sending');
        btn.textContent = 'Rester en contact';
      });
  });
})();
</script>
