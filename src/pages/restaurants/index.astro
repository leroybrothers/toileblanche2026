"/assets/images/page-img-eb795e7700a147.jpg"/></div><div class="collection-content-wrapper"><div class="subtitle italics">Suite Pénard</div><img alt="" class="collection-arrow-img" loading="lazy" src="/assets/images/page-img-a926ac09f8f7bc.svg"/></div></a></div><div class="room-item w-dyn-item" role="listitem"><a class="room-link-block w-inline-block" href="suites/bonvivant.html"><div class="collection-image-wrapper"><img alt="Suite du Bon-Vivant" class="image-cover" loading="lazy" sizes="(max-width: 479px) 90vw, (max-width: 767px) 27vw, (max-width: 991px) 28vw, (max-width: 1439px) 29vw, 26vw" src="/assets/images/page-img-707417a43d47ee.jpg"/></div><div class="collection-content-wrapper"><div class="subtitle italics">Suite du Bon-Vivant</div><img alt="" class="collection-arrow-img" loading="lazy" src="/assets/images/page-img-a926ac09f8f7bc.svg"/></div></a></div><div class="room-item w-dyn-item" role="listitem"><a class="room-link-block w-inline-block" href="suites/suiteaartiste.html"><div class="collection-image-wrapper"><img alt="Suite de l'Artiste" class="image-cover" loading="lazy" sizes="(max-width: 479px) 90vw, (max-width: 767px) 27vw, (max-width: 991px) 28vw, (max-width: 1439px) 29vw, 26vw" src="/assets/images/page-img-e1708f1e9761a9.jpg"/></div><div class="collection-content-wrapper"><div class="subtitle italics">Suite de l'Artiste</div><img alt="" class="collection-arrow-img" loading="lazy" src="/assets/images/page-img-a926ac09f8f7bc.svg"/></div></a></div></div></div></div>

