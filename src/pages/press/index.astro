---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const reviews = [
  {
    publication: "Condé Nast Traveller",
    quote: "A place where the boundary between hotel and gallery has been quietly dissolved.",
    year: "2025",
  },
  {
    publication: "Vogue Living",
    quote: "The Leroy Brothers have turned hospitality into a medium. Every suite is a composition.",
    year: "2025",
  },
  {
    publication: "Le Figaro",
    quote: "Saint-Paul de Vence retrouve son statut de village d'artistes — grâce, en partie, à Toile Blanche.",
    year: "2024",
  },
  {
    publication: "Financial Times — HTSI",
    quote: "Not a hotel with art in it. An artwork you can sleep in.",
    year: "2024",
  },
  {
    publication: "Monocle",
    quote: "Twenty-two suites, two restaurants, and something that resists easy categorisation.",
    year: "2024",
  },
  {
    publication: "AD Magazine",
    quote: "Un domaine où chaque mur, chaque jardin, chaque angle de lumière a été pensé comme une œuvre.",
    year: "2023",
  },
  {
    publication: "Wallpaper*",
    quote: "The new wave of art hotels owes something to what the Leroy Brothers built in Provence.",
    year: "2023",
  },
  {
    publication: "Elle Décoration",
    quote: "Toile Blanche prouve que l'hôtellerie de luxe peut être un acte de création contemporaine.",
    year: "2023",
  },
];

const clippings = [
  "/assets/images/page-img-37ea194b426b81.avif",
  "/assets/images/page-img-c2b446ef508aab.avif",
  "/assets/images/page-img-50b2a4b9fbb1fb.avif",
  "/assets/images/page-img-64a0c95ea55a98.avif",
  "/assets/images/page-img-fdf7aa86015b84.avif",
  "/assets/images/page-img-a1596d1ce42090.avif",
  "/assets/images/page-img-76f83587fddfbf.avif",
  "/assets/images/page-img-db052c2e4f8e09.avif",
  "/assets/images/page-img-8f223a02b060d9.avif",
  "/assets/images/page-img-4eb937b727508c.avif",
  "/assets/images/page-img-731ea094798e2d.avif",
  "/assets/images/page-img-5120e0a8348fed.avif",
  "/assets/images/page-img-e7cc42e5c98c03.avif",
  "/assets/images/page-img-23693318da54c4.avif",
  "/assets/images/page-img-fba9bab5d8fc93.avif",
  "/assets/images/page-img-9b12f920448ad3.avif",
  "/assets/images/page-img-6b3e1d28470db9.avif",
];
---

<Layout
  title="Press | Toile Blanche | Saint-Paul de Vence"
  description="Records of recognition. Press coverage and media enquiries for Toile Blanche, Saint-Paul de Vence."
>
  <Nav theme="both" />

  <main>
    <!-- HEADER -->
    <section class="prs-header">
      <div class="prs-header-inner">
        <p class="prs-header-eyebrow">Records of Recognition</p>
        <h1>Press</h1>
        <p class="prs-header-tagline">A curated archive of the critical reception. Toile Blanche was declared a work by the Leroy Brothers in 2026. The following is a record of how the world received it — before and after.</p>
      </div>
    </section>

    <!-- REVIEW LOG -->
    <section class="prs-reviews">
      <div class="prs-reviews-inner">
        <p class="prs-reviews-label">The Review Log</p>
        {reviews.map((r) => (
          <div class="prs-review">
            <div class="prs-review-head">
              <span class="prs-review-pub">{r.publication}</span>
              <span class="prs-review-year">{r.year}</span>
            </div>
            <p class="prs-review-quote">"{r.quote}"</p>
          </div>
        ))}
      </div>
    </section>

    <!-- MEDIA KIT -->
    <section class="prs-kit">
      <div class="prs-kit-inner">
        <div class="prs-kit-text">
          <p class="prs-kit-label">Media Kit</p>
          <h2>For Journalists &amp; Editors</h2>
          <p>High-resolution photography, the brand book, fact sheet, floor plans, and approved copy. Everything you need in one download.</p>
        </div>
        <div class="prs-kit-actions">
          <a href="mailto:press@toileblanche.com?subject=Media%20Kit%20Request" class="prs-kit-btn">Request the Media Kit</a>
          <p class="prs-kit-note">Sent within 24 hours as a secure link.</p>
        </div>
      </div>
    </section>

    <!-- PRESS CONTACTS -->
    <section class="prs-contacts">
      <div class="prs-contacts-inner">
        <p class="prs-contacts-label">Press Contacts</p>
        <div class="prs-contacts-grid">
          <div class="prs-contact">
            <h3>France</h3>
            <p class="prs-contact-agency"><a href="https://www.pascalevenot.fr/" target="_blank" rel="noopener noreferrer">Pascale Venot</a></p>
            <a href="mailto:audebanou@pascalevenot.fr" class="prs-contact-email">audebanou@pascalevenot.fr</a>
          </div>
          <div class="prs-contact">
            <h3>UK / US</h3>
            <p class="prs-contact-agency"><a href="https://www.re-agency.com/" target="_blank" rel="noopener noreferrer">Re-Agency</a></p>
            <a href="mailto:toileblanche@re-agency.com" class="prs-contact-email">toileblanche@re-agency.com</a>
          </div>
          <div class="prs-contact">
            <h3>General Enquiries</h3>
            <p class="prs-contact-agency">Toile Blanche</p>
            <a href="mailto:press@toileblanche.com" class="prs-contact-email">press@toileblanche.com</a>
          </div>
        </div>
      </div>
    </section>

    <!-- CLIPPINGS ARCHIVE -->
    <section class="prs-clippings">
      <div class="prs-clippings-inner">
        <p class="prs-clippings-label">Clippings Archive</p>
        <div class="prs-clippings-grid">
          {clippings.map((src, i) => (
            <div class="prs-clipping">
              <img src={src} alt={`Press clipping ${i + 1}`} loading="lazy" />
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* ─── HEADER ─── */
  .prs-header {
    padding: 200px 80px 80px;
    border-bottom: 1px solid #E2D9CC;
  }
  .prs-header-inner {
    max-width: 800px;
  }
  .prs-header-eyebrow {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #9C9080;
    margin-bottom: 24px;
  }
  .prs-header h1 {
    font-family: 'Gilda Display', serif;
    font-size: clamp(48px, 7vw, 96px);
    font-weight: 400;
    line-height: 1.0;
    color: #1C1917;
    margin-bottom: 32px;
  }
  .prs-header-tagline {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 16px;
    line-height: 1.7;
    color: #6B6256;
    max-width: 600px;
  }

  /* ─── REVIEW LOG ─── */
  .prs-reviews {
    border-bottom: 1px solid #E2D9CC;
  }
  .prs-reviews-inner {
    max-width: 900px;
    margin: 0 auto;
    padding: 80px;
  }
  .prs-reviews-label {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #9C9080;
    margin-bottom: 48px;
  }
  .prs-review {
    padding: 40px 0;
    border-bottom: 1px solid rgba(226, 217, 204, 0.5);
  }
  .prs-review:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }
  .prs-review-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 16px;
  }
  .prs-review-pub {
    font-family: 'Gilda Display', serif;
    font-style: italic;
    font-size: 14px;
    color: #9C9080;
  }
  .prs-review-year {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 11px;
    color: #C4B9AA;
  }
  .prs-review-quote {
    font-family: 'Gilda Display', serif;
    font-size: clamp(20px, 2.5vw, 28px);
    line-height: 1.45;
    color: #1C1917;
  }

  /* ─── MEDIA KIT ─── */
  .prs-kit {
    border-bottom: 1px solid #E2D9CC;
  }
  .prs-kit-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 80px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }
  .prs-kit-label {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #9C9080;
    margin-bottom: 20px;
  }
  .prs-kit-text h2 {
    font-family: 'Gilda Display', serif;
    font-size: clamp(28px, 3vw, 40px);
    font-weight: 400;
    color: #1C1917;
    margin-bottom: 20px;
  }
  .prs-kit-text > p:last-child {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 16px;
    line-height: 1.7;
    color: #6B6256;
  }
  .prs-kit-actions {
    padding: 48px;
    background: rgba(226, 217, 204, 0.15);
    text-align: center;
  }
  .prs-kit-btn {
    display: inline-block;
    font-family: 'Didact Gothic', sans-serif;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    color: #FAF8F3;
    background: #1C1917;
    padding: 18px 40px;
    transition: opacity 0.2s;
    margin-bottom: 16px;
  }
  .prs-kit-btn:hover {
    opacity: 0.85;
  }
  .prs-kit-note {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 11px;
    color: #C4B9AA;
  }

  /* ─── CONTACTS ─── */
  .prs-contacts {
    border-bottom: 1px solid #E2D9CC;
  }
  .prs-contacts-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 80px;
  }
  .prs-contacts-label {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #9C9080;
    margin-bottom: 40px;
  }
  .prs-contacts-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 32px;
  }
  .prs-contact {
    padding: 40px;
    background: rgba(226, 217, 204, 0.15);
  }
  .prs-contact h3 {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #9C9080;
    margin-bottom: 20px;
  }
  .prs-contact-agency {
    font-family: 'Gilda Display', serif;
    font-style: italic;
    font-size: 20px;
    color: #1C1917;
    margin-bottom: 8px;
  }
  .prs-contact-agency a {
    color: #1C1917;
    text-decoration: none;
    transition: color 0.2s;
  }
  .prs-contact-agency a:hover {
    color: #9e5c4a;
  }
  .prs-contact-email {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 14px;
    color: #6B6256;
    text-decoration: none;
    transition: color 0.2s;
  }
  .prs-contact-email:hover {
    color: #9e5c4a;
  }

  /* ─── CLIPPINGS ─── */
  .prs-clippings {
    border-bottom: 1px solid #E2D9CC;
  }
  .prs-clippings-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 80px;
  }
  .prs-clippings-label {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #9C9080;
    margin-bottom: 40px;
  }
  .prs-clippings-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
  }
  .prs-clipping {
    overflow: hidden;
    background: #f5f2ed;
  }
  .prs-clipping img {
    width: 100%;
    display: block;
    transition: transform 0.6s ease;
  }
  .prs-clipping:hover img {
    transform: scale(1.02);
  }

  /* ─── RESPONSIVE ─── */
  @media (max-width: 900px) {
    .prs-header {
      padding: 140px 24px 48px;
    }
    .prs-reviews-inner {
      padding: 48px 24px;
    }
    .prs-review-head {
      flex-direction: column;
      gap: 4px;
    }
    .prs-kit-inner {
      grid-template-columns: 1fr;
      padding: 48px 24px;
      gap: 32px;
    }
    .prs-contacts-inner {
      padding: 48px 24px;
    }
    .prs-contacts-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .prs-clippings-inner {
      padding: 48px 24px;
    }
    .prs-clippings-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
