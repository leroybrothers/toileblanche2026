---
import Layout from '../../../layouts/Layout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import { heroSrcset } from '../../../utils/images';

const refItems: { title: string; sub: string | null }[] = [
  { title: 'Pétanque', sub: 'Le terrain est là. Les boules sont à la réception.' },
  { title: 'La baignade à 7h', sub: 'Avant que le domaine ne se réveille.' },
  {
    title: 'Le vélo dans la vallée du Loup',
    sub: 'Vélos disponibles. Nous vous suggérerons un itinéraire qui évite la route principale.',
  },
  {
    title: "L'apéritif du vendredi — avec les artistes",
    sub: '18 h. Quelque part sur le domaine. Venez si le cœur vous en dit.',
  },
  {
    title: 'La conversation sur les œuvres',
    sub: "D'où vient chaque pièce, et pourquoi elle se trouve exactement là où elle est.",
  },
  {
    title: 'Fondation Maeght et Fondation CAB',
    sub: "À cinq minutes en voiture. Deux des plus grands fonds privés d'Europe.",
  },
  {
    title: 'Le marché, avec un panier',
    sub: 'Nous préparons le panier la veille au soir et vous indiquons les étals.',
  },
  {
    title: "Le massage d'Amandine",
    sub: 'Sur rendez-vous. Renseignez-vous à la réception.',
  },
  {
    title: 'Le tour des galeries',
    sub: 'Les ateliers entre Saint-Paul et Vence que la plupart des visiteurs ne trouvent jamais.',
  },
  {
    title: 'Les routes que personne ne prend',
    sub: 'La vallée à vélo. Les villages au-dessus de la côte. Nous avons une carte.',
  },
  { title: "Et le plaisir particulier de n'en faire aucun.", sub: null },
];
---

<Layout
  locale="fr"
  title="Expériences | Toile Blanche | Saint-Paul de Vence"
  description="Œuvres disponibles pendant votre séjour — des piscines à la Fondation Maeght, et le plaisir de n'en faire aucun."
  ogImage="https://www.toileblanche.com/assets/images/og-experiences.jpg"
>
  <Nav locale="fr" theme="both" />

  <section class="exp-ref-hero">
    <div class="exp-ref-hero-image">
      <img src="/assets/images/slideshow5.jpg" srcset={heroSrcset('/assets/images/slideshow5.jpg')} sizes="100vw" width="4897" height="3267" alt="Le domaine de Toile Blanche" loading="eager" fetchpriority="high" />
    </div>
  </section>

  <main id="main-content">
    <section class="exp-ref-list">
      <h2 class="exp-ref-title">Œuvres disponibles pendant votre séjour</h2>
      <div class="exp-ref-items">
        {refItems.map((item) => (
          <div class:list={['exp-ref-item', { 'exp-ref-item--final': !item.sub }]}>
            <p class="exp-ref-line">{item.title}</p>
            {item.sub && <p class="exp-ref-sub">{item.sub}</p>}
          </div>
        ))}
      </div>
      <p class="exp-ref-note">La réception peut tout organiser. Ou écrivez-nous avant votre arrivée.</p>
    </section>
  </main>

  <Footer locale="fr" />
</Layout>

<style>
  .exp-ref-hero {
    position: relative;
    width: 100%;
    aspect-ratio: 4897 / 3267;
    min-height: 60vh;
    overflow: hidden;
  }
  .exp-ref-hero-image {
    position: absolute;
    inset: 0;
  }
  .exp-ref-hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .exp-ref-list {
    margin: 0 auto;
    padding: clamp(80px, 12vw, 140px) 30%;
    text-align: center;
  }
  .exp-ref-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(22px, 2.2vw, 30px);
    font-weight: 400;
    color: var(--color-ink-mid);
    margin-bottom: clamp(48px, 6vw, 72px);
    letter-spacing: 0.02em;
  }
  .exp-ref-items {
    font-family: 'Cormorant Garamond', Georgia, serif;
    color: var(--color-ink-deep);
  }
  .exp-ref-item {
    margin-bottom: 2.5em;
  }
  .exp-ref-item--final {
    margin-bottom: 0;
    margin-top: 0.25em;
  }
  .exp-ref-line {
    margin: 0;
    font-size: clamp(20px, 2vw, 24px);
    font-weight: 400;
    font-style: normal;
    line-height: 1.35;
  }
  .exp-ref-sub {
    margin: 0.45em 0 0 0;
    max-width: 28em;
    margin-left: auto;
    margin-right: auto;
    font-size: clamp(16px, 1.55vw, 18px);
    font-weight: 400;
    font-style: italic;
    line-height: 1.55;
    color: var(--color-stone);
  }
  .exp-ref-note {
    margin-top: clamp(72px, 10vw, 120px);
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(16px, 1.5vw, 18px);
    font-style: italic;
    line-height: 1.6;
    color: var(--color-ink-mid);
  }

  @media (max-width: 900px) {
    .exp-ref-hero {
      min-height: 50vh;
    }
    .exp-ref-list {
      padding: 60px 24px;
    }
  }
</style>
