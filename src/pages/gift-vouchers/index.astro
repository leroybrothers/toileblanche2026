---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
---

<Layout
  title="Gift Vouchers | Toile Blanche"
  description="Do you think you have the skills and passion necessary to contribute to the success of Toile Blanche? Learn more."
  ogImage="https://cdn.prod.website-files.com/639af6c370637a9be3e3b0b0/63dbc14a7fa59e1233dd4d93_Neutral%20Beige%20Minimalist%20Photo%20Collage%20Facebook%20Cover%20(1).jpg"
>
  <Nav theme="both" />

  <div class="section bottom-padding-192 no-top-padding"><div class="container"><div class="hero4" style="-webkit-transform:translate3d(0, 0, 0) scale3d(1.01, 1.01, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-moz-transform:translate3d(0, 0, 0) scale3d(1.01, 1.01, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-ms-transform:translate3d(0, 0, 0) scale3d(1.01, 1.01, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);transform:translate3d(0, 0, 0) scale3d(1.01, 1.01, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);opacity:0"><h1>Gift Vouchers</h1><div class="hero-arrow"><img alt="arrow down" class="hero-arrow-image" loading="lazy" src="/assets/images/page-img-1e6e73d27d5690.svg" style="-webkit-transform:translate3d(0, 24PX, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-moz-transform:translate3d(0, 24PX, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-ms-transform:translate3d(0, 24PX, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);transform:translate3d(0, 24PX, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0)"/></div></div></div></div><div class="section bottom-padding-192 no-top-padding"><div class="container"><div class="html-embed-13 w-embed w-script"><div class="ubiliz-offers-widget" data-url="https://app.ubiliz.com/widget/liste-bons/4788"></div></div></div></div><div><div class="full-frame-image-wrapper gift-vouchers"></div></div><div class="divider _96px"></div><div class="section bg-color-2 hide"><div class="container"><div class="cta-wrapper"><div class="w-layout-grid cta-3-grid"><div class="cta-area-1" id="w-node-a924dcd2-d5c0-7326-f66e-1c36f049af06-f049af02"><p>Get our emails. News about Toile Blanche, offers, special dishes from the chef’s table and much more. Not too often — Just enough.</p></div><div class="cta-area-2" id="w-node-a924dcd2-d5c0-7326-f66e-1c36f049af09-f049af02"><h3>Don't be a stranger!</h3></div><div class="cta-area-3" id="w-node-a924dcd2-d5c0-7326-f66e-1c36f049af0c-f049af02"><div class="newsletter-form-block w-form"><form class="newsletter-form" data-name="Newsletter Form" data-wf-element-id="a924dcd2-d5c0-7326-f66e-1c36f049af0e" data-wf-page-id="6581dbff6092785d1aa7fff2" id="wf-form-Newsletter-Form" method="get" name="wf-form-Newsletter-Form"><div class="newsletter-input"><label for="Full-Name">Name</label><input class="form-input w-input" data-name="Full Name" id="Full-Name" maxlength="256" name="Full-Name" placeholder="John Doe" required="" type="text"/></div><div class="newsletter-input"><label for="Email">Email Address</label><input class="form-input w-input" data-name="Email" id="Email" maxlength="256" name="Email" placeholder="john.doe@myemail.com" required="" type="email"/></div><input class="submit-button w-button" data-wait="Please wait..." type="submit" value="Try it out now!"/></form><div class="w-form-done"><div>Thank you! Your submission has been received!</div></div><div class="w-form-fail"><div>Oops! Something went wrong while submitting the form.</div></div></div><div class="small-text">*By subscribing to our newsletter you agree to our Privacy Policy</div></div></div></div></div></div>

  <Footer />
</Layout>
