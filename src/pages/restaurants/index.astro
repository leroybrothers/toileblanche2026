<style is:global>
  /* ─── HERO ─── */
  .rst-hero {
    position: relative;
    height: 100vh;
    min-height: 500px;
    overflow: hidden;
  }
  .rst-hero-image {
    position: absolute;
    inset: 0;
  }
  .rst-hero-image img {
    object-position: center 65%;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .rst-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.5) 0%, transparent 55%);
  }
  .rst-hero-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 0 80px 72px;
    color: #fff;
  }
  .rst-hero-eyebrow {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    opacity: 0.8;
    margin-bottom: 16px;
    color: #fff;
  }
  .rst-hero-content h1 {
    font-family: 'Gilda Display', serif;
    font-size: clamp(36px, 5vw, 72px);
    font-weight: 400;
    line-height: 1.1;
    color: #fff;
  }

  /* ─── TAGLINE ─── */
  .rst-tagline {
    border-bottom: 1px solid #E2D9CC;
  }
  .rst-tagline-inner {
    max-width: 800px;
    margin: 0 auto;
    padding: 64px 80px;
    text-align: center;
  }
  .rst-tagline-inner p {
    font-family: 'Gilda Display', serif;
    font-style: italic;
    font-size: clamp(20px, 2.5vw, 28px);
    line-height: 1.55;
    color: #3D3530;
  }

  /* ─── VENUES ─── */
  .rst-venues {
    border-bottom: 1px solid #E2D9CC;
  }
  .rst-venues-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 80px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: start;
  }
  .rst-venue-image {
    display: block;
    overflow: hidden;
    margin-bottom: 0;
    aspect-ratio: 4/3;
  }
  .rst-venue-content {
    padding-top: 80px;
  }
  .rst-venue-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.8s ease;
  }
  .rst-venue:hover .rst-venue-image img {
    transform: scale(1.02);
  }
  .rst-venue-content h2 {
    font-family: 'Gilda Display', serif;
    font-size: clamp(36px, 4.5vw, 52px) !important;
    font-weight: 400;
    color: #1C1917;
    margin-bottom: 16px;
  }
  .rst-venue-title-link {
    color: inherit;
    text-decoration: none;
    cursor: pointer;
    transition: color 0.2s;
  }
  .rst-venue-title-link:hover {
    color: #9e5c4a;
  }
  .rst-venue-tagline {
    font-family: 'Gilda Display', serif;
    font-style: italic;
    font-size: 18px;
    line-height: 1.55;
    color: #9e5c4a;
    margin-bottom: 20px;
  }
  .rst-venue-desc {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 16px;
    line-height: 1.8;
    color: #6B6256;
    margin-bottom: 32px;
  }
  .rst-venue-actions {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .rst-venue-btn {
    display: inline-block;
    width: fit-content;
    font-family: 'Didact Gothic', sans-serif;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    color: #FAF8F3;
    background: #9e5c4a;
    padding: 16px 36px;
    transition: opacity 0.2s;
  }
  .rst-venue-btn:hover {
    opacity: 0.85;
  }
  .rst-venue-link {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    color: #9C9080;
    transition: color 0.2s;
  }
  .rst-venue-link:hover {
    color: #3D3530;
  }

  /* ─── BREAKFAST ─── */
  .rst-breakfast {
    border-bottom: 1px solid #E2D9CC;
  }
  .rst-breakfast-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 80px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
  }
  .rst-breakfast-image {
    display: block;
    overflow: hidden;
    aspect-ratio: 4/3;
  }
  .rst-breakfast-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
    display: block;
    transition: transform 0.8s ease;
  }
  .rst-breakfast:hover .rst-breakfast-image img {
    transform: scale(1.02);
  }
  .rst-breakfast-eyebrow {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #9C9080;
    margin-bottom: 16px;
  }
  .rst-breakfast-content h2 {
    font-family: 'Gilda Display', serif;
    font-size: clamp(36px, 4.5vw, 52px) !important;
    font-weight: 400;
    color: #1C1917;
    margin-bottom: 16px;
  }
  .rst-breakfast-tagline {
    font-family: 'Gilda Display', serif;
    font-style: italic;
    font-size: 18px;
    line-height: 1.55;
    color: #9e5c4a;
    margin-bottom: 20px;
  }
  .rst-breakfast-desc {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 15px;
    line-height: 1.8;
    color: #6B6256;
    margin-bottom: 24px;
  }
  .rst-breakfast-hours {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #9C9080;
    margin-bottom: 20px;
  }

  /* ─── PHILOSOPHY ─── */
  .rst-philosophy {
    border-bottom: 1px solid #E2D9CC;
  }
  .rst-philosophy-inner {
    max-width: 900px;
    margin: 0 auto;
    padding: 96px 80px;
    text-align: center;
  }
  .rst-philosophy-inner h2 {
    font-family: 'Gilda Display', serif;
    font-style: italic;
    font-size: clamp(24px, 3.5vw, 44px);
    font-weight: 400;
    line-height: 1.3;
    color: #1C1917;
    margin-bottom: 32px;
  }
  .rst-philosophy-inner p {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 16px;
    line-height: 1.8;
    color: #6B6256;
    max-width: 640px;
    margin: 0 auto;
  }

  /* ─── CTA ─── */
  .rst-cta {
    padding: 80px;
    text-align: center;
    border-bottom: 1px solid #E2D9CC;
  }
  .rst-cta p {
    font-family: 'Gilda Display', serif;
    font-style: italic;
    font-size: clamp(20px, 2.5vw, 28px);
    color: #3D3530;
    margin-bottom: 32px;
  }
  .rst-cta-btn {
    display: inline-block;
    font-family: 'Didact Gothic', sans-serif;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    color: #FAF8F3;
    background: #9e5c4a;
    padding: 16px 36px;
    transition: opacity 0.2s;
  }
  .rst-cta-btn:hover {
    opacity: 0.85;
  }

  /* ─── RESPONSIVE ─── */
  @media (max-width: 900px) {
    .rst-hero-content {
      padding: 0 24px 48px;
    }
    .rst-tagline-inner {
      padding: 48px 24px;
    }
    .rst-venues-inner {
      grid-template-columns: 1fr;
      padding: 48px 24px;
      gap: 48px;
    }
    .rst-breakfast-inner {
      grid-template-columns: 1fr;
      padding: 48px 24px;
      gap: 32px;
    }
    .rst-philosophy-inner {
      padding: 64px 24px;
    }
    .rst-cta {
      padding: 48px 24px;
    }
  }
</style>
