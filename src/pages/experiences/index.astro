---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { heroSrcset } from '../../utils/images';

const refItems: { title: string; sub: string | null }[] = [
  { title: 'Pétanque', sub: 'The court is there. The boules are at reception.' },
  { title: 'Swimming at 7am', sub: 'Before Toile Blanche wakes up.' },
  {
    title: 'Cycling the countryside',
    sub: 'Bikes available.',
  },
  {
    title: 'Friday aperitif, with the artists',
    sub: 'In the summer around 18h. Somewhere on the property. Come if you feel like it.',
  },
  {
    title: 'A conversation about the artworks',
    sub: 'Where each piece came from, and why it is exactly where it is.',
  },
  {
    title: 'Wine with Isabelle Legeron MW',
    sub: 'Monthly tastings during the season. An immersive retreat each autumn. Natural wine, one producer at a time.',
  },
  {
    title: 'Fondation Maeght, Fondation CAB and gallery tour',
    sub: 'Five minutes by car. Two of the great private collections in Europe, a handful of exquisite contemporary art galleries... Check RAD/ART',
  },
  {
    title: "Eve's Pilates",
    sub: 'Movement and mindfulness, Pilates, yoga and stretching.',
  },
  {
    title: "Amandine's massage",
    sub: 'Swedish · Californian · Hot stones · Chi Nei Tsang · An-Mo Tui Na',
  },
  {
    title: 'The gallery circuit',
    sub: 'The studios between Saint-Paul and Vence that most visitors never find.',
  },
  { title: 'And the particular pleasure of doing none of it.', sub: null },
];
---

<Layout
  title="Experiences | Toile Blanche | Saint-Paul de Vence"
  description="Works available during your stay, from the pools and the valley to Fondation Maeght and the pleasure of doing none of it."
  ogImage="https://www.toileblanche.com/assets/images/og-experiences.jpg"
>
  <Nav theme="both" />

  <section class="exp-ref-hero">
    <div class="exp-ref-hero-image">
      <img src="/assets/images/ambiance/IVER3550.jpg" srcset={heroSrcset('/assets/images/ambiance/IVER3550.jpg')} sizes="100vw" width="3000" height="2001" alt="Toile Blanche" loading="eager" fetchpriority="high" />
    </div>
  </section>

  <main id="main-content">
    <section class="exp-ref-list">
      <h2 class="exp-ref-title">Works Available During Your Stay</h2>
      <div class="exp-ref-items">
        {refItems.map((item) => (
          <div class:list={['exp-ref-item', { 'exp-ref-item--final': !item.sub }]}>
            <p class="exp-ref-line">{item.title}</p>
            {item.sub && <p class="exp-ref-sub">{item.sub}</p>}
          </div>
        ))}
      </div>
      <p class="exp-ref-note">Reception can arrange everything. Or write to us before you arrive.</p>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .exp-ref-hero {
    position: relative;
    width: 100%;
    aspect-ratio: 3000 / 2001;
    min-height: 60vh;
    overflow: hidden;
  }
  .exp-ref-hero-image {
    position: absolute;
    inset: 0;
  }
  .exp-ref-hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .exp-ref-list {
    margin: 0 auto;
    padding: clamp(80px, 12vw, 140px) 30%;
    text-align: center;
  }
  .exp-ref-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(22px, 2.2vw, 30px);
    font-weight: 400;
    color: var(--color-ink-mid);
    margin-bottom: clamp(48px, 6vw, 72px);
    letter-spacing: 0.02em;
  }
  .exp-ref-items {
    font-family: 'Cormorant Garamond', Georgia, serif;
    color: var(--color-ink-deep);
  }
  .exp-ref-item {
    margin-bottom: 2.5em;
  }
  .exp-ref-item--final {
    margin-bottom: 0;
    margin-top: 0.25em;
  }
  .exp-ref-line {
    margin: 0;
    font-size: clamp(20px, 2vw, 24px);
    font-weight: 400;
    font-style: normal;
    line-height: 1.35;
  }
  .exp-ref-sub {
    margin: 0.45em 0 0 0;
    max-width: 28em;
    margin-left: auto;
    margin-right: auto;
    font-size: clamp(16px, 1.55vw, 18px);
    font-weight: 400;
    font-style: italic;
    line-height: 1.55;
    color: var(--color-stone);
  }
  .exp-ref-note {
    margin-top: clamp(72px, 10vw, 120px);
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(16px, 1.5vw, 18px);
    font-style: italic;
    line-height: 1.6;
    color: var(--color-ink-mid);
  }

  @media (max-width: 900px) {
    .exp-ref-hero {
      min-height: 50vh;
    }
    .exp-ref-list {
      padding: 60px 24px;
    }
  }
</style>
