---
import { useTranslations, localePath, type Locale } from '../i18n/index';

export interface Props {
  currentPath: string;
  ctaText?: string;
  ctaHref?: string;
  locale?: Locale;
}
const { currentPath, ctaHref, locale = 'en' } = Astro.props;
const t = useTranslations(locale);
const ctaText = Astro.props.ctaText ?? t.nav.bookStay;
const lp = (path: string) => localePath(path, locale);
const linkClass = (path: string) => currentPath.startsWith(path) ? ' tb-current' : '';
---

<header class="tb-menu-header">
  {ctaHref ? (
    <a href={ctaHref} target="_blank" rel="noopener noreferrer" class="tb-menu-cta">{ctaText}</a>
  ) : (
    <a href="#" class="tb-menu-cta distributor-open">{ctaText}</a>
  )}
  <button type="button" class="tb-menu-close js-menu-toggle" aria-label={t.nav.closeMenu}>×</button>
</header>

<div class="tb-menu-inner">
  <nav class="tb-menu-nav" aria-label="Main menu">
    <a href={lp('/suites')} class={`tb-menu-link${linkClass(lp('/suites'))}`}>{t.nav.suites}</a>
    <a href={lp('/restaurants')} class={`tb-menu-link${linkClass(lp('/restaurants'))}`}>{t.nav.restaurants}</a>
    <a href={lp('/art')} class={`tb-menu-link${linkClass(lp('/art'))}`}>{t.nav.theArt}</a>
    <a href={lp('/experiences')} class={`tb-menu-link tb-menu-link-last${linkClass(lp('/experiences'))}`}>{t.nav.experiences}</a>
  </nav>

  <div class="tb-menu-divider" aria-hidden="true"></div>

  <div class="tb-menu-info">
    <div class="tb-menu-info-cell">
      <p class="tb-menu-info-title">{t.nav.contact}</p>
      <a href="tel:+33493327421" class="tb-menu-info-link">+33 4 93 32 74 21</a>
      <a href="mailto:info@toileblanche.com" class="tb-menu-info-link">info@toileblanche.com</a>
    </div>
    <div class="tb-menu-info-cell">
      <p class="tb-menu-info-title">{t.nav.giftVouchers}</p>
      <a href={lp('/gift-vouchers')} class="tb-menu-info-link">{t.nav.giftVouchersLink}</a>
    </div>
    <div class="tb-menu-info-cell">
      <p class="tb-menu-info-title">{t.nav.findUs}</p>
      <a href="https://goo.gl/maps/VoKrme28X62qbvTk7" target="_blank" rel="noopener noreferrer" class="tb-menu-info-link">
        826, chemin de la Pounchounière<br />06570 Saint-Paul de Vence
      </a>
    </div>
    <div class="tb-menu-info-cell tb-menu-info-footer">
      <a href={lp('/about')} class="tb-menu-info-link">{t.nav.about}</a>
      <a href={lp('/upcoming-events')} class="tb-menu-info-link">{t.nav.events}</a>
      <a href={lp('/blog')} class="tb-menu-info-link">{t.nav.archive}</a>
      <a href={lp('/press')} class="tb-menu-info-link">{t.nav.press}</a>
      <a href={lp('/careers')} class="tb-menu-info-link">{t.nav.careers}</a>
    </div>
  </div>
</div>

<div class="tb-menu-affiliations">
  <div class="tb-affil-michelin">
    <img
      src="/assets/images/affiliations/michelin-key.png"
      alt="MICHELIN Key"
      loading="lazy"
    />
    <span class="tb-affil-label">The Michelin Key · 2025</span>
  </div>
  <div class="tb-affil-slh">
    <span class="tb-affil-caption">{locale === 'fr' ? 'Affilié à' : 'Affiliated with'}</span>
    <img
      src="/assets/images/affiliations/logo-slh.svg"
      alt="Small Luxury Hotels of the World"
      loading="lazy"
    />
  </div>
</div>
