---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

export function getStaticPaths() {
  const masterAmenities = [
    "King size Tréca bed · Premium bedding",
    "Air conditioning",
    "Free WiFi",
    "Flat screen TV · Bluetooth audio",
    "In-room safe",
    "Bean-to-cup coffee machine",
    "Curated minibar — full bottles of wine",
    "Les Grandes Vacances toiletries",
    "Bathrobes & slippers",
    "Walk-in shower",
  ];

  const suites = [
    {
      slug: "penard",
      index: "01",
      name: "Suite Pénard",
      tagline: "French windows, a private patio, and morning light that arrives exactly on time.",
      description: "The right amount of everything. Pénard is the smallest of our categories, but it is perhaps the most precise. Built into the original stone structures, these suites are exercises in restraint and curated comfort.",
      specs: { count: "6 suites", size: "30m²", occupancy: "2 guests", view: "Garden view", features: "Private patio · Walk-in shower" },
      extras: [],
      heroImage: "/assets/images/page-img-fc5920b651f35b.jpg",
      gallery: [
        "/assets/images/page-img-eb795e7700a147.jpg",
        "/assets/images/page-img-0d4fab6cd496a8.jpg",
        "/assets/images/page-img-0bd0acfefc8c5b.jpg",
      ],
      hasPool: false,
    },
    {
      slug: "petanque",
      index: "02",
      name: "Suite Pétanque",
      tagline: "Named for the game played in the shade nearby. Forty square metres that feel considerably larger.",
      description: "Where the afternoon lasts longest. Set within a beautifully renovated residence, Suite Pétanque offers more space, complete with a dedicated living area and a terrace designed for the slow Provençal hours.",
      specs: { count: "4 suites", size: "40m²", occupancy: "2 guests", view: "Garden view", features: "Living area · Terrace · Walk-in shower" },
      extras: [],
      heroImage: "/assets/images/page-img-13bfe0acd738c0.jpg",
      gallery: [
        "/assets/images/page-img-833a78c568fe35.jpg",
        "/assets/images/page-img-8c03274d5f9fd2.jpg",
        "/assets/images/page-img-e203e7177a0fba.jpg",
      ],
      hasPool: false,
    },
    {
      slug: "bronzette",
      index: "03",
      name: "Suite de la Bronzette",
      tagline: "The name says it all. Fifty-five square metres, a spa bathroom, and a private terrace designed for serious sun.",
      description: "Photographers come for the light. Guests stay for everything else. These spacious suites feature a bedroom and living room layout, allowing for extra privacy and the possibility to add an extra bed.",
      specs: { count: "2 suites", size: "55m²", occupancy: "2 guests", view: "Garden view", features: "Spa bathroom · Large private terrace" },
      extras: ["Bathtub", "Extra bed available (+€80/night)"],
      heroImage: "/assets/images/page-img-cc59a0bcdda081.jpg",
      gallery: [
        "/assets/images/page-img-8626fb58027da5.jpg",
        "/assets/images/page-img-431877e28efcaf.jpg",
        "/assets/images/page-img-17e8d97a8dfff6.jpg",
      ],
      hasPool: false,
    },
    {
      slug: "cabanat",
      index: "04",
      name: "Suite Cabanat",
      tagline: "Built into the slope, which gives it something the others do not have — a valley view, and a sunbed cabana you will not want to leave.",
      description: "Our generous Suite Cabanat is a split-level retreat. It is the only category that faces the valley, offering a perspective on Saint-Paul de Vence that feels entirely private.",
      specs: { count: "3 suites", size: "55m²", occupancy: "2 guests", view: "Valley view", features: "Split-level · Sunbed cabana · Private garden" },
      extras: ["Bathtub", "Outdoor shower"],
      heroImage: "/assets/images/page-img-22b8daa3a98de1.jpg",
      gallery: [
        "/assets/images/page-img-826f21859fa23e.jpg",
        "/assets/images/page-img-eecc3519b1d474.jpg",
        "/assets/images/page-img-be2c0c3fe3d438.jpg",
      ],
      hasPool: false,
    },
    {
      slug: "suite-artiste",
      index: "05",
      name: "Suite de l'Artiste",
      tagline: "The 200-year-old farmhouse, with its original beams and stone, and a balcony that has been watching the same view for two centuries.",
      description: "Modern rustic situated in the oldest walls on the property. Authentic details have been preserved to complement contemporary curation. A space where history is not decoration, but the atmosphere itself.",
      specs: { count: "2 suites", size: "60–70m²", occupancy: "2 guests", view: "Garden view", features: "200-year-old farmhouse · Original stone and beams · Balcony" },
      extras: ["Bathtub"],
      heroImage: "/assets/images/page-img-6fb08ef94b7be5.jpg",
      gallery: [
        "/assets/images/page-img-e1708f1e9761a9.jpg",
        "/assets/images/page-img-cd43fba77f9e67.jpg",
        "/assets/images/page-img-e025d0155b7425.jpg",
      ],
      hasPool: false,
    },
    {
      slug: "mas-artiste",
      index: "06",
      name: "Mas de l'Artiste",
      tagline: "The largest suite in the farmhouse. Ninety square metres, a private Provençal courtyard, and room for the people you actually want to travel with.",
      description: "The farmhouse, kept almost entirely for you. This vast, sun-flooded maisonette separates the sleeping area to ensure complete intimacy, while the living area opens directly onto a private courtyard.",
      specs: { count: "1 suite", size: "90m²", occupancy: "Up to 4 guests", view: "Private courtyard", features: "200-year-old farmhouse · Maisonette · Private courtyard" },
      extras: ["Bathtub", "Extra bed available (+€80/night)"],
      heroImage: "/assets/images/page-img-46f7b755735790.jpg",
      gallery: [
        "/assets/images/page-img-6106adc613aeb2.jpg",
        "/assets/images/page-img-d9499fe50d6ed6.jpg",
        "/assets/images/page-img-71d4e99222d050.jpg",
      ],
      hasPool: false,
    },
    {
      slug: "bonvivant",
      index: "07",
      name: "Suite du Bon-Vivant",
      tagline: "A private pool, a terrace, and a sunset that arrives from the right direction at the right time of day.",
      description: "Our bright Suites du Bon-Vivant come with ample bedroom and lounging space, but the main attraction is the exceptional terrace with your own private pool. Here, the sunset is magical.",
      specs: { count: "2 suites", size: "55–60m²", occupancy: "2 guests", view: "Sunset view", features: "Private pool · Terrace · Bathtub" },
      extras: ["Private pool", "Bathtub", "Extra bed available (+€80/night)"],
      heroImage: "/assets/images/page-img-59c7e07d15bf91.jpg",
      gallery: [
        "/assets/images/page-img-707417a43d47ee.jpg",
        "/assets/images/page-img-1c7ae91a066a89.jpg",
        "/assets/images/page-img-6318088b5c037e.jpg",
      ],
      hasPool: true,
    },
    {
      slug: "penequet",
      index: "08",
      name: "Villa du Pénéquet",
      tagline: "Pénéquet — the Provençal word for power-nap. Two floors, a private pool, and the particular art of doing absolutely nothing on purpose.",
      description: "The only suites boasting two floors. The ground floor houses a luxurious living area with direct access to your private pool and sun loungers. Upstairs, the master bedroom offers the ultimate retreat.",
      specs: { count: "2 villas", size: "80m²", occupancy: "2 guests", view: "Garden view", features: "Private pool · Two floors · Bathtub" },
      extras: ["Private pool", "Two-floor layout", "Bathtub", "Extra bed available"],
      heroImage: "/assets/images/page-img-8da5a0df461d5d.jpg",
      gallery: [
        "/assets/images/page-img-5f8a45f5b552ed.jpg",
        "/assets/images/page-img-9502e1df731900.jpg",
        "/assets/images/page-img-2288c37159b2c6.jpg",
      ],
      hasPool: true,
    },
  ];

  return suites.map((suite) => ({
    params: { slug: suite.slug },
    props: {
      suite,
      allSuites: suites,
      amenities: [...masterAmenities, ...suite.extras],
    },
  }));
}

const { suite, allSuites, amenities } = Astro.props;
const otherSuites = allSuites.filter(s => s.slug !== suite.slug);
---

<Layout
  title={`${suite.name} | Toile Blanche | Saint-Paul de Vence`}
  description={suite.tagline}
>
  <Nav theme="both" />

  <main>
    <!-- HERO -->
    <section class="sd-hero">
      <div class="sd-hero-image">
        <img src={suite.heroImage} alt={suite.name} loading="eager" />
        <div class="sd-hero-overlay"></div>
      </div>
      <div class="sd-hero-content">
        <p class="sd-hero-eyebrow">{suite.index} — {suite.specs.count}</p>
        <h1>{suite.name}</h1>
      </div>
    </section>

    <!-- TAGLINE + SPECS -->
    <section class="sd-intro">
      <div class="sd-intro-inner">
        <div class="sd-intro-tagline">
          <p>{suite.tagline}</p>
        </div>
        <div class="sd-intro-specs">
          <div class="sd-spec">{suite.specs.size}</div>
          <div class="sd-spec">{suite.specs.occupancy}</div>
          <div class="sd-spec">{suite.specs.view}</div>
          <div class="sd-spec">{suite.specs.features}</div>
          {suite.hasPool && <div class="sd-spec sd-spec-pool">Private pool</div>}
        </div>
      </div>
    </section>

    <!-- NARRATIVE -->
    <section class="sd-narrative">
      <div class="sd-narrative-inner">
        <div class="sd-narrative-text">
          <h2>The Feeling</h2>
          <p class="sd-narrative-desc">{suite.description}</p>
          <p class="sd-narrative-maxibar">The cabinet is stocked with full bottles rather than miniatures — Côtes de Provence rosé, white and red from local producers, champagne, regional provisions, and the Toile Blanche bonbons that guests tend to mention unprompted.</p>
        </div>
        <div class="sd-amenities">
          <p class="sd-amenities-title">Amenities</p>
          <ul>
            {amenities.map(item => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- GALLERY -->
    <section class="sd-gallery">
      {suite.gallery.map((img, i) => (
        <div class={`sd-gallery-item sd-gallery-item-${i + 1}`}>
          <img src={img} alt={`${suite.name} — view ${i + 1}`} loading="lazy" />
        </div>
      ))}
    </section>

    <!-- CTA -->
    <section class="sd-cta">
      <p>22 suites. No two the same.</p>
      <a href="#" class="sd-cta-btn distributor-open">Reserve {suite.name}</a>
    </section>

    <!-- EXPLORE OTHER SUITES -->
    <section class="sd-explore">
      <h2>Explore other Suites</h2>
      <div class="sd-explore-grid">
        {otherSuites.map(s => (
          <a href={`/suites/${s.slug}`} class="sd-explore-card">
            <div class="sd-explore-img">
              <img src={s.gallery[0]} alt={s.name} loading="lazy" />
            </div>
            <p class="sd-explore-name">{s.name}</p>
          </a>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* ─── HERO ─── */
  .sd-hero {
    position: relative;
    height: 85vh;
    min-height: 500px;
    overflow: hidden;
  }
  .sd-hero-image {
    position: absolute;
    inset: 0;
  }
  .sd-hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .sd-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.45) 0%, transparent 50%);
  }
  .sd-hero-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 0 80px 72px;
    color: #fff;
  }
  .sd-hero-eyebrow {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    opacity: 0.8;
    margin-bottom: 16px;
  }
  .sd-hero-content h1 {
    font-family: 'Gilda Display', serif;
    font-size: clamp(40px, 6vw, 80px);
    font-weight: 400;
    line-height: 1.05;
  }

  /* ─── INTRO (tagline + specs) ─── */
  .sd-intro {
    border-bottom: 1px solid #E2D9CC;
  }
  .sd-intro-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 64px 80px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: start;
  }
  .sd-intro-tagline p {
    font-family: 'Gilda Display', serif;
    font-style: italic;
    font-size: clamp(20px, 2.5vw, 28px);
    line-height: 1.55;
    color: #3D3530;
  }
  .sd-intro-specs {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
  }
  .sd-spec {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #6B6256;
    padding: 8px 16px;
    border: 1px solid #E2D9CC;
  }
  .sd-spec-pool {
    background: #1C1917;
    color: #FAF8F3;
    border-color: #1C1917;
  }

  /* ─── NARRATIVE ─── */
  .sd-narrative {
    border-bottom: 1px solid #E2D9CC;
  }
  .sd-narrative-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 80px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: start;
  }
  .sd-narrative-text h2 {
    font-family: 'Gilda Display', serif;
    font-size: clamp(24px, 3vw, 36px);
    font-weight: 400;
    margin-bottom: 28px;
    color: #1C1917;
  }
  .sd-narrative-desc {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 16px;
    line-height: 1.8;
    color: #3D3530;
    margin-bottom: 32px;
  }
  .sd-narrative-maxibar {
    font-family: 'Gilda Display', serif;
    font-style: italic;
    font-size: 16px;
    line-height: 1.7;
    color: #6B6256;
    padding-top: 28px;
    border-top: 1px solid #E2D9CC;
  }
  .sd-amenities {
    padding: 40px;
    background: rgba(226, 217, 204, 0.15);
  }
  .sd-amenities-title {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #9C9080;
    margin-bottom: 28px;
  }
  .sd-amenities ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px 32px;
  }
  .sd-amenities li {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 13px;
    color: #3D3530;
    padding-bottom: 12px;
    border-bottom: 1px solid rgba(226, 217, 204, 0.5);
  }

  /* ─── GALLERY ─── */
  .sd-gallery {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: auto auto;
  }
  .sd-gallery-item {
    overflow: hidden;
  }
  .sd-gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.8s ease;
  }
  .sd-gallery-item:hover img {
    transform: scale(1.03);
  }
  .sd-gallery-item-1 {
    grid-column: 1 / 2;
    grid-row: 1 / 3;
    aspect-ratio: 3/4;
  }
  .sd-gallery-item-2 {
    grid-column: 2 / 3;
    grid-row: 1 / 2;
    aspect-ratio: 4/3;
  }
  .sd-gallery-item-3 {
    grid-column: 2 / 3;
    grid-row: 2 / 3;
    aspect-ratio: 4/3;
  }

  /* ─── CTA ─── */
  .sd-cta {
    padding: 80px;
    text-align: center;
    border-bottom: 1px solid #E2D9CC;
  }
  .sd-cta p {
    font-family: 'Gilda Display', serif;
    font-style: italic;
    font-size: clamp(20px, 2.5vw, 28px);
    color: #3D3530;
    margin-bottom: 32px;
  }
  .sd-cta-btn {
    display: inline-block;
    font-family: 'Didact Gothic', sans-serif;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    color: #FAF8F3;
    background: #9e5c4a;
    padding: 16px 36px;
    transition: opacity 0.2s;
  }
  .sd-cta-btn:hover {
    opacity: 0.85;
  }

  /* ─── EXPLORE OTHER SUITES ─── */
  .sd-explore {
    max-width: 1200px;
    margin: 0 auto;
    padding: 80px;
  }
  .sd-explore h2 {
    font-family: 'Gilda Display', serif;
    font-size: clamp(24px, 3vw, 36px);
    font-weight: 400;
    color: #1C1917;
    margin-bottom: 48px;
  }
  .sd-explore-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 32px;
  }
  .sd-explore-card {
    text-decoration: none;
    color: inherit;
  }
  .sd-explore-img {
    aspect-ratio: 4/3;
    overflow: hidden;
    margin-bottom: 16px;
  }
  .sd-explore-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }
  .sd-explore-card:hover .sd-explore-img img {
    transform: scale(1.04);
  }
  .sd-explore-name {
    font-family: 'Gilda Display', serif;
    font-style: italic;
    font-size: 18px;
    color: #1C1917;
  }

  /* ─── RESPONSIVE ─── */
  @media (max-width: 900px) {
    .sd-hero-content {
      padding: 0 24px 48px;
    }
    .sd-intro-inner {
      grid-template-columns: 1fr;
      padding: 48px 24px;
      gap: 32px;
    }
    .sd-narrative-inner {
      grid-template-columns: 1fr;
      padding: 48px 24px;
      gap: 40px;
    }
    .sd-gallery {
      grid-template-columns: 1fr;
    }
    .sd-gallery-item-1 {
      grid-column: 1;
      grid-row: auto;
      aspect-ratio: 4/3;
    }
    .sd-gallery-item-2,
    .sd-gallery-item-3 {
      grid-column: 1;
      grid-row: auto;
    }
    .sd-cta {
      padding: 48px 24px;
    }
    .sd-explore {
      padding: 48px 24px;
    }
    .sd-amenities ul {
      grid-template-columns: 1fr;
    }
  }
</style>
