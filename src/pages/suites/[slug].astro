<script is:inline>
(function () {
  var gallery = document.querySelector('.sd-gallery');
  if (!gallery) return;
  var lightbox = document.getElementById('sd-lightbox');
  if (!lightbox) return;

  var lbImg = lightbox.querySelector('.sd-lightbox-img');
  var lbCounter = lightbox.querySelector('.sd-lightbox-counter');
  var items = [].slice.call(gallery.querySelectorAll('.sd-gallery-item img'));
  var current = 0;

  function show(idx) {
    current = (idx % items.length + items.length) % items.length;
    lbImg.classList.remove('is-loaded');
    lbImg.src = items[current].getAttribute('src');
    lbImg.alt = items[current].alt;
    lbCounter.textContent = (current + 1) + ' / ' + items.length;
    preload((current + 1) % items.length);
    preload((current - 1 + items.length) % items.length);
  }

  function preload(idx) {
    var img = new Image();
    img.src = items[idx].getAttribute('src');
  }

  function open(idx) {
    show(idx);
    lightbox.classList.add('is-active');
    lightbox.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function close() {
    lightbox.classList.remove('is-active');
    lightbox.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  items.forEach(function (img, i) {
    img.closest('.sd-gallery-item').addEventListener('click', function () { open(i); });
  });

  lightbox.querySelector('.sd-lightbox-close').addEventListener('click', close);
  lightbox.querySelector('.sd-lightbox-backdrop').addEventListener('click', close);
  lightbox.querySelector('.sd-lightbox-prev').addEventListener('click', function () { show(current - 1); });
  lightbox.querySelector('.sd-lightbox-next').addEventListener('click', function () { show(current + 1); });

  lbImg.addEventListener('load', function () { lbImg.classList.add('is-loaded'); });

  document.addEventListener('keydown', function (e) {
    if (!lightbox.classList.contains('is-active')) return;
    if (e.key === 'Escape') close();
    if (e.key === 'ArrowLeft') show(current - 1);
    if (e.key === 'ArrowRight') show(current + 1);
  });

  var touchStartX = 0;
  lightbox.addEventListener('touchstart', function (e) {
    touchStartX = e.changedTouches[0].screenX;
  }, { passive: true });
  lightbox.addEventListener('touchend', function (e) {
    var diff = e.changedTouches[0].screenX - touchStartX;
    if (Math.abs(diff) > 50) { diff > 0 ? show(current - 1) : show(current + 1); }
  }, { passive: true });
})();
</script>
