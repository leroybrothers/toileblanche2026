---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import menu from '../../data/menu-guinguette.json';
import { gallerySrcset, encodePath } from '../../utils/images';
import { useTranslations } from '../../i18n/index';
const lang = 'en';
const t = useTranslations(lang);
---

<Layout
  title="La Guinguette | Toile Blanche | Saint-Paul de Vence"
  description="The garden heart. Come barefoot or in espadrilles. Provence invites itself to your table."
  ogImage="https://www.toileblanche.com/assets/images/guinguette-hero.jpg"
  hideBookingBar={true}
  loadZenchef={true}
>
  <Nav theme="both" ctaText="Book my Table" ctaAction="zenchef" zenchefRid="375927" zenchefPid="1001" />

  <main id="main-content">
    <!-- HERO -->
    <section class="lgn-hero">
      <div class="lgn-hero-image">
        <img src="/assets/images/guinguette-hero.jpg" alt="La Guinguette de Toile Blanche" width="1024" height="768" loading="eager" fetchpriority="high" />
        <div class="lgn-hero-overlay"></div>
      </div>
      <div class="lgn-hero-content">
        <p class="lgn-hero-eyebrow">Lunch — Year-round</p>
        <h1>La Guinguette</h1>
        <a href="https://www.instagram.com/laguinguette.toileblanche/" target="_blank" rel="noopener noreferrer" class="lgn-insta-ref">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
          <span>@laguinguette.toileblanche</span>
        </a>
      </div>
    </section>

    <!-- TAGLINE -->
    <section class="lgn-tagline">
      <div class="lgn-tagline-inner">
        <p>The garden heart. Come barefoot or in espadrilles. Provence invites itself to your table.</p>
      </div>
    </section>

    <!-- NARRATIVE + DETAILS -->
    <section class="lgn-narrative">
      <div class="lgn-narrative-inner">
        <div class="lgn-narrative-text">
          <h2>The Garden Table</h2>
          <p>La Guinguette is the soul of the summer at Toile Blanche. Set under the plane trees beside the pool, it is where lunch lasts as long as it should — somewhere between a proper meal and a long Provençal afternoon.</p>
          <p>The menu is designed for sharing. Dishes are ordered progressively and arrive when they are ready. There is no rush, no structure, no formality. Just the Mediterranean on a plate.</p>
          <h2>How It Works</h2>
          <p>The table is sharing-style. Order a few dishes for the centre, add as you go. Grilled fish, market vegetables, charcuterie, dips, flatbreads — the menu changes weekly depending on what the producers and the garden have to offer.</p>
          <p>Rosé is poured by the glass or the bottle. The wine selection favours the immediate surroundings: Bellet, Côtes de Provence, and the occasional natural oddity from a neighbour's vineyard.</p>
        </div>
        <div class="lgn-details">
          <p class="lgn-details-label">Practical</p>

          <div class="lgn-details-block">
            <h3>Season</h3>
            <p>Open year-round</p>
            <p>Weather permitting</p>
          </div>

          <div class="lgn-details-block">
            <h3>Hours</h3>
            <p>Lunch: 12:00 – 15:00</p>
            <p>Drinks & snacks: 15:00 – 18:00 (summer only)</p>
            <p>Dinner: 18:00 – 21:00 (summer only)</p>
          </div>

          <div class="lgn-details-block">
            <h3>Reservation</h3>
            <p>Recommended, especially weekends.</p>
            <p>Open to hotel guests and external visitors.</p>
          </div>

          <div class="lgn-details-block lgn-details-cta">
            <a href="https://bookings.zenchef.com/results?rid=375927&pid=1001&lang=en" target="_blank" rel="noopener noreferrer" data-zc-action="open" class="lgn-btn">Reserve a Table</a>
          </div>

          <div class="lgn-details-block">
            <h3>Good to Know</h3>
            <p>Dishes are ordered progressively — no need to order everything at once.</p>
            <p>Sharing style. No individual plates unless requested.</p>
            <p>Barefoot welcome. Swimwear with a cover-up is fine.</p>
          </div>

          <div class="lgn-details-block">
            <h3>Location</h3>
            <p>Toile Blanche — Poolside Garden</p>
            <p>826, chemin de la Pounchounière</p>
            <p>06570 Saint-Paul de Vence</p>
            <p>France</p>
          </div>

          <div class="lgn-details-block">
            <h3>Contact</h3>
            <a href="tel:+33493327421" class="lgn-details-link">+33 4 93 32 74 21</a>
            <a href="mailto:guinguette@toileblanche.com" class="lgn-details-link">guinguette@toileblanche.com</a>
          </div>
        </div>
      </div>
    </section>

    <!-- THE MENU (accordion) -->
    <section class="lgn-menu">
      <div class="lgn-menu-inner">
        <div class="lgn-menu-accordion">
          <button type="button" class="lgn-menu-accordion-trigger" aria-expanded="false" aria-controls="lgn-menu-content" id="lgn-menu-trigger" data-view={t.common.viewMenu} data-hide={t.common.hideMenu}>
            <span class="lgn-menu-accordion-header">
              <p class="lgn-menu-label">{menu.meta.season[lang]}</p>
              <h2>The Menu</h2>
              <p class="lgn-menu-intro">{menu.meta.philosophy[lang]}</p>
              <span class="lgn-menu-expand">
                <span class="lgn-menu-expand-text">{t.common.viewMenu}</span>
                <svg class="lgn-menu-expand-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path d="M6 9l6 6 6-6"/>
                </svg>
              </span>
            </span>
          </button>
          <div id="lgn-menu-content" class="lgn-menu-accordion-content" role="region" aria-labelledby="lgn-menu-trigger" hidden>
        {menu.sections.map(section => (
          <div class="lgn-menu-section">
            <h3>{section.title[lang]}</h3>
            {section.items.map(item => (
              <div class="lgn-menu-item">
                <p class="lgn-menu-dish">{item[lang]}</p>
                <span class="lgn-menu-price">{item.price}€</span>
              </div>
            ))}
          </div>
        ))}

        <p class="lgn-menu-note">{menu.footer_note[lang]}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- GALLERY (masonry, bon-vivant style) -->
    <section class="lgn-gallery">
      <div class="lgn-gallery-item">
        <img src="/assets/images/guinguette/IMG_9122.jpg" srcset={gallerySrcset('/assets/images/guinguette/IMG_9122.jpg')} sizes="(max-width: 900px) 100vw, 50vw" width="3024" height="4032" alt="Sharing plates at La Guinguette" loading="lazy" />
      </div>
      <div class="lgn-gallery-item">
        <img src="/assets/images/guinguette/IMG_7301.jpg" srcset={gallerySrcset('/assets/images/guinguette/IMG_7301.jpg')} sizes="(max-width: 900px) 100vw, 50vw" width="4032" height="3024" alt="Poolside dining at Toile Blanche" loading="lazy" />
      </div>
      <div class="lgn-gallery-item">
        <img src="/assets/images/guinguette/IMG_7094.jpg" srcset={gallerySrcset('/assets/images/guinguette/IMG_7094.jpg')} sizes="(max-width: 900px) 100vw, 50vw" alt="Garden setting at La Guinguette" loading="lazy" />
      </div>
      <div class="lgn-gallery-item">
        <img src="/assets/images/guinguette/IMG_8142.jpg" srcset={gallerySrcset('/assets/images/guinguette/IMG_8142.jpg')} sizes="(max-width: 900px) 100vw, 50vw" alt="Al fresco lunch at La Guinguette" loading="lazy" />
      </div>
      <div class="lgn-gallery-item">
      </div>
      <div class="lgn-gallery-item">
        <img src="/assets/images/guinguette/IMG_4191.jpg" srcset={gallerySrcset('/assets/images/guinguette/IMG_4191.jpg')} sizes="(max-width: 900px) 100vw, 50vw" alt="Sharing dishes at La Guinguette" loading="lazy" />
      </div>
      <div class="lgn-gallery-item">
        <img src="/assets/images/guinguette/IMG_7092.jpg" srcset={gallerySrcset('/assets/images/guinguette/IMG_7092.jpg')} sizes="(max-width: 900px) 100vw, 50vw" alt="La Guinguette by the pool" loading="lazy" />
      </div>
      <div class="lgn-gallery-item">
        <img src="/assets/images/guinguette/IMG_7104.jpg" srcset={gallerySrcset('/assets/images/guinguette/IMG_7104.jpg')} sizes="(max-width: 900px) 100vw, 50vw" alt="Garden lunch at Toile Blanche" loading="lazy" />
      </div>
      <div class="lgn-gallery-item">
        <img src="/assets/images/guinguette/DSCF0310.JPG" srcset={gallerySrcset('/assets/images/guinguette/DSCF0310.JPG')} sizes="(max-width: 900px) 100vw, 50vw" alt="Poolside dining" loading="lazy" />
      </div>
      <div class="lgn-gallery-item">
        <img src="/assets/images/guinguette/DSCF0327.JPG" srcset={gallerySrcset('/assets/images/guinguette/DSCF0327.JPG')} sizes="(max-width: 900px) 100vw, 50vw" alt="La Guinguette terrace" loading="lazy" />
      </div>
      <div class="lgn-gallery-item">
        <img src="/assets/images/guinguette/DSCF0486.JPG" srcset={gallerySrcset('/assets/images/guinguette/DSCF0486.JPG')} sizes="(max-width: 900px) 100vw, 50vw" alt="Lunch at La Guinguette" loading="lazy" />
      </div>
      <div class="lgn-gallery-item">
        <img src="/assets/images/guinguette/DSCF4164.JPG" srcset={gallerySrcset('/assets/images/guinguette/DSCF4164.JPG')} sizes="(max-width: 900px) 100vw, 50vw" alt="Garden table at Toile Blanche" loading="lazy" />
      </div>
      <div class="lgn-gallery-item">
        <img src="/assets/images/guinguette/IMG_9344.jpg" srcset={gallerySrcset('/assets/images/guinguette/IMG_9344.jpg')} sizes="(max-width: 900px) 100vw, 50vw" alt="La Guinguette garden" loading="lazy" />
      </div>
    </section>

    <!-- PHILOSOPHY -->
    <section class="lgn-quote">
      <div class="lgn-quote-inner">
        <h2>Lunch lasted three hours. Nobody noticed. The rosé was cold, the fish was whole, and the afternoon had no plans.</h2>
      </div>
    </section>

    <!-- CTA -->
    <section class="lgn-cta">
      <p>A table under the trees is waiting.</p>
      <a href="https://bookings.zenchef.com/results?rid=375927&pid=1001&lang=en" target="_blank" rel="noopener noreferrer" data-zc-action="open" class="lgn-cta-btn">Reserve a Table</a>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  (function () {
    const trigger = document.getElementById('lgn-menu-trigger');
    const content = document.getElementById('lgn-menu-content');
    if (!trigger || !content) return;
    const expandText = trigger.querySelector('.lgn-menu-expand-text');
    const viewMenu = trigger.dataset.view || 'View menu';
    const hideMenu = trigger.dataset.hide || 'Hide menu';

    trigger.addEventListener('click', function () {
      const expanded = trigger.getAttribute('aria-expanded') === 'true';
      trigger.setAttribute('aria-expanded', String(!expanded));
      content.setAttribute('data-expanded', String(!expanded));
      content.toggleAttribute('hidden', expanded);
      if (expandText) expandText.textContent = expanded ? viewMenu : hideMenu;
    });
  })();
</script>

