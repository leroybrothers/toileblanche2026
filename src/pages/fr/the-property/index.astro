---
import Layout from '../../../layouts/Layout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import { heroSrcset, gallerySrcset, encodePath } from '../../../utils/images';
import { useTranslations } from '../../../i18n/index';
import { getPropertyImages } from '../../../utils/the-property-images';

const t = useTranslations('fr');
const img = getPropertyImages();

const srcsetFor = (path: string, type: 'hero' | 'gallery') =>
  type === 'hero' ? heroSrcset(path) : gallerySrcset(path);
---

<Layout
  locale="fr"
  title={t.pages.theProperty.title}
  description={t.pages.theProperty.description}
  ogImage="https://www.toileblanche.com/assets/images/property-hero.jpg"
>
  <Nav theme="both" locale="fr" />

  <main id="main-content" class="prop-page">
    <!-- Hero: full-bleed image with title bottom-left -->
    <section class="prop-hero">
      <div class="prop-hero-image">
        <img src="/assets/images/property-hero.jpg" srcset={heroSrcset('/assets/images/property-hero.jpg')} sizes="100vw" width="1920" height="1280" alt="Les jardins et la terrasse à Toile Blanche, Saint-Paul de Vence" loading="eager" fetchpriority="high" />
        <div class="prop-hero-overlay"></div>
      </div>
      <div class="prop-hero-content">
        <h1>{t.pages.theProperty.heroTitle}</h1>
      </div>
    </section>

    <!-- Cluster 1: Le Lieu -->
    <section class="prop-cluster">
      <div class="prop-cluster-inner">
        <div class="prop-text-block prop-text-center">
          <h2>{t.pages.theProperty.cluster1Title}</h2>
          <p>{t.pages.theProperty.cluster1Text}</p>
        </div>
        {img.place.portraits.length > 0 && (
          <div class={`prop-portraits prop-portraits-${img.place.portraits.length}`}>
            {img.place.portraits.map((src) => (
              <div class="prop-portrait">
                <img src={encodePath(src)} srcset={srcsetFor(src, 'gallery')} sizes={img.place.portraits.length === 1 ? "100vw" : "(max-width: 900px) 100vw, 33.33vw"} width="1200" height="1600" alt="Le lieu à Toile Blanche" loading="lazy" />
              </div>
            ))}
          </div>
        )}
      </div>
    </section>

    <!-- Cluster 2: Les Maisons -->
    <section class="prop-cluster">
      <div class="prop-cluster-inner">
        <div class="prop-two-landscapes">
          <div class="prop-landscape">
            <img src={encodePath(img.houses.landscape1)} srcset={srcsetFor(img.houses.landscape1, 'gallery')} sizes="(max-width: 900px) 100vw, 50vw" width="2000" height="1333" alt="Couloir d'art dans le domaine" loading="lazy" />
          </div>
          <div class="prop-landscape">
            <img src={encodePath(img.houses.landscape2)} srcset={srcsetFor(img.houses.landscape2, 'gallery')} sizes="(max-width: 900px) 100vw, 50vw" width="2000" height="1333" alt="Piscine et cour vues du dessus" loading="lazy" />
          </div>
        </div>
        <div class="prop-text-block prop-text-right">
          <h2>{t.pages.theProperty.cluster2Title}</h2>
          <p>{t.pages.theProperty.cluster2Text}</p>
        </div>
        {img.houses.extra.length > 0 && (
          <div class={`prop-landscapes prop-landscapes-${img.houses.extra.length}`}>
            {img.houses.extra.map((src) => (
              <div class="prop-landscape">
                <img src={encodePath(src)} srcset={srcsetFor(src, 'gallery')} sizes="(max-width: 900px) 100vw, 50vw" width="2000" height="1333" alt="Les maisons à Toile Blanche" loading="lazy" />
              </div>
            ))}
          </div>
        )}
      </div>
    </section>

    <!-- Cluster 3: Les Chambres -->
    <section class="prop-cluster">
      <div class="prop-cluster-inner">
        {img.rooms.portraits.length > 0 && (
          <div class={`prop-portraits prop-portraits-${img.rooms.portraits.length}`}>
            {img.rooms.portraits.map((src) => (
              <div class="prop-portrait">
                <img src={encodePath(src)} srcset={srcsetFor(src, 'gallery')} sizes="(max-width: 900px) 100vw, 33.33vw" width="1200" height="1600" alt="Suite à Toile Blanche" loading="lazy" />
              </div>
            ))}
          </div>
        )}
        <div class="prop-text-block prop-text-left">
          <h2>{t.pages.theProperty.cluster3Title}</h2>
          <p>{t.pages.theProperty.cluster3Text}</p>
        </div>
        {img.rooms.landscapes.length > 0 && (
          <div class="prop-two-landscapes">
            {img.rooms.landscapes.map((src) => (
              <div class="prop-landscape">
                <img src={encodePath(src)} srcset={srcsetFor(src, 'gallery')} sizes="(max-width: 900px) 100vw, 50vw" width="2000" height="1333" alt="Les chambres à Toile Blanche" loading="lazy" />
              </div>
            ))}
          </div>
        )}
      </div>
    </section>

    <!-- Cluster 4: La Table -->
    <section class="prop-cluster">
      <div class="prop-cluster-inner">
        <div class="prop-text-block prop-text-left">
          <h2>{t.pages.theProperty.cluster4Title}</h2>
          <p>{t.pages.theProperty.cluster4Text}</p>
        </div>
        {img.table.portraits.length > 0 && (
          <div class={`prop-portraits prop-portraits-${img.table.portraits.length}`}>
            {img.table.portraits.map((src) => (
              <div class="prop-portrait">
                <img src={encodePath(src)} srcset={srcsetFor(src, 'gallery')} sizes={img.table.portraits.length === 1 ? "100vw" : "(max-width: 900px) 100vw, 33.33vw"} width="1200" height="1600" alt="La table à Toile Blanche" loading="lazy" />
              </div>
            ))}
          </div>
        )}
      </div>
    </section>

    <!-- Cluster 5: L'Art -->
    <section class="prop-cluster">
      <div class="prop-cluster-inner">
        <div class="prop-two-landscapes">
          <div class="prop-landscape">
            <img src={encodePath(img.art.landscape1)} srcset={srcsetFor(img.art.landscape1, 'gallery')} sizes="(max-width: 900px) 100vw, 50vw" width="2000" height="1333" alt="Sculpture jaune dans le jardin" loading="lazy" />
          </div>
          <div class="prop-landscape">
            <img src={encodePath(img.art.landscape2)} srcset={srcsetFor(img.art.landscape2, 'gallery')} sizes="(max-width: 900px) 100vw, 50vw" width="2000" height="1333" alt="Couloir d'art" loading="lazy" />
          </div>
        </div>
        <div class="prop-text-block prop-text-center">
          <h2>{t.pages.theProperty.cluster5Title}</h2>
          <p>{t.pages.theProperty.cluster5Text}</p>
        </div>
      </div>
    </section>

    <!-- Cluster 6: Le Jardin -->
    <section class="prop-cluster">
      <div class="prop-cluster-inner">
        <div class="prop-text-block prop-text-left">
          <h2>{t.pages.theProperty.cluster6Title}</h2>
          <p>{t.pages.theProperty.cluster6Text}</p>
        </div>
        {img.garden.middle.length > 0 && (
          <div class={`prop-landscapes prop-landscapes-${img.garden.middle.length}`}>
            {img.garden.middle.map((src) => (
              <div class="prop-landscape">
                <img src={encodePath(src)} srcset={srcsetFor(src, 'gallery')} sizes="(max-width: 900px) 100vw, 50vw" width="2000" height="1333" alt="Le jardin à Toile Blanche" loading="lazy" />
              </div>
            ))}
          </div>
        )}
      </div>
    </section>

    <!-- Cluster 7: L'Ambiance -->
    <section class="prop-cluster">
      <div class="prop-cluster-inner">
        <div class="prop-text-block prop-text-left">
          <h2>{t.pages.theProperty.cluster7Title}</h2>
          <p>{t.pages.theProperty.cluster7Text}</p>
        </div>
        {img.atmosphere.grid.length > 0 && (
          <div class="prop-atmosphere-grid">
            {img.atmosphere.grid.map((src) => (
              <div class="prop-atmosphere-item">
                <img src={encodePath(src)} srcset={srcsetFor(src, 'gallery')} sizes="(max-width: 900px) 100vw, 33.33vw" width="1200" height="800" alt="Ambiance à Toile Blanche" loading="lazy" />
              </div>
            ))}
          </div>
        )}
      </div>
    </section>

    <!-- CTA -->
    <section class="prop-cta">
      <a href="#" class="prop-cta-btn distributor-open">{t.pages.theProperty.bookYourStay}</a>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .prop-page {
    overflow-x: hidden;
  }
  /* ─── Hero (full-bleed, title bottom-left) ─── */
  .prop-hero {
    position: relative;
    height: 85vh;
    min-height: 500px;
    overflow: hidden;
  }
  .prop-hero-image {
    position: absolute;
    inset: 0;
  }
  .prop-hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .prop-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.4) 0%, transparent 50%);
  }
  .prop-hero-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 0 80px 72px;
  }
  .prop-hero-content h1 {
    font-family: 'Gilda Display', Georgia, serif;
    font-size: clamp(36px, 5vw, 72px);
    font-weight: 400;
    line-height: 1.1;
    color: #fff;
  }

  /* ─── CLUSTERS (generous white space) ─── */
  .prop-cluster {
    padding: 140px 0;
    border-bottom: 1px solid #E2D9CC;
  }
  .prop-cluster:last-of-type {
    border-bottom: none;
  }
  .prop-cluster-inner {
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 80px;
  }
  .prop-cluster-inner > * + * {
    margin-top: 120px;
  }
  @media (max-width: 768px) {
    .prop-cluster {
      padding: 100px 0;
    }
    .prop-cluster-inner > * + * {
      margin-top: 80px;
    }
    .prop-cluster-inner {
      padding: 0 24px;
    }
    .prop-hero-content {
      padding: 0 24px 48px;
    }
  }

  /* Text blocks */
  .prop-text-block {
    max-width: 560px;
  }
  .prop-text-block h2 {
    font-family: 'Gilda Display', serif;
    font-size: clamp(24px, 3vw, 36px);
    font-weight: 400;
    margin-bottom: 24px;
    color: #1C1917;
  }
  .prop-text-block p {
    font-family: 'Didact Gothic', sans-serif;
    font-size: 16px;
    line-height: 1.8;
    color: #3D3530;
  }
  .prop-text-left {
    margin-right: auto;
  }
  .prop-text-right {
    margin-left: auto;
  }
  .prop-text-center {
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }

  /* Image layouts */
  .prop-portraits {
    display: grid;
    gap: 40px;
  }
  .prop-portraits-1 { grid-template-columns: 1fr; }
  .prop-portraits-2 { grid-template-columns: repeat(2, 1fr); }
  .prop-portraits-3 { grid-template-columns: repeat(3, 1fr); }
  .prop-landscapes {
    display: grid;
    gap: 40px;
  }
  .prop-landscapes-1 { grid-template-columns: 1fr; }
  .prop-landscapes-2 { grid-template-columns: repeat(2, 1fr); }
  .prop-atmosphere-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
  }
  .prop-atmosphere-item img {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  @media (max-width: 900px) {
    .prop-atmosphere-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }
  .prop-portrait img {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 3 / 4;
    object-fit: cover;
  }
  .prop-two-landscapes {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 40px;
  }
  .prop-landscape img {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }
  @media (max-width: 900px) {
    .prop-portraits-1, .prop-portraits-2, .prop-portraits-3 {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .prop-landscapes-1, .prop-landscapes-2 {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .prop-two-landscapes {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }

  /* CTA */
  .prop-cta {
    padding: 80px;
    text-align: center;
  }
  .prop-cta-btn {
    display: inline-block;
    font-family: 'Didact Gothic', sans-serif;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    color: #FAF8F3;
    background: #9e5c4a;
    padding: 16px 36px;
    transition: opacity 0.2s, background-color 0.3s, transform 0.3s;
    cursor: pointer;
  }
  .prop-cta-btn:hover {
    background: #8a4f3f;
    transform: translateY(-1px);
  }
  .prop-cta-btn:active {
    transform: translateY(0);
  }
</style>
