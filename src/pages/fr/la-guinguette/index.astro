  }
  .lgn-menu-item {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 24px;
    padding-bottom: 14px;
    margin-bottom: 14px;
    border-bottom: 1px solid rgba(226, 217, 204, 0.3);
  }
  .lgn-menu-item:last-child {
    border-bottom: none;
    margin-bottom: 0;
